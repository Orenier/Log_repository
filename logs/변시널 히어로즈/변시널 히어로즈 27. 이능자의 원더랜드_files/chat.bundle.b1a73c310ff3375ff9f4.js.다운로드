	div.wrapper{
		// Keep as 'visible' so as to prevent box-shadow clipping
		overflow: visible;
		width: 230px;
	}
	.parentContainer {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		padding: 0px;
		width: 34px;
		float: right;
		pointer-events: all;
	}
	.zoomButtonsInner {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		width: 34px;
	}
	.zoomDubMenuBtnStyle {
		position: absolute;
		width: 175px;
		top: 0px;
		left: 0px;
		float: left;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		padding: 8px;
		background: var(--vtt-surface);
		box-shadow: 0px 6px 10px rgba(0, 0, 0, 0.14), 0px 1px 18px rgba(0, 0, 0, 0.12), 0px 3px 5px rgba(0, 0, 0, 0.2);
		border-radius: 8px;
		pointer-events: all;
	}

	.zoomDubMenuBtnStyle > * {
		width: 100%;
		background-color: var(--vtt-surface);
		color: var(--vtt-grayscale-base);
		border: 0;
		border-radius: 0;
		justify-content: left;
		font-family:  var(--font-family-proxima-nova);
	}

	.zoomDubMenuBtnStyle > *:hover:not(:first-child) {
		background-color: var(--vtt-zoom-dropdown-hover-bg);
	}

	.zoomDubMenuBtnStyle > *:active:not(:first-child) {
		background: var(--vtt-submenu-item-active-bg);
		color: var(--vtt-submenu-item-active-color);
	}

	.btnStyle {
		flex: none;
		align-self: stretch;
		flex-grow: 0;
		margin:0;
		background: var(--vtt-zoom-slider-bg);
		color: var(--vtt-zoom-slider-color);
		border-radius: 0;
		border: 0px;
		height: 34px;
		backdrop-filter: blur(15px);
	}

	.btnStyle:hover {
		border: 1px solid var(--vtt-submenu-input-hover-color);
		opacity: 0.8;
	}

	.btnStyle:disabled {
		background-color: var(--grayscale-d60);
		color: var(----el-disabled-text-color);
	}

	.typedZoom {
		text-align-last: justify;
		text-align: left;
		:deep(input#typedZoomInputField) {
			text-align: left;
		}
	}

	.el-input input {
		text-align: left;
	}
	.el-button + .el-button{
		margin-left: 0;
	}

	.compass{
		margin-bottom: 20px;
		border-radius: 10px;
	}
	.plus {
		border-radius: 10px 10px 0 0 ;
	}

	.centerCameraButton {
		margin-top: 8px;
	}

	.level {
		position: relative;
	}

	// The button hover state with border impacts the positioning of the psuedo element
	// The outline property does not impact the positioning of the psuedo element
	.level:hover {
		border: 0;
		outline: 1px solid var( --vtt-zoom-slider-border-color);
	}

	.level::after {
		position: absolute;
		content: '';
		background-image:
		linear-gradient(to top right, var(--grayscale-d30) 50%, transparent 0);
		background-size: 100% 100%;
		background-repeat: no-repeat;
		background-position: left, right;
		width: 4px;
		height: 4px;
		bottom: 5px;
		left: 4px;
	}

	.level span {
		font-size: 14px;
	}

	.sliderSection{
		display: flex;
		align-items: center;
	}

	.sliderSection .el-slider__bar{
		background-color: var(--vtt-surface);
	}

	.minus {
		border-radius: 0 0 10px 10px;
	}

	.el-icon > * {
		font-style: normal;
	}
	.allCurvedButtons{
		border-radius: 10px;
	}

	.contextMenuSwitch {
		position: fixed;
		margin-left: 5px;
		margin-top: 70px;
		pointer-events:all;
		background-color: var(--vtt-surface);
		padding:8px;
	}

	.openSlider {
		margin-top: 90px;
		margin-left: 20px;
	}

	.submenu-caret {
		position: absolute;
		background-image:
			linear-gradient(to top right, var(--grayscale-d30) 50%, transparent 0);
		background-size: 100% 100%;
		background-repeat: no-repeat;
		background-position: left, right;
		width: 6px;
		height: 6px;
		bottom: 4px;
		top: 59px;
		left: 199px;
	}

	.v-enter-active {
		animation: growDown 250ms ease-in-out forwards;
		transform-origin: top center
	}

	.v-leave-active {
		animation: growDown 250ms ease-out reverse;
		transform-origin: top center
	}

	@keyframes growDown {
		0% {
			transform: scaleY(0)
		}
		80% {
			transform: scaleY(1.1)
		}
		100% {
			transform: scaleY(1)
		}
	}

	.borderBottom {
		border-bottom: 1px solid var( --vtt-zoom-slider-border-color);
		padding-bottom: 10px;
	}
