.nexus-compendium-wrapper {
	position: relative;
	display: flex;
	justify-content: center;
}

.nexus-compendium-container {
	border-radius: 5px;
	background: var(--vtt-nexus-compendium-container-background);
	max-width: 400px;
	width: 100%;
	margin: 0 auto;
	position: absolute;
	top: -40px; // NOTE: Height of the closed nexus compendium container
	transition: top 0.3s;
	z-index: 10;

	&.legacyCompendium {
		top: -10px; // NOTE: Height of the closed nexus compendium container on the LEGACY compendium
	}

	&.open {
		top: -150px; // NOTE: Height of the open nexus compendium container
	}

	&__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.25rem;

		padding: 12px 16px 12px 8px;
		border: 1px solid transparent;

		&:hover {
			border-radius: 5px;
			border: var(--vtt-nexus-compendium-header-hover-border);
			cursor: pointer;
		}
	}

	&__title-container {
		display: flex;
		gap: 0.25rem;
		align-items: center;
	}

	&__title {
		color: var(--vtt-nexus-compendium-title-color);
		font-family: 'Proxima Nova';
		font-size: 16px;
		font-style: normal;
		font-weight: 600;
		line-height: 150%;
	}

	&__body {
		display: flex;
		flex-direction: column;
		padding: 1rem;
		gap: 0.5rem;
		align-items: center;
		justify-content: center;
		text-align: center;
	}

	&__body-text {
		color: var(--vtt-nexus-compendium-body-color);
		text-align: center;
		font-family: 'Proxima Nova';
		font-size: 13px;
		font-style: normal;
		font-weight: 600;
		line-height: 18px;
	}

	&__body-button {
		display: flex;
		padding: 0.5rem;
		justify-content: center;
		align-items: center;
		gap: 0.25rem;
		border-radius: 0.25rem;
		border: var(--vtt-nexus-compendium-button-border);
		background: var(--vtt-nexus-compendium-button-background);
		color: var(--vtt-nexus-compendium-button-text-color);
		font-family: 'Proxima Nova';
		font-size: 16px;
		font-style: normal;
		font-weight: 700;
		line-height: 150%;

		&:hover {
			border: var(--vtt-nexus-compendium-button-hover-border);
			cursor: pointer;
			text-decoration: none;
		}
