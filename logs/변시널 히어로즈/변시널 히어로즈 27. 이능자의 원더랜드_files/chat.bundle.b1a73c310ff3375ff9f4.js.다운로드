.player-list-outer {
	position: absolute;
	display: flex;
	flex-direction: column;
	align-items: stretch;
	top: 48px;
	right: 0px;
	width: 273px;
	border-radius: 10px;
	gap: 8px;
	z-index: 10;

	font-family: "Proxima Nova", sans-serif;
	font-size: 16px;
	font-style: normal;

	background: var(--color-surface2);
	box-shadow: 0px 3px 5px 0px rgba(0, 0, 0, 0.20), 0px 1px 18px 0px rgba(0, 0, 0, 0.12), 0px 6px 10px 0px rgba(0, 0, 0, 0.14);
}

.dark .player-list-outer {
	background: var(--surface-dark-dark);
}

.player-list-title {
	display: flex;
	justify-content: space-between;
	align-items: center;
	width: 100%;

	font-weight: 600;
	line-height: 150%;
	background: var(--opacity-colors-1-black-light-110);
	border-bottom: 1px solid var(--opacity-colors-1-black-light-110);
	color: var(--grascale-light-base);
	:deep(.grimoire__tooltip){
		font-weight: 600;
	}
}

.dark .player-list-title {
	background: var(--colors-dark-030);
	border-bottom: 1px solid var(--colors-dark-f10);
}

.player-list-recall {
	color: var(--roll-20-primary-light-d-20);
	font-weight: 600;
	padding: 8px;
}

.dark .player-list-recall {
	color: var(--primary-dark-l40);
}

.player-list-recall:hover {
	cursor: pointer;
}

.player-list-options {
	color: var(--grayscale-light-base);
	font-weight: 400;
	line-height: 18px;
	padding: 0 8px 0 10px;
	display: flex;
	justify-content: space-between;
}

.dark .player-list-options {
	color: var(--grayscale-dark-d30);
}

.player-list-options label {
	color: var(--grayscale-light-base);
	padding-left: 0px;
}

.player-list-options label {
	color: var(--grayscale-dark-d30);
	padding-left: 0px;
}

.player-list-inner {
	display: flex;
	flex-direction: column;
	width: 100%;
}

:deep(.pages-scrollbar) {
	flex: 1;
	height: auto;
	max-height: 468px;
	color: var(--colors-dark-f20);
}

:deep(.pages-scrollbar .el-scrollbar__bar.is-horizontal) {
	display: none;
}

:deep(.pages-scrollbar .el-scrollbar__thumb) {
	background: var(--colors-dark-f20);
	border: 1px solid var(--colors-dark-f50);
}

.player-list-pages {
	width: 254px;
	padding: 10px;
}

.button-area {
	display: flex;
	box-sizing: border-box;
	justify-content: flex-end;
	padding: 12px 8px;
	border-top: 1px solid var(--colors-dark-f10);
	flex: 1 1 auto;
	width: 100%;
}

.party-ribbon {
	height: 13px;
	width: 13px;
}

.player-list-outer .grimoire__button {
	padding: 8px 16px 8px 16px;
	border-radius: 10px;
	margin: 0px;
}

:deep(.el-checkbox__label) {
	font-size: 16px;
	font-weight: 400;
	line-height: 22px;
}

.grimoire__button{
    font-family: var(--font-family-proxima-nova);
    font-weight: 600;
}

.player-filter {
	height: var(--el-checkbox-height, 32px);
	align-items: center;
}

.player-list-inner > :deep(.auto-scroll-zone.extra-top-zone) {
	height: 48px;
	margin-top: 12px;
}

.player-list-inner > :deep(.auto-scroll-zone.extra-bottom-zone) {
	height: 48px;
	bottom: 0;
