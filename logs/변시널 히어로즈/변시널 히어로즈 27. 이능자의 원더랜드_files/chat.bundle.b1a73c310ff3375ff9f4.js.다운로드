    cursor: pointer;
    transition: getCssVar('transition', 'duration');
    border-radius: 50%;
    background-color: getCssVar('carousel', 'arrow-background');
    color: $color-white;
    position: absolute;
    top: 50%;
    z-index: 10;
    transform: translateY(-50%);
