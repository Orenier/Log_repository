    padding: 0 !important;
    border: 1px solid var(--vtt-primary-accent-color);
    font-size: 16px;
    font-weight: 700;
    &-content{
      display: flex;
      gap: 4px;
      align-items: center;
      padding: 0;
      //&:hover {
      //  background-color: var(--primary-l20);
      //}
      //&:focus {
      //  background-color: var(--primary-l20);
      //}
    }
  }
}

.dark .link-scrawl {
  &__new-button {
    color: var(--primary-contrast-text);

    &:hover {
      color: var(--primary-contrast-text);
      background-color: var(--primary-l20);
    }

    &:focus {
      color: var(--primary-contrast-text);
      background-color: var(--primary-l20);
    }
  }
}

.link-modal {
  display: flex;
  flex-direction: column;
  gap: 10px;
  width: 100%;
  margin:10px;
  &__container {
    background-color: var(--surface-dark-dark-2);
  }
  &__inputs {
    display: flex;
    flex-direction: row;
    gap: 10px;
    &-input {
      width: 100%;
      &:disabled {
        border: 0;
        background-color: var(--surface-light4);
      }
    }
    &-id {
      flex:1; box-sizing: border-box; height: 35px;
    }
    &-edit {
      width: 120px;
    }
    &-info {
      justify-content: right;
      color:green;
    }
  }
  &__footer {
    display: flex;
    &-button {
      flex: 1;
      width:100%;
      &-remove {
        background-color: var(--red-light-base);
        &:hover {
          background-color: var(--red-light-l20);
        }
        &:focus {
          background-color: var(--red-light-l20);
        }
      }
    }
  }
}

.dark .link-modal {
  &__inputs-input:disabled {
    border: 0;
    background-color: var(--surface-dark);
  }
}

.dark .link-modal__footer-button-remove {
  background-color: var(--red-dark-base);
  &:hover {
    background-color: var(--red-dark-l20);
    color: var(--primary-contrast-text);
  }
  &:focus {
    background-color: var(--red-dark-l20);
    color: var(--primary-contrast-text);
  }
}

