.blurb {
	padding-bottom:16px;
}

.radio-chip-group {
	display:flex;
	padding:8px 0;
	gap:8px;
}

.toggle-area {
	display:flex;
	padding: 8px 0;
	gap:16px;
}

.button-area {
	display: flex;
	padding-top:16px;
}

:deep(.grimoire__toggle.el-switch--large .el-switch__core) {
	min-width: 2rem;
}

:deep(.el-radio.radio-chip) {
	flex-grow: 1;
	flex-basis: 0;
	height:7.5rem;
	background-color: var(--vtt-radio-chip);
	border-radius: 0.5rem;
	justify-content: center;
	margin-right: 0;
	text-wrap: auto;
	text-align: center;

	.el-radio__label {
		color: var(--vtt-radio-chip-text);
		font-size: 20px;
	}

	.el-radio__inner {
