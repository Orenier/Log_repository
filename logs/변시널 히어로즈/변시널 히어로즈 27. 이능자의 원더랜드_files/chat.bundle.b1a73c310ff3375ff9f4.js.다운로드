    position: absolute;
    list-style: none;
    margin: 0;
    padding: 0;
    z-index: calc(#{getCssVar('index-normal')} + 1);

    @include m(horizontal) {
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
