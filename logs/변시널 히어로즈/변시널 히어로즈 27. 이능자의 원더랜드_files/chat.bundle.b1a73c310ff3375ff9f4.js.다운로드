.custom-select {
	display: flex;
	gap: 4px;
	position: relative;
	border-radius: 8px;
	height: 100%;
	border: none;
	appearance: none;
	color: var(--vtt-grayscale-base);
}

.custom-select .selected {
	display: flex;
	align-items: center;
	justify-content: center;
	border-radius: 8px;
	color: var(--vtt-grayscale-base);
	height: 100%;
	width: 100%;
	cursor: pointer;
	user-select: none;
}

.custom-select .selected:hover {
	background: var(--vtt-submenu-input-hover-color);
}

.custom-select .items {
	color: var(--vtt-grayscale-base);
	background: var(--vtt-surface2);
	border-top: 1px solid var(--vtt-submenu-highlight-color);
	border-radius: 0px 0px 6px 6px;
	overflow: hidden;
	position: absolute;
	top: 47px;
	left: 0;
	right: 0;
	z-index: 1;
	box-shadow: var(--vtt-dropdown-body-box-shadow);
}

.custom-select .items div {
	display: flex;
	align-items: center;
	justify-content: center;
	cursor: pointer;
	user-select: none;
	width: 100%;
	height: 38px;
}

.custom-select .items div:hover {
	background: var(--vtt-submenu-input-hover-color);
}

.custom-select :deep(.grimoire__roll20-icon) {
	margin-right: 8px;
}

.selectHide {
	display: none;
}

.submenu-caret {
	position: absolute;
	background-image: linear-gradient(to top left, var(--grayscale-d30) 50%, transparent 0);
	background-size: 100% 100%;
	background-repeat: no-repeat;
	background-position: left, right;
	width: 6px;
	height: 6px;
	bottom: 4px;
	right: 4px;
}

:deep(.grimoire__roll20-icon) {
