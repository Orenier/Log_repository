/* VTT POPUP OVERRIDES */
.dark {
	.multiple-sheets-popup-wrapper {
		.vtt-popup-deny {
			color: var(--dark-purple-text) !important;

			&:hover {
				outline: 1px solid var(--dark-purple-text) !important;
			}
		}

		.multiple-sheets-revert-confirm {
			background-color: var(--dark-yellow-d60) !important;
		}

		.multiple-sheets-revert-deny {
			&:hover {
				outline: 1px solid var(--grayscale-dark-base);
			}
		}
	}
}

.multiple-sheets-popup-wrapper {
    .swal2-icon {
        border: none;
        margin-bottom: 10px;
    }

    .swal2-title {
        font-size: 25px !important;
        font-weight: 900 !important;
    }

	.vtt-popup-confirm, .vtt-popup-deny {
		border-radius: 10px !important;
	}

	.vtt-popup-deny {
		border: none !important;

		&:hover {
			background-color: transparent !important;
			outline: 1px solid var(--primary-light) !important;
		}
	}

	.multiple-sheets-revert-confirm, .multiple-sheets-revert-deny {
		font-family: "Nunito";
		font-weight: 900;
		border-radius: 10px !important;
	}

    .multiple-sheets-revert-confirm {
        background-color: var(--yellow-d20);
		order: 2;
    }

    .multiple-sheets-revert-deny {
        background-color: transparent !important;
        color: #595959;
		order: 1;
    }

    .vtt-popup-container {
        text-align: center !important;
    }

    .vtt-popup-footer {
        margin: 0 !important;
        border: none !important;
        padding: 0 !important;
    }
}
