.player-list-player {
	display: flex;
	justify-content: start;
	align-items: center;
	font-family: "Proxima Nova", sans-serif;
	color: var(--grayscale-light-base);
	font-size: 13px;
	font-weight: 400;
	gap: 8px;
	height: 40px;
	width: 100%;
	cursor: grab;
}

.dark .player-list-player {
	color: var(--grayscale-dark-base);
}

.player-list-player:hover {
	color: var(--primary-light-l-40);
}

.dark .player-list-player:hover {
	color: var(--primary-dark-l40);
}

.offline-player {
	color: var(--colors-dark-f20);
	color: var(--grayscale-light-l60);
}

.dark .offline-player {
	color: var(--colors-dark-f20);
}

.player-icon {
	display: flex;
	justify-content: center;
	align-items: center;
	width: 24px;
	height: 24px;
	min-width: 24px;
	border-radius: 50%;
	border: 2px solid white;
	overflow: hidden;
	z-index: 1;
}

.player-name {
	flex: 1;
	white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.button-area {
	display: flex;
	box-sizing: border-box;
	justify-content: flex-end;
	padding: 12px 8px;
	border-top: 1px solid var(--colors-dark-f10);
	flex: 1 1 auto;
	width: 100%;
}

.player-list-player label {
	margin-bottom: 0px;
	padding-left: 0px;
}

.party-draggable {
	position: absolute;
	display: flex;
	left: 0px;
	top: 0px;
	border: 2px solid var(--grayscale-light-l-30);
	background: var(--surface-light-light-2);
	border-radius: 8px;
	padding: 4px;
	gap: 8px;
	z-index: var(--vtt-overlay-z-index);
	pointer-events: none;
}

.dark .party-draggable {
	border: 2px solid var(--grayscale-dark-d30);
	background: var(--surface-dark-dark);
}

.go-to-player-icon {
	height: 24px;
	width: 24px;
	color: var(--grayscale-dark-d30);
	cursor: pointer;
	text-align: center;
}

.player-list-player .go-to-player-icon {
	display: none;
}

.player-list-player:hover .go-to-player-icon {
	display: table;
}

.bounce-enter-active {
  animation: bounce-in 0.5s;
}
.bounce-leave-active {
  animation: bounce-in 0.5s reverse;
}
@keyframes bounce-in {
  0% {
    transform: scale(0);
  }
  50% {
    transform: scale(1.25);
  }
  100% {
    transform: scale(1);
  }
}

.party-draggable::v-deep .player-icon {
  animation: wiggle 1s ease alternate infinite;
  &:nth-child(2) {
    animation-delay: 0.05s;
  }
  &:nth-child(3) {
    animation-delay: 0.1s;
  }
  &:nth-child(4) {
    animation-delay: 0.15s;
  }
  &:nth-child(5) {
    animation-delay: 0.2s;
  }
}
@keyframes wiggle {
  90% {
    transform: scale(1.0) translateY(0px);
  }
  100% {
    transform: scale(1.1) translateY(-7px);
  }
}

:deep(.grimoire__tooltip){
		font-weight: 600;
}

