.header {
	height: 45px;
	padding-left: 8px;
	padding-right: 8px;
	&{
		font-family: var(--font-family-proxima-nova);
	}
	.rollModifierBtnContainer {
		display: flex;
		justify-content: flex-end;
	}
	.baseButton{
		color: var(--vtt-submenu-label-color);
		// Note: Border-box isn't working here because of el+ weirdness
		border: 1px solid transparent;
	}

	:deep(.baseButton span) {
		pointer-events: none;
	}

	.baseButton:focus, .baseButton:active {
		background: var(--vtt-submenu-btn-bg);
		border: 1px solid var(--vtt-submenu-header-btn-color);
	}
	.baseButton:focus {
		border: 1px solid var(--vtt-submenu-header-btn-color);
	}
	.baseButton.isActive {
		background: var(--vtt-submenu-highlight-color);
	}
	.baseButton:hover {
		border: 1px solid var(--vtt-submenu-btn-border-color);
		background: var(--vtt-submenu-btn-bg);
	}
	.baseButton.isActive:hover {
		background: var(--vtt-submenu-highlight-color);
	}
	.brackets {
		border-right: 1px solid var(--vtt-submenu-highlight-color);
	}
	div div{
		font-size: 16px;
	}
}

.colBtn {
	border-left: 1px solid var(--vtt-submenu-highlight-color);
	text-align: center;
	color: var(--vtt-grayscale-base);
}

.gridBtn {
	font-family: var(--font-family-proxima-nova);
	color: var(--vtt-grayscale-base);
}

.advancedRollBtn {
	height: 60px;
	width: 40px;
	padding: 0;
	margin: 0;
}

.firstColBtn {
	font-family: var(--font-family-proxima-nova);
	font-style: normal;
	font-weight: 600;
	font-size: 16px;
	line-height: 150%;
	width: 90%;
	justify-content: left;
	color: var(--vtt-grayscale-base);
	img{
		margin-right:4px;
	}
	// Note: Border-box isn't working here because of el+ weirdness
	border: 1px solid transparent;
}

.firstColBtn:active{
	background: var(--vtt-submenu-highlight-color);
}

.firstColBtn:hover, .gridBtn:hover{
	background: var(--vtt-submenu-btn-bg);
	border: 1px solid var(--vtt-submenu-btn-border-color);
}

.lastCol {
	border-right: 1px solid var(--vtt-submenu-highlight-color);

}

.advancedRollBtnContainer {
	display: flex;
	justify-content: center;
	gap: 2px;
	padding: 0 10px 0 6px;
}

.advancedRollBtnInner {
	display: flex;
	flex-direction: column;
	justify-content: center;
