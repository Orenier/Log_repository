@import url('https://fonts.googleapis.com/css2?family=Nunito&display=swap');
.checkbox-pill-form {
  display: flex;
  flex-direction: row;
  font-size: 16px;
}

.checkbox-pill-label {
  font-size: 1em;
}

input[type="checkbox"].grimoire-checkbox {
  font-size: 16px;
  z-index: 1;
  padding: 0;
  margin: 0;
  margin-right: 0.5em;
  height: 1.1em;
  width: 1.1em;
  appearance: none;
  border: none;

  display: flex;
  justify-content: center;
}

.checkbox-pill-form > .grimoire-checkbox::before {
  z-index: -1;
  content: "";
  min-width: 100%;
  min-height: 100%;
  border: 1px solid var(--primary-light);
  border-radius: 4px;
}

.checkbox-pill-form > .grimoire-checkbox:checked::before {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  font-size: 1em;
	font-family: 'Nunito';
  font-weight: 600;
  content: "\u2713";

  color: var(--surface-light);
  background-color: var(--primary-light);
}

.checkbox-pill-form > .grimoire-checkbox:focus {
  outline: none;
  outline-offset: initial;
}

/* Dark */

.dark .grimoire-checkbox {
  accent-color: var(--vtt-primary-accent-color);
}

.dark .checkbox-pill-form > .grimoire-checkbox::before {
  border: 1px solid var(--vtt-primary-color);
}

.dark .checkbox-pill-form > .grimoire-checkbox:checked::before {
  background-color: var(--vtt-primary-color);
}

