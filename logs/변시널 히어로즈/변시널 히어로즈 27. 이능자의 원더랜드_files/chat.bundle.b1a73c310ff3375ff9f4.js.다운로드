.video-container {
  position: relative;
}

.av-controls {
  position: absolute;
  z-index: 2;
  background: var(--bg-av-controls);
  bottom: 0;
  width: 100%;
  justify-content: center;
  align-items: center;
  align-self: flex-end;
  padding: 0.25em 0;
  gap: 0.5em;
}

#join-call-overlay {
  position: absolute;
  z-index: 1;
  background: rgba(0 0 0 / 70%);
  color: var(--background-light);
  height: 100%;
  width: 100%;
  justify-content: center;
  align-items: center;
}

.media-container {
  position: absolute;
}

.local-cam {
  display: flex;
  flex-direction: column;
  min-width: 100px;
}

.indicator {
  background: var(--el-color-primary);
  padding: 0.25em;
  align-items: center;
}

.overlay-elements {
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	height: 100%;
}

.overlay-elements .prompt {
	text-align: center;
	text-transform: capitalize;
}

.draggable-anchor {
	background: var(--bg-av-controls);
	padding: 0.25em;
	align-items: center;
	cursor: all-scroll;
}

.player-bookmark {
	width: 100%;
}

.names-only-prompt {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	width: 100%;

	button {
		font-size: 1rem;
		font-weight: bold;
		background-color: transparent;
		color: var(--vtt-notification-color);
	}

	.grimoire__button {
		padding: 8px;
	}

	.grimoire__button.join {
		text-transform: capitalize;
	}

	.grimoire__button.join:hover {
		background-color: var(--vtt-btn-hover-bg-color);
		color: var(--vtt-primary-color);
	}

	.grimoire__button.cancel {
		color: var(--vtt-modal-close-btn-color);
		border-radius: 8px;
	}

	.grimoire__button.cancel:hover, .grimoire__button.cancel:focus {
		background-color: var(--vtt-modal-close-btn-hover-bg-color);
		color: var(--vtt-modal-close-btn-hover-color);
		box-shadow: none;
	}
}
