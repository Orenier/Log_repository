.dark .breadcrumb-wrapper {
	.breadcrumb-item,
	:deep(.dropdown-header) {
		color: var(--primary-dark-l40);
	}
}
.breadcrumb-wrapper {
	display: flex;
	font-size: 16px;
	color: var(--grayscale-label-text);
	height: 30px;

	margin-top: 10px;
	gap: 8px;
	width: 100%;
	align-items: center;
	justify-content: flex-start;

	.breadcrumb-item,
	:deep(.dropdown-header) {
		background-color: transparent;
		height: 100% !important;
		min-width: 50px; // To handle different languages consistently
		display: inline-block;
		border: 1px solid transparent;
		padding: 4px;
		font-weight: 400;
		line-height: 30px;
		border-radius: 4px;
		color: var(--primary-light-l-40);
		font-weight: 600;

		white-space: nowrap;
		text-overflow: ellipsis;
		overflow: hidden;

		:hover, :active {
			color: var(--grayscale-label-text);
		}
	}

	.breadcrumb-item:last-of-type {
		color: var(--grayscale-label-text);
	}

	:deep(.dropdown-header) {
		padding: 4px 8px;
	}

	:deep(.dropdown-body) {
		background-color: var(--background-light);
		box-shadow: 0px 4px 6px 0px rgba(31, 41, 55, 0.10), 0px 2px 4px 0px rgba(31, 41, 55, 0.06);
		min-width: 169px;
		max-width: 200px;

		span {
			white-space: nowrap;
			text-overflow: ellipsis;
			overflow: hidden;
		}

		button {
			color: var(--grayscale-light-base);

			&:hover {
				color: var(--light-roll20pinktext);
			}
		}
	}

	.upper-folder:hover,
	:deep(.dropdown-header):hover {
		color: var(--primary);
		background-color: var(--primary-l80);
		cursor: pointer;
	}

	.ready-for-drop {
		background-color: transparent;
		border-color: var(--primary-l80);
	}

	.edit-button {
		color: var(--grayscale-dark-d30);
		cursor: pointer;

		&:hover {
			color: var(--grayscale-dark-base)
		}
	}

	:deep(.grimoire__roll20-icon:not(.edit-button)) {
		color: var(--grayscale-d60);
	}
}

.dark .breadcrumb-item {
	color: var(--primary-dark-l40);
}

.dark .breadcrumb-wrapper :deep(.dropdown-body) {
	background-color: var(--surface-dark2);

	button {
		color: var(--grayscale-dark-d30);

		&:hover {
			color: var(--dark-purple-text);
		}
	}
}

.page-tree-view-collapse {
	display: flex;
	justify-content: flex-start;
	align-items: center;
}

.page-tree-view-collapse-title {
	color: var(--grayscale-light-base);
	font-size: 16px;
	font-weight: 600;
}

.breadcrumb-divider-wrapper {
	display: flex;
	justify-content: center;
	height: 100%;
	width: 16px;

	.breadcrumb-divider {
		background-color: var(--grayscale-light-base);
		height: 100%;
		width: 1px;
	}
}

.dark .page-tree-view-collapse-title {
	color: var(--grayscale-dark-d30);
}

.dark .breadcrumb-divider-wrapper {
	.breadcrumb-divider {
		background-color: var(--dark-gray-disabled);
	}
}
