.node.draggable {
	width: auto;
	pointer-events: none;
	position: absolute;
	transition: transform 1s ease-out;
	top: 0;
	display: flex;
	align-items: center;
	flex-flow: row nowrap;
	border-radius: 4px;
	padding: 0 10px;
	z-index: 140000;
	opacity: 0.7 !important; // Needs important to override hidden proxy class opacity
	background: #FFF;
	border: 1px solid var(--grayscale-light-base);
	color: var(--grayscale-light-base);

	.node-button {
		font-family: "Proxima Nova", sans-serif;
		font-size: 16px;
		font-style: normal;
		font-weight: 600;
		padding: 4px;
		border: none;
		background-color: transparent;
		border-radius: 4px;
		line-height: 125%;

	}

	.grimoire__roll20-icon {
		color: var(--grayscale-light-base);
	}
}

.dark .node.draggable {
	background: var(--surface-dark-dark-2);
	border: 1px solid var(--grayscale-dark-base);
	color: var(--dark-secondarytext);

	.grimoire__roll20-icon {
		color: var(--dark-primarytext);
	}
}
