.lighting-header-link {
	font-family: 'Proxima Nova', sans-serif;
	font-size: 13px;
	font-weight: 600;
}

#lighting-header-help-link {
	color: var(--vtt-block-submenu-tertiary-btn-color);
}

.lighting-header-lock-icon, #lighting-header-subscription-link {
	color: var(--vtt-pro-plus-and-lock-color);
}

.lighting-header-lock-icon {
	margin-right: 6px;
}

.wrapper {
	display: flex;
	flex-flow: row wrap;
	width: 100%;
	padding: 8px 10px 8px 8px;
}

.section {
	width: 100%;

	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-bottom: 8px;

		.title-wrapper {
			display: flex;
			align-items: center;
		}
	}
}

.title {
	font-family: 'Proxima Nova', sans-serif;
	font-size: 13px;
	font-weight: 600;
	margin-right: 6px;
	color: var(--vtt-submenu-header);
	display: inline;
}

.title-extras {
	padding-left: 10px;
}

.disabled {
	opacity: 30%;
}

.hug-edges {
	display: flex;
	justify-content: space-between;
	align-items: center;
	width: 100%;
	padding: 0px;
}

.switch-label {
	display: flex;
	align-items: center;
}

.info-icon {
	color: var(--vtt-info-icon);
}

:deep(.chip-postscript) {
	font-size: 10px;
	font-variant: normal;
	color: var(--vtt-dl-chip-fx-postscript);
	margin-left: 6px;
}

/* TODO: make this generic and shared between measure menu and dl menu etc */
.block-submenu-divider {
	margin: 10px 0 10px 8px;
	height: 1px;
	width: 38px;
	background-color: var(--vtt-submenu-divider-color);
}

.button {
	padding: 8px !important;
	border-radius: 4px;
	font-family: var(--font-family-proxima-nova);
	font-size: 13px;
	font-style: normal;
	font-weight: 600;
	line-height: normal;
	background-color: unset;
	color: var(--vtt-submenu-header);

	&:hover {
		background-color: var(--vtt-submenu-divider-color);
	}

	&.disabled:hover {
		background-color: unset;
	}
}

:deep(.el-scrollbar__thumb) {
	background-color: var(--el-scrollbar-bg-color, var(--el-text-color-secondary));
	opacity: var(--el-scrollbar-opacity, 0.5);
}

:deep(.el-scrollbar__thumb:hover) {
	background-color: var(--el-scrollbar-hover-bg-color, var(--el-text-color-secondary));
	opacity: var(--el-scrollbar-hover-opacity, 0.7);
}

:deep(.el-scrollbar__view) {
	display: flex;
}
