,CACA,WAAA,CACA,SAAA,CACA,0BAAA,CACA,iCAAA,CACA,mBAAA,CA0HD,+GAlIC,iBAAA,CACA,UAAA,CACA,MAAA,CACA,UAAA,CACA,WAAA,CACA,SAAA,CACA,0BAAA,CACA,iCAAA,CACA,mBAAA,CA8HD,mHAlJC,uBAAA,CACA,eAAA,CACA,WAAA,CACA,UAAA,CACA,WAAA,CACA,cAAA,CACA,SAAA,CACA,iBAAA,CACA,gBAAA,CA4IA,yBAAA,CAIA,wPACC,cAAA,CAKF,6HACC,gEAAA,CACA,uBAAA,CAGD,8HACC,gEAAA,CACA,uBAAA,CAGD,yHACC,gEAAA,CACA,uBAAA,CAGD,0HACC,gEAAA,CACA,uBAAA,CAGD,0HACC,qBAAA,CAGD,sHACC,qBAAA,CAGD,yFACC,oBAAA,CAEA,mHACC,YAAA,CAOD,0GACC,qBAAA,CACA,8BAAA,CAEA,iHACC,qBAAA,CAKD,8NACC,+BAAA,CAKH,gKACC,+BAAA,CAGD,+EACC,uCAAA,CAEA,yMACC,4CAAA,CAIH,4DACC,WAAA",sourcesContent:[`
@mixin slider-thumb-styles {
  -webkit-appearance: none;
  appearance: none;
  height: 26px;
  width: 18px;
  border: none;
  cursor: pointer;
  z-index: 2;
  position: relative;
  overflow: visible;
}

@mixin slider-track-styles {
  position: absolute;
  content: '';
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  background: v-bind(trackBackground);
  outline: 1px solid v-bind(trackBorder);
  border-radius: 100px;
}

.horizontal-slider-wrapper {
	display: flex;
	flex-flow: row nowrap;
	align-items: center;
	width: 100%;
	gap: 12px;
	box-sizing: border-box;
	position: relative;

	.horizontal-slider-container {
		position: relative;
		width: 100%;

		.horizontal-slider.horizontal-slider--non-safari {
			padding: 0;
			-webkit-appearance: none;
			appearance: none;
			background: transparent;
			border: none;
			outline: none;
			overflow: visible;
			height: 8px;

			&:focus {
				outline: none;
			}
		}

		.horizontal-slider-tooltip {
			position: absolute;
			bottom: 30px;
			background-color: var(--surface-dark-dark);
			color: white;
			padding: 5px 10px;
			border-radius: 4px;
			font-size: 12px;
			transform: translateX(-50%);
			white-space: nowrap;
			font-size: 13px;
			font-family: 'Proxima Nova', sans-serif;
			font-weight: 600;
			z-index: 10;

			&::after {
				content: "";
				position: absolute;
				background-color: var(--surface-dark-dark);
				height: 10px;
				width: 10px;
				border-radius: 2px;
				transform: rotate(45deg);
				bottom: -4px;
				left: 36%;
			}
		}

		.horizontal-slider-labels {
			position: absolute;
			width: 100%;
			top: -27px;
			display: flex;
			justify-content: space-between;

			.start, .end {
				font-size: 10px;
				font-family: 'Proxima Nova', sans-serif;
				font-weight: 600;
				color: #625B65;
			}
		}
	}

	:not(.disabled).horizontal-slider-input-box:hover ~ .horizontal-slider-input-units,
	:not(.disabled).horizontal-slider-input-box:focus ~ .horizontal-slider-input-units {
		display: none;
	}

	.horizontal-slider-input-box, .horizontal-slider-input-units {
		font-size: 13px;
		font-family: 'Proxima Nova', sans-serif;
		font-weight: 600;
		color: var(--grayscale-light-l-30);
	}

	.horizontal-slider-input-box-container {
		position: relative;

		.horizontal-slider-input-box {
			width: auto;
			background-color: transparent;
			border: none;
			outline: 1px solid #c0c1c6;
			padding: 9px;
			appearance: textfield;
			max-width: 55px;

			&:not(.disabled):focus, &:not(.disabled):active {
				outline: 1px solid #818181;
				appearance: inherit;
			}

			&:not(.disabled):hover {
				appearance: inherit;
			}
		}

		.horizontal-slider-input-units {
			position: absolute;
			right: 10px;
			top: 25%;
			max-width: 1.6em;
			overflow: hidden;
		}
	}

	.horizontal-slider.horizontal-slider--non-safari::-webkit-slider-runnable-track {
		@include slider-track-styles;
	}

	.horizontal-slider.horizontal-slider--non-safari::-moz-range-track {
		@include slider-track-styles;
	}

	.horizontal-slider.horizontal-slider--non-safari::-webkit-slider-thumb {
		@include slider-thumb-styles;
		transform: v-bind(trackThumbTranslateX);
	}

	.disabled.horizontal-slider.horizontal-slider--non-safari {
		&::-webkit-slider-thumb, &::-webkit-slider-thumb {
			cursor: default;
		}
	}

	// Slight hack cause v-bind doesn't work with urls the way we would need it
	.horizontal-slider.horizontal-slider--non-safari.dark-icon::-webkit-slider-thumb {
		background: url('DarkHorizontalSliderIcon.svg') no-repeat top;
		background-size: contain;
	}

	.horizontal-slider.horizontal-slider--non-safari.light-icon::-webkit-slider-thumb {
		background: url('LightHorizontalSliderIcon.svg') no-repeat top;
		background-size: contain;
	}

	.horizontal-slider.horizontal-slider--non-safari.dark-icon::-moz-range-thumb {
		background: url('DarkHorizontalSliderIcon.svg') no-repeat top;
		background-size: contain;
	}

	.horizontal-slider.horizontal-slider--non-safari.light-icon::-moz-range-thumb {
		background: url('LightHorizontalSliderIcon.svg') no-repeat top;
		background-size: contain;
	}

	.horizontal-slider.horizontal-slider--non-safari:active::-webkit-slider-thumb {
		filter: contrast(200%);
	}

	.horizontal-slider.horizontal-slider--non-safari:active::-moz-range-thumb {
		filter: contrast(200%);
	}

	.horizontal-slider.horizontal-slider--safari {
		appearance: textfield;

		.horizontal-slider-labels {
			display: none;
		}
	}
}

.dark .horizontal-slider-wrapper {
	.horizontal-slider-container {
		.horizontal-slider-tooltip {
			background-color: #FFFFFF;
			color: var(--surface-dark-dark);

			&::after {
				background-color: #FFFFFF;
			}
		}

		.horizontal-slider-labels {
			.start, .end {
				color: var(--grayscale-dark-d30);
			}
		}
	}

	.horizontal-slider-input-box, .horizontal-slider-input-units {
		color: var(--grayscale-dark-d30);
	}

	.horizontal-slider-input-box {
		outline: 1px solid var(--smokey-outline);

		&:not(.disabled):focus, &:not(.disabled):active {
			outline: 1px solid var(--grayscale-dark-base);
		}
	}

.disabled {
	opacity: 30%;
}

}
