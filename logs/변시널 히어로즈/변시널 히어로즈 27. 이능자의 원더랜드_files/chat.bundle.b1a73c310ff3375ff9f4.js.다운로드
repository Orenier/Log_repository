	button, a {
		background-color: transparent;
		border: none;
		box-sizing: border-box;
		padding: 8px;
		font-family:  inherit;
		font-style: inherit;
		font-weight: inherit;
		font-size: inherit;
		line-height: inherit;
		display: flex;
		flex: none;
