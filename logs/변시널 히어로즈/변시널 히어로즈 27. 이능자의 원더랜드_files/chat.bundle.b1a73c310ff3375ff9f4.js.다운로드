,CACA,YAAA,CACA,kBAAA,CACA,mBAAA,CACA,qBAAA,CAIA,kBAAA,CAEA,yDACC,mBAAA,CACA,oBAAA,CACA,2BAAA,CACA,wBAAA,CACA,eAAA,CACA,iBAAA,CACA,iCAAA,CACA,+BAAA,CACA,eAAA,CACA,cAAA,CACA,oBAAA,CACA,gBAAA,CACA,eAAA,CACA,UAAA,CACA,kBAAA,CACA,iBAAA,CACA,WAAA,CAGD,+DACC,gCAAA,CAGD,0DACC,kBAAA,CACA,cAAA,CAOD,kLACC,eAAA,CACA,oBAAA,CAIF,6CACC,oBAAA,CACA,iCAAA,CAGD,2CACC,WAAA,CAEA,2DACC,WAAA,CACA,kBAAA,CAIF,+CACC,iBAAA,CACA,OAAA,CACA,SAAA,CACA,UAAA,CACA,qBAAA,CACA,SAAA,CACA,2BAAA,CAGD,sKAGC,WAAA,CAGD,iDACC,iBAAA,CACA,WAAA,CACA,SAAA,CACA,2BAAA,CAIF,0DACC,sBAAA,CACA,gBAAA,CAGD,gEACC,gCAAA,CAGD,uDACC,oCAAA,CCjWD,6BACC,wBAMC,6DAAA,CAGD,GACC,SAAA,CACA,gCAAA,CAGD,IACC,gCAAA,CAGD,IACC,gCAAA,CAGD,IACC,SAAA,CACA,mCAAA,CAGD,IACC,mCAAA,CAGD,GACC,SAAA,CACA,0BAAA,CAAA,CAIF,iCACC,8BAAA,CAGD,4DACC,YAAA,CAGD,6DACC,YAAA,CAGD,6DACC,YAAA,CAGD,iEACC,YAAA,CAGD,wDACC,gCAAA,CACA,cAAA,CAGD,wDACC,YAAA,CAED,uDACC,yBAAA,CAED,0CACC,mBAAA",sourcesContent:[`$card-min-width: 124px;
$card-max-width: 136px;

.dark .folder-image :deep(.folder-highlight) {
	fill-opacity: 0.3;
}
.folder-image.show-ribbon :deep(.ribbon-fill) {
	visibility: visible;
}
.folder-image.show-ribbon :deep(.ribbon-stroke) {
	visibility: visible;
}

.folder-image {
	height: 100%;
	width: 100%;
}

.dark .folder-image :deep(.folder-back) {
	fill: #76C6F0;
}

.dark .folder-image :deep(.folder-paper) {
	fill: white;
}

.dark .folder-image :deep(.folder-front) {
	fill: #4393BD;
}

.dark .folder-image :deep(.folder-highlight) {
	fill: #326E8E;
}

.breakoutribbon{
	height: 32px;
	width: 26px;
	&.isFolder {
		svg {
			height: 70%;
			width: 60%;
		}
	}
}
.isFolder :deep(.breakout-ribbon-center-fill){
	fill: #DEE0E6;
}

.multiRibbon {
	&:deep(.breakout-ribbon-center-fill) {
		fill:url(#paint0_linear_5886_254185);
	}
	&:deep(.breakout-ribbon-outline) {
		stroke: #11252F;
	}
}

.vtt-page-card-wrapper {
	display: flex;
	flex: 1;
	padding: 6px;
	position: relative;
	justify-content: center;
}

.insert-indicator {
	position: absolute;
	top: 12px;
	bottom: 12px;
	width: 4px;

	border-radius: 2px;
	background-color: var(--grayscale-base);
	opacity: 0.7;
	pointer-events: none;
}

.vtt-page-card {
    display: flex;
	flex-direction: column;
    gap: 8px;
	min-width: $card-min-width;
	max-width: $card-max-width;
	// Maintain a .94 aspect ratio regardless of width.
	aspect-ratio: .94;

	padding: 8px;
	border-radius: 8px;
	overflow: hidden;
	cursor: pointer;

	background-color: transparent;

	&.is-page {
		background-color: var(--surface-light);
		.dark & {
			background-color: var(--surface2);
		}

		box-shadow: 0px 2px 4px 0px rgba(0, 0, 0, 0.20),
			0px 1px 10px 0px rgba(0, 0, 0, 0.12),
			0px 4px 5px 0px rgba(0, 0, 0, 0.14);
		
		&.new-item-added {
			background-color: var(--dark-card-green);
		}
	}

	position: relative;
	text-align: center;
	transition: opacity .1s ease-in-out,;

	&.selected,
	&.selected:focus,
	&.selected:focus-within,
	&.selected:hover {
		outline: 2.5px solid var(--primary-light-l60);
		background-color: var(--primary-light-l90);

		.dark & {
			outline: 2.5px solid var(--primary-dark-l40);
			background-color: var(--surface2);
		}
	}

	&:hover,
	&:focus,
	&:focus-within{
		outline: 1px solid #585B60;

		&.is-folder {
			background-color: #50576E33;

			.dark & {
				background-color: #FFFFFF1A;
			}
		}
	}

	&.merging-to {
		outline: 1px solid var(--primary-l20);
	}

	&.hover-navigation {
		outline: 1px solid var(--primary-l20);
	}

	&:not(.is-folder, .merging-from, .merging-to)::after {
		pointer-events: none;
		content: "";
		position: absolute;
		top: 0;
		right: 0;
		bottom: 0;
		left: 0;
		background-color: linear-gradient(360deg, #000000 6.66%, rgba(0, 0, 0, 0) 41.59%),
							linear-gradient(0deg, rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.3));
		// opacity: .2;
		transition: opacity .15s ease-in-out;
	}

	&.merging-to {
		background-color: var(--primary-d20);

		.dark & {
			background-color: var(--banner-background)
		}
	}

	.card-thumbnail-container {
		position: relative;
		min-height: 0;
		flex: 1;
	}
	&.is-folder .card-thumbnail-container {
		margin-top: 16px;
	}

	.card-overlay {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0;
		right: 0;
		background-color: black;
		height: 100%;
		width: 100%;
		border-radius: inherit;
		opacity: 0;
		border-radius: 6px;
	}

	&:hover .card-overlay {
		opacity: .4;
	}

	.card-extras {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0;
		right: 0;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.card-thumbnail {
		height: 100%;
		width: 100%;
		border-radius: 6px;
		background-position: center;
		background-repeat: no-repeat;
		background-size: cover;
		background-color: var(--surface-light-light-4);

		.dark & {
			background-color: var(--surface);
		}
	}

	.card-label {
		color: var(--grayscale-dark-base);
		font-family: "Nunito", sans-serif;
		font-weight: 700;
		font-size: 20px;
		line-height: 28px;
		padding-top: 16px;

		// Do not remove or alter shadow without Design sign-off,
		// it is needed for accessibility.
		text-shadow: 2px 1px 2px rgba(0, 0, 0, 0.80);

		text-overflow: ellipsis;
		overflow: hidden;
		white-space: nowrap;
		width: 80px;
		height: fit-content;
	}

	.card-icon {
		align-self: center;
		color: #151B2C80;
		font-size: 40px;
		margin-bottom: -6px;

		.dark & {
			color: #FFFFFF4D;
		}
	}

	.vtt-page-title > span {
		pointer-events: all;
	}

	.vtt-page-title {
		width: 100%;
		height: 36px;
		backdrop-filter: blur(15px);
		text-align: center;
		display: flex;
		align-items: center;
		pointer-events: none;
		box-sizing: border-box;
		// overflow: hidden;

		/* Prevents a weird issue with the parent bleeding underneath */
		margin-bottom: -1px;

		.el-text {
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			-moz-box-orient: vertical;
			text-align: left;
			white-space: unset;
			color: var(--grayscale-light-base);
			font-family: var(--proxima-nova);
			font-weight: 600;
			font-size: 13px;
			letter-spacing: 0.16px;
			line-height: 18px;
			min-height: 18px;
			width: 100%;
			pointer-events: all;
			width: fit-content;
			cursor: text;
		}

		.dark & .el-text {
			color: var(--grayscale-dark-base);
		}

		.el-input {
			pointer-events: all;
			font-size: 13px;
		}
	}

	&.is-folder,
	&.merging-from,
	&.merging-to {
		.vtt-page-title {
			background: none;
			backdrop-filter: none;
		}
	}

	&.merging-from {
		transform: scale(0.9);
		transition: transform .5s ease-out;
	}

	.condensed & {
		height:65px;

		.vtt-page-title {
