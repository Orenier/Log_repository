.row {
	margin: 0;
	padding: 0;
	display: flex;
	gap: 20px;
	align-items: center;
	justify-content: start;
}

label {
	margin-left: -20px;
    color: var(--vtt-grayscale-base);
}

.angle-picker {
	display: flex;
	align-items: center;
	width: 56px;
	height: 56px;
	background-color: var(--vtt-angle-picker-background);
	border: 1px solid var(--vtt-angle-picker-border);
	border-radius: 50%;
}

.angle-rotator {
	width: 56px;
	height: 56px;
	position: relative;
}

.angle-dot {
	position: absolute;
	width: 14px;
	height: 14px;
	top: 7px;
	border-radius: 50%;
	background-color: var(--vtt-angle-picker-knob-background);
	margin: 0;
	left: 50%;
	transform: translateX(-50%);
}

.text-input {
	height: 36px;
	width: 60px;
}

.text-input:deep(.el-input__wrapper) {
