		drop-shadow(1px 1px 4px rgba(64, 193, 84, 0.6));
}

#gm-layer-button .icon-slot:hover {
	border-radius: 12px;
	filter: drop-shadow(0px 0px 4px rgba(107, 175, 255, 0.3))
