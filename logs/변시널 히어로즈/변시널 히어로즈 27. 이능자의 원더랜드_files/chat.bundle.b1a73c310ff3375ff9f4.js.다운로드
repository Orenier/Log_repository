.latest-upload {
	display: flex;
	flex-flow: row nowrap;
	align-items: center;
	justify-content: space-between;
	width: 100%;
	min-height: 44px;
	margin-bottom: 10px;

	&-details {
		display: flex;
		align-items: center;

		&__preview {
			display: flex;
			justify-content: center;
			align-items: center;
			width: 40px;
			height: 40px;
			margin-right: 10px;

			img {
				max-width: 100%;
				max-height: 100%;
			}
		}

		&__name {
			font-family: 'Proxima Nova', sans-serif;
			font-size: 16px;
			font-weight: 600;
			color: var(--vtt-submenu-label-color);
			margin-right: 10px;
		}

		&__size {
			font-family: 'Proxima Nova', sans-serif;
			font-size: 13px;
			font-weight: 400;
			color: var(--vtt-submenu-label-color);
			margin-right: 10px;
		}

		&__status {
			display: flex;
			align-items: center;

			&-icon {
				margin-right: 5px;

				&--success {
					color: var(--vtt-dropzone-success-color);
				}

				&--error {
					color: var(--vtt-dropzone-warning-color);
				}
			}

			&-message {
				font-family: 'Proxima Nova', sans-serif;
				font-size: 13px;
				font-weight: 600;
				color: var(--vtt-dropzone-warning-color);
			}
		}
	}

	&-actions {
		button {
			padding: 4px;
		}

		&__retry {
			margin-right: 10px;

			.grimoire__roll20-icon {
				display: block;
				transform: scaleX(-1);
				color: var(--vtt-dropzone-control-button-bg);
			}

			&:hover .grimoire__roll20-icon {
				color: var(--vtt-dropzone-control-button-bg-hover);
			}
		}

		&__cancel {
			.grimoire__roll20-icon {
				color: var(--vtt-dropzone-cancel-color);
				transition: color 0.2s;
			}

			&:hover .grimoire__roll20-icon {
				color: var(--vtt-dropzone-cancel-hover-color);
			}
		}

		&__delete {
			.grimoire__roll20-icon {
				transition: color 0.2s;
				color: var(--vtt-dropzone-control-button-bg);
			}

			&:hover .grimoire__roll20-icon {
				color: var(--vtt-dropzone-control-button-bg-hover);
			}
		}
	}
}
