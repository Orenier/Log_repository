// UI sizing variables
$toolbar-collapse-handle-left: 26px;

.delay-enter-active {
	transition: opacity 0s ease-in 333ms;
}

.delay-enter-from {
	opacity: 0;
}

.delay-leave-to {
	opacity: 100%;
}

.collapse-handle {
	box-sizing: border-box;
	padding-top: 5px;
	padding-left: 6px;
	width: 45px;
	height: 35px;
	border-bottom-left-radius: 16px;
	cursor: pointer;
	transition: left ease 200ms;
}

.collapse-handle.collapse-handle-collapsed {
	border-bottom-left-radius: 0;
}

.collapse-handle>div {
	box-sizing: border-box;
	width: 24px;
	height: 24px;
	border-radius: 50%;
	background-color: var(--vtt-container-bg);
	border: 1px solid var(--vtt-collapse-btn-border-color);
	color: var(--vtt-collapse-btn-color);
	display: flex;
	align-items: center;
	justify-content: center;
	backdrop-filter: blur(15px);

	/* Icon needs to be ever so slightly of center */
	padding-right: 2px;
}
.collapse-handle.collapse-handle-collapsed>div {
	padding-right: 0;
	padding-left: 4px;
}

.collapse-handle:hover>div {
	background-color: var(--vtt-surface);
	width: 26px;
	height: 26px;
	margin-top: -1px;
	margin-left: -1px;
}
.collapse-handle.collapse-handle-collapsed.variant-collapsed>div {
	width: 28px;
	height: 24px;
	margin-top: 0px;
	margin-left: 0px;
	border-radius: 0 16px 16px 0;
	border: none;
	background-color: var(--vtt-collapse-btn-bg);
}

.collapse-handle.collapse-handle-collapsed.variant-collapsed:hover>div {
	width: 32px;
	height: 24px;
	padding-left: 6px;
	border-radius: 0 16px 16px 0;
	background: linear-gradient(0deg, var(--vtt-submenu-highlight-color), var(--vtt-submenu-highlight-color)),
		var(--vtt-surface2);
}

.collapse-handle>div span {
	transition: transform ease 200ms;
	transform: rotate(v-bind("isCollapsed ? '180deg' : 0"));
}

.collapse-handle :deep(.toolbar-tooltip-outer) {
	margin-top: 2px;
	left: v-bind("isCollapsed ? '44px' : '34px'");
}
