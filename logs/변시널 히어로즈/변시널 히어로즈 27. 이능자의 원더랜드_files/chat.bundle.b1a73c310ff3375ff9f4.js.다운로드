@use '../../../styles/toolbar.css' as *;

@media (min-width: 500px) {
	.vtt-page-card-menu {
		min-width: 32.75rem;
	}
}

.vtt-page-card-menu {
	color: var(--grayscale-base);
	margin: 0px;
	padding-right: 0;
	position: absolute;
	top: 0;
	left: 0;
	right: 460px;
	z-index: 10700;

	transform: translateY(-100%);
	transition: transform 250ms ease-out;

	&.opened {
		transform: translateY(0);
	}

	.drawer {
		background-color: var(--surface);
		height: 100%;
		padding: 4px;
		border-bottom-left-radius: 8px;
	}

	&.opened .drawer {
		box-shadow: 0px 10px 50px rgba(31, 41, 55, 0.25);
		.dark & {
			box-shadow: 0px 11px 15px rgba(0, 0, 0, .2),
						0px 9px 46px rgba(0, 0, 0, 0.12),
						0px 24px 38px rgba(0, 0, 0, 0.14);
		}
	}

	.header {
		height: fit-content;
		padding: 8px;
	}

	.main {
		padding: 4px 4px 16px 4px;
		padding-left: 0;
		flex: 1;
		display: flex;
	}

	.search-results-empty {
		font-family: var(--proxima-nova);
		margin: auto;
		width: 280px;
		text-align: center;

		p {
			font-weight: 600;
			line-height: 18px;
			padding: 0;
			margin: 2px;
			color: var(--grayscale-d30);
			&.search-results-empty-header {
				font-size: var(--el-font-size-medium);
				font-weight: 600;
				line-height: 24px;
				color: var(--grayscale-base);
			}
		}
	}
	.page-container {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(148px, 1fr));
		max-height: calc(100vh - 32.5rem);
		min-height: 10rem;
		margin-right: 1.5rem;
		padding-left: 0.25rem;
		flex-wrap: wrap;
		& .vtt-page-card {
			margin: 0;
			flex-shrink: 0;
			width: 100%;
		}

		&::after {
			content: "";
			flex: auto;
		}
	}

	:deep(.page-scrollbar) {
		flex: 1;
		height: auto;
	}

	.tree-view-wrapper {
		height: auto;
		min-width: 200px;
		min-height: 400px;
		max-height: 70vh;

		:deep(.el-scrollbar__view) {
			padding: 2px 10px 2px 2px;
		}
	}

	:deep(.draggable-divider) {
		background-color: var(--grayscale-light-base);
	}

	&.condensed .page-container {
		grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
	}

	&.opened .page-button {
		border-top-left-radius: 0;
		border-top-right-radius: 0;
		bottom: -40px;
		border: none;
		background-color: #fff;
	}

	.grimoire__button {
		&--primary:focus,
		&--secondary:focus,
		&--tertiary:focus {
			box-shadow: none;
		}
	}
}

// Hide all tree view related content on small screens
@media (max-width: 768px) {
	.vtt-page-card-menu {
		.tree-view-wrapper {
			display: none;
		}

		:deep(.draggable-divider) {
			display: none;
		}

		:deep(.page-tree-view-collapse) {
			display: none;
		}

		:deep(.breadcrumb-divider-wrapper) {
			display: none;
		}
	}
}

// On small screens, take up the full width of the screen
@media (max-width: 992px) {
	.vtt-page-card-menu {
		width: 100vw;
	}
}

.grimoire__button.page-button{
	position: absolute;
	height: 40px;
	width: 40px;
	top: 20px;
	border-radius: 8px;
	padding: 0 !important;
	background-color: var(--colors-light-060);
	border-style: solid;
	border-width: 1px;
	border-color: var(--grayscale-light-l60);
	backdrop-filter: blur(15px);

	&:hover {
		background-color: var(--colors-light-060);
	}

	&:hover, &:active, &:focus {
		border-width: 3px;
	}

	&:active, &:focus {
		background-color: var(--surface-light-light-4);
	}
	&:deep(span) {
		width: 24px;
		height: auto;
		color: var(--grayscale-light-base)
	}
}

.grimoire__button.btn-cancel {
	position: absolute;
	bottom: -40px;
    right: 50%;
	border-radius: 100px;
	height: 30px;
    width: fit-content;
	border-width: 1px;
	border-style: solid;
	background-color: white;
	border-color: var(--grayscale-light-l60);

	&:hover {
		background-color: var(--surface-light-light-2);
	}
	:deep(span) {
		font-size: 16px;
		color: var(--grayscale-light-base);
	}
	&:deep(.grimoire__roll20-icon) {
		font-size: 14px;
		padding-right: 4px;
	}
}

.dark .grimoire__button.btn-cancel {
	border-color: var(--item-background-color);
	background-color: var(--dark-surface1);
	&:hover {
		background-color: var(--dark-surface2);
	}
	&:deep(span) {
		color: white;
	}
	&:deep(.grimoire__roll20-icon) {
		color: var(--dark-grayscale2);
	}
}

.dark .grimoire__button.page-button {
	background-color: var(--colors-dark-050);
	border-color: (--grayscale-light-l-30);

	&:hover {
		background-color: var(--colors-dark-050);
	}

	&:active, &:focus {
		background-color: var(--dark-surface2);
	}
	&:deep(span) {
		color: white;
	}
}

.dark .opened .grimoire__button.page-button {
	background-color: var(--surface);
}


.opened .grimoire__button.page-button :deep(span) {
	width: 24px;
	height: auto;
	color: var(--grayscale-light-base)
}

.dark .vtt-page-card-menu :deep(.draggable-divider) {
	background-color: var(--dark-gray-disabled);
}

.drag-proxy {
	pointer-events: none;
	position: absolute;
	z-index: 1000;
	top: 0;
	opacity: .8;
	transition: transform 1s ease-out;

	:deep(.vtt-page-card) {
		outline: 1px solid var(--colors-dark-f20);
	}
}

.crossfading-page {
	display: grid;
	grid-template-columns: 1fr;
	width: 200px;
	margin: 16px auto;
}
.crossfading-page img {
	grid-row-start: 1;
	grid-column-start: 1;
	left:-65px;
	top:0;
	animation-name: fade;
	animation-iteration-count: infinite;
	animation-duration: 24s;
	&:nth-child(1) {
		animation-delay: 0s;
	}
	&:nth-child(2) {
		animation-delay: -18s;
	}
	&:nth-child(3) {
		animation-delay: -12s;
	}
	&:nth-child(4) {
		animation-delay: -6s;
	}
}
@keyframes fade {
	0% {opacity: 0;}
	20% {opacity: 1;}
	33% {opacity: 1;}
	53% {opacity: 0;}
	100% {opacity: 0;}
}

.slide-enter-active {
  transition: all 0.4s;
}

.slide-enter-from {
  transform: translateX(-20px);
  opacity: 0;
}

.main > :deep(.auto-scroll-zone.extra-top-zone) {
	height: 4px;
	margin-top: -4px;
}

.main > :deep(.auto-scroll-zone.extra-bottom-zone) {
	height: 48px;
	bottom: 0;
	margin-bottom: -28px;
}

.custom-effect-button {
  height: 36px;
