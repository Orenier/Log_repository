		overflow: visible;
	}

	.disabled {
		color: var(--vtt-toolbar-disabled-icon-color) !important;
		cursor: not-allowed;
	}

	.disabled:active {
		color: var(--vtt-toolbar-disabled-icon-color);
		background-color: transparent;
	}

	.disabled:hover {
		color: var(--vtt-toolbar-disabled-icon-color);
		background-color: transparent;
	}

	.shortcut {
		flex: 1;
		text-align: right;
		color: var(--vtt-submenu-tooltip-bold-text-color);
	}

	a:hover, button:hover {
		background-color: var(--vtt-submenu-highlight-color);
		color: var(--vtt-submenu-item-hover-color);
	}

	.active-submenu-item,
	button:active, a:active {
		color: var(--vtt-submenu-item-active-color);
		background: var(--vtt-submenu-highlight-color);
	}

	.active-submenu-item .shortcut,
	button:active .shortcut, a:active .shortcut {
		color: var(--vtt-submenu-item-active-btn-color);
	}

	.red-zone {
		color: var(--vtt-red-zone-color);
	}

	.red-zone:active {
		color: var(--vtt-red-zone-active-color);
		background-color: var(--vtt-red-zone-active-bg);
	}
	.submenu {
		min-width: 180px;
		width: max-content;
		// 1 higher than the context menu itself.
		z-index: 100000;
		overflow: hidden;
		left: 8px !important;
		background-color: var(--vtt-surface);
		border-radius: 8px;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
