.vtt-advanced-tools {
	.grimoire-modal__header-row {
		align-items: flex-start;
		.grimoire-modal__header-close {
			margin-top: 0.25rem;
		}
	}
	.grimoire__button {
		border-radius: .625rem;
	}
	.el-input__wrapper {
		border-radius: .5rem;
	}
	.el-input__inner {
		height: 3rem !important;
	}
}

.vtt-macro-selection-ui-dialog {
	border-radius: 1rem;
	box-shadow: rgba(0, 0, 0, 0.08) 0px 16px 48px 16px;
	border: none;
	min-width: 400px;
	z-index: 11000 !important;
	strong {
		text-transform: uppercase;
		font-weight: 600;
		letter-spacing: .0625rem;
		font-family: proxima-nova-condensed;
		font-size: 1rem;
		font-style: normal;
		line-height: 1rem;
		font-variant: all-small-caps;
	}
	.ui-dialog-titlebar {
		border-bottom: none;
	}
	.ui-dialog-titlebar-close { display: none; }
	.ui-dialog-buttonpane {
		border-top: none;
		background-color: transparent;
		.ui-dialog-buttonset {
			button {
				background-color: var(--primary-light);
				background-image: none;
				background-repeat: no-repeat;
				padding: .5rem 1rem .5rem 1rem;
				font-size: 1rem;
				font-weight: 600;
				font-family: 'proxima-nova';
				border-radius: .75rem;
				border: none;
				text-shadow: none;
				color: var(--surface-light);
				&:hover {
					background-color: var(--primary-light-l60);
				}
			}
			button:last-child {
				background-color: transparent;
				color: var(--primary-light);
				border: 1px solid var(--primary-light-l60);
				&:hover {
					background-color: var(--primary-light-l60);
					color: var(--surface-light);
				}
			}
		}
	}
	.ui-dialog-title {
		font-family: Nunito;
		font-size: 1.5625rem;
		font-weight: 900;
		line-height: 2.1875rem;
	}
	.ui-dialog-content select {
		min-width: 15rem;
		height: 2.75rem;
		font-size: 1.25rem;
		margin-top: 1rem;
		margin-bottom: 1rem;
		margin-left: 0;
		border-radius: .5rem;
		outline-color: var(--primary-light);
	}
	.ui-resizable {
		z-index: 11000 !important;
	}
}

html[data-theme='dark'], html.dark {
	.vtt-macro-selection-ui-dialog {
		background-color: #0C0C0C !important;
		.ui-dialog-content select {
			outline-color: var(--primary-dark);
		}
		.ui-dialog-buttonpane .ui-dialog-buttonset {
			button {
				background-color: var(--primary-dark);
				&:hover {
					background-color: var(--primary-dark-l40);
				}
			}
			button:last-child {
				background-color: transparent;
				color: var(--surface-light);
				border: 1px solid var(--primary-dark-l40);
				&:hover {
					background-color: var(--primary-dark-l40);
					color: var(--surface-light);
				}
			}
		}
	}
