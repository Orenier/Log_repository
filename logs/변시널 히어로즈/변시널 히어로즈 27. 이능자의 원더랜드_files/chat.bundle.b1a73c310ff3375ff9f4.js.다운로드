		font-style: normal;
		font-weight: 400;
		font-size: 16px;
		color: var(--vtt-grayscale-base);
	}

	.dropdown-subtext {
		font-family: "Proxima Nova";
		color: var(--vtt-dropdown-item-subtext);
		font-size: 13px;
		font-style: normal;
		font-weight: 600;
		line-height: 18px;
	}

	.submenu-button-outer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		width: 100%;
		gap: 4px;
	}

	.submenu-button-icon {
		display: flex;
		align-self: center;
	}

	.submenu-button-inner {
		display: flex;
		justify-content: space-between;
		gap: 4px;
		width: 100%;
	}
