.asv {
	&__header {
		container-type: inline-size;
		width: 100%;
		color: var(--vtt-asv-bioinfo-header-color);

		&__title {
			display: flex;
			gap: 1rem;

			.asv__header__name {
				font-family: Nunito, sans-serif;
				font-size: 1.25rem;
				max-width: 120px;
				font-style: normal;
				font-weight: 700;
				line-height: 28px; /* 140% */
				margin: 0;
				white-space: nowrap;
				text-overflow: ellipsis;
				overflow: hidden;

				@container (min-width: 400px) {
					max-width: 180px;
				}

				@container (min-width: 596px) {
					max-width: 280px;
				}
			}

			&__left {
				grid-area: broadcast;
				font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
				overflow: hidden;
				display: flex;
				align-items: center;
				gap: 4px;

				.asv-broadcastcharacter {
					gap: 0.25rem;
					display: flex;
					align-items: center;
					font-size: 0.8125rem;
					color: var(--vtt-asv-bioinfo-primary-color);
					font-weight: 600;

					&__icon {
						border-radius: 0.25rem;
						background-color: var(--vtt-asv-bioinfo-primary-color);
						color: var(--vtt-asv-circle-icon-bg);
						padding-right: 0.5rem;
						padding-left: 0.25rem;
						font-size: 0.7rem;
					}
				}
			}

			&__mid {
				cursor: pointer;
				grid-area: hero;
				margin: 0 auto;
				display: flex;
				flex: 1;
				align-items: center;
				justify-content: left;
				gap: 1rem;

				@container (min-width: 596px) {
					justify-content: center;
				}

				.asv__avatar {
					position: relative;
					width: fit-content;
					display: none;
					@container (min-width: 596px) {
						display: block;
					}
				}

				video {
					width: 2.5rem;
					position: relative;
				}

				img {
					width: 2.5rem;
					aspect-raito: 1/1;
					position: relative;
				}

				.asv__header__icons__edit__circle {
					border-radius: 100%;
					z-index: 2;
					position: absolute;
					border: 1px solid var(--vtt-asv-circle-icon-border-color, rgba(0, 0, 0, 0.2));
					background: var(--vtt-asv-circle-icon-bg, #fff);
					line-height: 1;
					bottom: 0;
					right: -0.5rem;
					font-size: 0.75rem;
					padding: 0.25rem;

					> span {
						color: var(--vtt-asv-circle-icon-color);
					}
				}
			}

			&__right {
				grid-area: buttons;

				.button-icons {
					display: flex;
					justify-content: flex-end;
					align-items: start;
					gap: 0.25rem;

					&.sm {
						@container (min-width: 420px) {
							display: none;
						}
					}

					&.md {
						display: none;
						@container (min-width: 420px) {
							display: flex;
						}
					}

					@container (min-width: 596px) {
						gap: 1rem;
					}
					transition: color 0.25s ease-in-out;

					button.expand-menu {
						padding: 0;
						display: block;
						font-size: 1.25rem;
					}

					a {
						&:hover {
							text-decoration: none;
						}
					}

					button {
						padding: 0.5rem;
						color: var(--vtt-asv-corner-button-label-color);
						font-size: 1rem;
						line-height: 1;

						&:hover {
							color: var(--vtt-asv-bioinfo-primary-color);
						}
					}
				}
			}
		}
	}

	.asv__header__nav__tabs {
		justify-content: center;
		display: flex;
		list-style-type: none;
		margin: 0;
		padding: 0;
		gap: 1rem;

		> li {
			padding-top: 0.5rem;
			padding-bottom: 0.5rem;
			transition: color 0.25s ease-in-out;

			&.active {
				color: var(--vtt-asv-bioinfo-primary-color);
				position: relative;

				&::after {
					background: var(--vtt-asv-bioinfo-primary-color);
					content: '';
					width: 100%;
					height: 2px;
					border-radius: 5px;
					position: absolute;
					bottom: -2px;
					left: 0;
				}
			}

			.asv__header__nav__tabs_link {
				text-decoration: none; /* no underline */
				color: inherit;
				filter: none; /* Dark mode css rules cause link text to be green */
				font-family: 'Proxima Nova', sans-serif;
				font-size: 0.75rem;
				@container (min-width: 596px) {
					font-size: 1rem;
					display: inline;
				}
				font-style: normal;
				font-weight: 600;
				line-height: 150%; /* 24px */
			}
		}
	}

	&__bioinfo {
		overflow: auto;
		padding: 2rem;
		width: 100%;

		&__header {
			display: flex;
			justify-content: space-between;
		}

		.asv__bioinfo__header > h3 {
			font-family: 'Proxima Nova Condensed';
			font-size: 1rem;
			font-weight: 600;
			line-height: 1rem;
			font-variant: all-small-caps;
			letter-spacing: 1px;
			color: var(--vtt-asv-bioinfo-header-color);
		}

		.asv__bioinfo__divider {
			border-color: rgba(255, 255, 255, 0.2);
		}

		.asv__icons__edit__circle {
			border: 1px solid var(--opacity-colors-f-white-dark-f-20, rgba(255, 255, 255, 0.2));
			background: var(--Gray-Dark-D97, #111);
		}

		.asv__block,
		.asv__gmnotes,
		.asv__bio > p,
		.asv__gmnotes > p {
			font-family: 'Proxima Nova', sans-serif;
			font-size: 1rem;
			font-style: normal;
			font-weight: 400;
			line-height: 22px;
		}

		.asv__bioinfo__divider {
			width: 2rem;
			margin: 2rem 0;
			background: var(--opacity-colors-0-black-dark-020, rgba(0, 0, 0, 0.2));
		}

		.asv__bioinfo__edit > span {
			display: flex;
			gap: 0.5rem;
		}
	}
}

.v-enter-active,
.v-leave-active {
	transition: opacity 0.5s ease;
}

.v-leave-active {
	display: none;
}

.v-enter-from,
.v-leave-to {
	opacity: 0;
}

.advanced_charsheet_edit_character,
button {
	background: transparent;
	border: none;
	box-shadow: none;
	cursor: pointer;
}

.button__label {
	display: none;
	@container (min-width: 596px) {
		display: inline;
	}
}

div.iframeHolder {
	width: 100%;
	height: 100%;

	&__iframe {
		width: 100%;
		height: 100%;
	}
}

.charsheet-compendium-drop-target {
	position: absolute;
	height: 100%;
	width: 100%;
	left: 0;
	top: 0;
	display: none;
}

.no-pointer-events {
	pointer-events: none;
}
