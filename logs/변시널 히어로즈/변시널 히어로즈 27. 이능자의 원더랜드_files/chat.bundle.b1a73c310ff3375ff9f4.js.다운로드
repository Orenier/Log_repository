.v-enter-active {
    transition: transform 0.4s ease-out;
}
.v-leave-active {
    transition: transform 0.4s ease-in;
}
.v-enter-from, .v-leave-to {
    transform: translateY(-100%);
}
.VTT__featureOptIn {
    width: 100%;
    padding: 25px 0px 0px 10px;
    align-items: center;
    justify-content: center;
    background-color: var(--surface-dark-gamecard);
    box-shadow: 0px 12px 17px rgba(0, 0, 0, 0.14), 0px 5px 22px rgba(0, 0, 0, 0.12), 0px 7px 8px rgba(0, 0, 0, 0.2);
    border-radius: 12px;
    height: 80px;
    max-width: 800px;
    min-width: 460px;
}
.VTT__featureOptIn--main-section{
	display: flex;
    flex-direction: row;
}
.VTT__featureOptIn--banner-text {
    font-style: normal;
    font-weight: 600;
    font-size: 16px;
    line-height: 150%;
    display: flex;
    align-items: center;
    text-align: center;
    margin-left: auto;
    margin-right: auto;
    color: var(--grayscale-dark-base);
}

.VTT__featureOptIn--optional{
	align-items: center;
    justify-content: center;
    display: flex;
}

button.el-button.el-button--default.closeBtnStyle {
    border: none;
    background-color: transparent;
    color: var(--grayscale-dark-base);
}
button.el-button.el-button--default.btnStyle {
	color: var(--grayscale-dark-base);
	background-color:var(--surface-dark-gamecard);
	border: 1px solid var(--primary-dark-l20);
	border-radius: 10px;
    width: 80px;
    height: 38px;
}

button.el-button.grimoire__button--tertiary,
button.el-button.VTT__featureOptIn--closeButton:hover {
    background-color: var(--primary-dark-l20);
}
