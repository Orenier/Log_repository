.block-submenu {
    background: var(--vtt-container-bg);
	border-radius: 10px;
	box-shadow: var(--vtt-submenu-box-shadow);

    display: flex;
    flex-direction: column;
	backdrop-filter: blur(15px);
	color: var(--vtt-grayscale-base);
	overflow: visible;

	opacity: 100%;
	transition: opacity 200ms ease-out;

	&.isResizable {
		overflow: auto;
	}
	&.isHidden {
		opacity: 0%;
		pointer-events: none;
	}
	&::-webkit-resizer {
		background-color: transparent;
	}
	&::-moz-resizer {
		background-color: transparent;
	}
}

.block-submenu.minimized {
	display:flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	padding: 0 15px;
	@media (min-width: 600px) {
		// TODO: ^ unify that with MOBILE_WIDTH_BREAKPOINT
		opacity: 40%;
	}
	height: 50px;
	width: 300px;
	cursor: move;
}

.block-submenu .controls {
	display: flex;
	gap: 16px;
}

.block-submenu-header {
    color: var(--vtt-grayscale-base);
    font-style: normal;
    font-family: 'proxima-nova';
	cursor: move;
	border-top-left-radius: 12px;
	border-top-right-radius: 12px;
	padding: 8px;
	display: flex;
	justify-content: space-between;
}

.underline {
	border-bottom: 1px solid var(--vtt-submenu-divider-color);
}

.block-submenu-body{

	height: 100%;

}
.block-submenu-body,
.block-submenu-footer {
    display: flex;
    min-height: 30px;
	span {
		margin-bottom: 10px;
	}
}

.block-submenu-footer{
	box-sizing: border-box;
	min-height: 30px;
	display: flex;
	justify-content: flex-start;
	align-items: flex-end;
	padding: 4px 8px 4px 8px;
	gap: 42px;
	width: 100%;
	flex-shrink: 0;
	border-top: 1px solid var(--vtt-submenu-highlight-color);
}
.title{
    user-select: none;
    -webkit-user-select: none;
	margin-right: 12px;
	font-family:  var(--font-family-proxima-nova);
	font-style: normal;
	font-weight: 600;
	font-size: 16px;
	color: var(--grayscale-light-base);
}

.dark .title{
	color: var(--vtt-grayscale-base);
}
:deep(.el-dialog__header) {
    border-bottom: 1px solid var(--vtt-submenu-highlight-color);
    margin: 0px;
    align-items: center;
    padding-top: 8px;
    padding-right: 12px;
    padding-bottom: 8px;
    padding-left: 10px;
}

.buttons-container {
	display: flex;
	gap: 4px;
}

button.pin{
	background-color: var(--vtt-pin-btn-bg);
    color: var(--vtt-pin-btn-color);
    border-radius: 4px;
    border: none;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 0px;
    gap: 10px;
    width: 28px;
    height: 28px;
    margin-left: 25%;
    flex-direction: row;
    padding: 0px;
    min-width: 28px;
    min-height: 28px;
	border: 1px solid transparent;
	display: none; // Disabled intentionally for the time being
}

button.pin.active, button.pin:active, button.pin:hover {
    border: 1px solid var(--vtt-pin-btn-active);
}

button.close, button.collapse {
	display: flex;
	justify-content: center;
	align-items: center;
    border-radius: 4px;
    border: none;
    opacity: 1;
    height: 28px;
    text-shadow: none;
    min-width: 28px;
    min-height: 28px;
	border: 1px solid transparent;
}

button.close {
	background: var(--vtt-close-btn-bg) !important;
    color: var(--vtt-close-btn-color) !important;
}

.altControlButtonStyling button.close {
	background-color: transparent !important;
	color: var(--vtt-control-btn-alt-color) !important;

	&:hover {
		// Have to do this because setting outline none shifts the layout slightly
		border: 1px solid transparent;
		color: var(--vtt-control-btn-alt-hover-color) !important;
	}
}

button.collapse {
	background: none;
    color: var(--vtt-block-submenu-tertiary-btn-color);
	height: auto;
	min-height: auto;

	&:hover {
		// outline: 1px solid var(--vtt-block-submenu-collapse-btn-hover-bg);
		color: var(--vtt-block-submenu-tertiary-btn-hover-color);
	}
}

button.close:active, button.close:hover {
    border: 1px solid var(--vtt-close-btn-hover-border-color);
    opacity: 1;
}

.dottedResizer {
	position: absolute;
    right: 4px;
    bottom: 1px;
}

.title-area {
	display: flex;
	align-items: center;
}

