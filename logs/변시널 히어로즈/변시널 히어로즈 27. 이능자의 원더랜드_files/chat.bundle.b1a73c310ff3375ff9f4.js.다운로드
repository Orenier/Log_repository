.block-submenu.asv {
	background: var(--vtt-asv-window-bg);

	.block-submenu-header.underline {
		padding-bottom: 1px;
	}
}

.grimoire-flyout__popper {
	z-index: 99999 !important;
}

.iframeHolder .iframeHolder__iframe iframe {
	width: 200%;
	height: 200%;
	transform: scale(0.5);
	transform-origin: 0 0;
}

@media only screen and (min-width: 600px) {
	.iframeHolder .iframeHolder__iframe iframe {
		width: 100%;
		height: 100%;
		transform: none;
	}
}

#advanced-sheets-loader {
	position: absolute;
	background-color: rgba(255, 255, 255, 0.6);
	height: 100%;
	width: 100%;
}

#advanced-sheets-loader #vue-lottie-player {
	position: relative;
	height: 7em;
	width: 7em;
	top: calc(50% - 3em);
	left: calc(50% - 3em);
}

// We have to do it unscoped because @container doesn't play nice with :deep.
.asv {
	container-type: size;

	&__header__title {
		.asv__header__nodropdown {
			display: none;
			@container (min-height: 500px) {
				display: block;
			}
		}

		.asv__header__tabsdropdown {
			display: block;
			@container (min-height: 500px) {
				display: none;
			}
		}
	}

	.asv__header__nav {
		display: none;
		@container (min-height: 500px) {
			display: block;
		}
	}
