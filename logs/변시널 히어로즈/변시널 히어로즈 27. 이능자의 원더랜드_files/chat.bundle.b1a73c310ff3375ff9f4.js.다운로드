.btn-add .el-dropdown .el-button:first-child {
  padding: 10px 12px;
  margin: 0px;
  border-radius: 4px 0 0 4px;
  height: 100%;
  border-right-color: rgba(255,255,255,.2);
  font-weight: 700;
}

.btn-add .el-dropdown .el-dropdown__caret-button {
  border-radius: 0 4px 4px 0;
  height: 100%;
  border-left-color: rgba(255,255,255,.2);
  svg {
    stroke: white;
    stroke-width: 75px;
  }
}

.dark .create-page-dropdown .page-menu-item:focus {
  color: var(--primary-dark-l60);
  background-color: var(--colors-dark-f10);
  .page-menu-item__description {
    color: var(--primary-dark-l60);
  }
}

.create-page-dropdown {
  z-index: 10701 !important;
  border:  0 !important;
  .el-dropdown__list {
    margin: 5px;
    .el-dropdown-menu__item {
      padding: 5px;
    }
  }
  .page-menu-item__description {
    color: var(--grayscale-d30);
    line-height: 14px;
    font-size: var(--el-font-size-small);
  }
  .btn-label-create-page {
    margin-left: 5px;
    .el-button--default {
      border-radius: 4px 0 0 4px;
      font-weight: 700;
    }

  }
  .page-menu-item {
    margin: 0;
    .page-menu-item__container {
      display: flex;
      align-items: center;
      gap: 10px;
      .page-menu-item__title {
        width: 36px;
        height: 36px;
        background-color: white;
        border-radius: 4px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--grayscale-light-text);
        border: 1px solid var(--grayscale-d30);
      }
      .page-menu-item__title-image {
        height: 100%;
      }
    }
  }
  .page-menu-item:focus {
    .page-menu-item__description {
      color: var(--primary-light-l40);
    }
  }
  .el-popper__arrow {
    display: none;
