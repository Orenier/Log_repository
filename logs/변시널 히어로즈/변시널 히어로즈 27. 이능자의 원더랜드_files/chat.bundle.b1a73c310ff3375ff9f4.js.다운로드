// UI sizing variables
$toolbar-width: 44px;
$master-toolbar-padding-bottom: 16px;
$toolbar-collapse-handle-left: 26px;

.master-toolbar-outer {
	background: var(--vtt-container-bg);
	backdrop-filter: blur(5px);
	box-shadow: 0 2px 4px rgba(31, 41, 55, 0.6);

	display: flex;
	flex-direction: column;
	justify-content: space-between;
	align-items: center;
	box-sizing: border-box;

	position: absolute;
	padding-top: 16px;
	padding-bottom: $master-toolbar-padding-bottom;
	width: $toolbar-width;
	height: 100%;
	left: 0;
	top: 0;
	z-index: 10602;

	transition: left ease 200ms;
}

.master-toolbar-outer.shortened {
	padding-top: 24px;
	padding-bottom: 4px;
	border-bottom-right-radius: 8px;
	height: auto;
}

.master-toolbar-outer.master-toolbar-collapsed {
	left: -$toolbar-width;
}

.upper-buttons {
	display: flex;
	flex-direction: column;
	gap: 2px;
	align-items: center;
}

.menu-break {
	height: 8px;
}

#toolbar-collapse-handle {
	position: absolute;
	top: 0;
	left: $toolbar-collapse-handle-left;

	/* 1 above the toolbar itself. */
	z-index: 10603;
}

#toolbar-collapse-handle.collapse-handle-collapsed {
	/* Need the 6px padding on the left for the touch zone, so this accounts for that. */
