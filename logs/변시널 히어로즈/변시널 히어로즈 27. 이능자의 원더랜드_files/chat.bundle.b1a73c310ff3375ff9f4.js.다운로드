$primary-pink: #E10085;
$secondary-pink: #ED66B6;

// dark theme
$highlight-purple : #A980BD;
$primary-purple : #702C91;
$text-white: #E6E6E6;

@forward 'element-plus/theme-chalk/src/common/var.scss' with (
  $colors: (
    'primary': (
      'base': #E10085,
    ),
    'success': (
      'base': #00853C,
    ),
    'info': (
      'base': #0B7BB8,
    ),
    'warning': (
      'base': #FFAB00,
    ),
    'danger': (
      'base': #DA1C17,
    )
  ),
  $text-color: (
    'primary': $primary-pink,
    'regular': #1E1523,
    'secondary': $secondary-pink,
    'placeholder': #A5A1A7,
    'disabled': #E9E8E9,
  ),
  $font-size: (
    'base': 16px,
  ),
  $border-color: (
      '': #dcdfe6,
      'light': #e4e7ed,
      'lighter': #ebeef5,
      'extra-light': #f2f6fc,
      'dark': #d4d7de,
      'darker': #cdd0d6,
  ),
  $popover: (
    'title-text-color': var(--el-text-color-secondary),
  ),
);

// If you just import on demand, you can ignore the following content.
// if you want to import all styles:
@use "element-plus/theme-chalk/src/index.scss" as *;
@use "element-plus/theme-chalk/src/dark/var.scss" as * with (

    $colors: (
      'primary' : (
        'base': $primary-purple,
      ),
    ),

    $bg-color: (
        '': #0C0C0C, 
        'page': blue,
    ),
    $text-color: (
        'primary': $primary-purple,
        'secondary': $highlight-purple,
    ),

    $border-color : (
      '' : $highlight-purple,
    ),

    $button : (
      'hover-border-color' : $highlight-purple,
      'hover-text-color' : $text-white,
      'border-color': $primary-purple,
      'hover-bg-color' : $highlight-purple,
      'active-bg-color' : $highlight-purple,
    ),


    $fill-color: (
      '': $highlight-purple,
      'light': $highlight-purple,
    ),
);
@use "element-plus/theme-chalk/src/dark/css-vars.scss" as *;
@use "element-plus/theme-chalk/src/common/var.scss" as *;

