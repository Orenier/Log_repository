.header {
	height: 45px;
	padding-left: 8px;
	padding-right: 8px;
	&{
		font-family: var(--font-family-proxima-nova);
	}
	.rollModifierBtnContainer {
		display: flex;
		justify-content: flex-end;
	}
	.baseButton{
		color: var(--grayscale-d30);
		// Note: Border-box isn't working here because of el+ weirdness
		border: 1px solid transparent;
	}
	.baseButton:focus, .baseButton:active {
		background: transparent;
		border: 1px solid var(--grayscale-d30);
	}
	.baseButton:focus {
		border: 1px solid var(--grayscale-d30);
	}
	.baseButton.isActive {
		background: var(--colors-dark-f10);
	}
	.baseButton:hover {
		border: 1px solid var(--grayscale-d30);
		background: transparent;
	}
	.baseButton.isActive:hover {
		background: var(--colors-dark-f10);
	}
	.brackets {
		border-right: 1px solid var(--colors-dark-f10);
	}
	div div{
		font-size: 16px;
	}
}

.colBtn {
	border-left: 1px solid var(--colors-dark-f10);
	text-align: center;
	color: var(--grayscale-dark-base);
}

.gridBtn {
	font-family: var(--font-family-proxima-nova);
	color: var(--grayscale-dark-base);
}

.advancedRollBtn {
	height: 60px;
	width: 40px;
	padding: 0;
	margin: 0;
}

.firstColBtn {
	font-family: var(--font-family-proxima-nova);
	font-style: normal;
	font-weight: 600;
	font-size: 16px;
	line-height: 150%;
	width: 90%;
	justify-content: left;
	color: var(--grayscale-dark-base);
	img{
		margin-right:4px;
	}
	// Note: Border-box isn't working here because of el+ weirdness
	border: 1px solid transparent;
}

.firstColBtn:active{
	background: var(--colors-dark-f10);
}

.firstColBtn:hover, .gridBtn:hover{
	background: transparent;
	border: 1px solid var(--grayscale-d30);
}

.lastCol {
	border-right: 1px solid var(--colors-dark-f10);

}

.advancedRollBtnContainer {
	display: flex;
	justify-content: center;
	gap: 2px;
	padding: 0 10px 0 6px;
}

.advancedRollBtnInner {
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	font-size: 13px;
	gap: 15px;
}

.advancedRollerContainer {
	display: flex;
	justify-content: center;
}

.advancedRollerInner {
	display: flex;
	flex-direction: column;
	gap: 10px;
	padding: 0 8px;
	align-items: flex-start;
	width: 100%;
	max-width:350px;
}

.advancedRollerInputs {
	display: flex;
	gap: 8px;
	width:100%;
}

.targetNumberContainer {
	display: flex;
	flex-direction: column;
}

label[for=dice-roller-target-number-toggle] {
	padding: 0;
	margin-bottom: 0;
}

.targetNumberInputs {
	display: flex;
	gap: 8px;
	padding-bottom: 8px;
	width: 150px;
}

.rollButton {
	width: 216px;
}

.rollHistory {
	align-items: center;
	display: flex;
	flex-direction: column;

}

.rollHistory{
	user-select: text;
	text-align: center;
	text-align: -webkit-center;
	background-color: transparent;

}

.subtitle{
	margin-left: 10px;
	margin-bottom:10px;
	font-family:  var(--font-family-proxima-nova);
	font-style: normal;
	font-weight: 600;
	font-size: 14px;
	color: var(--grayscale-dark-base);
}

.formulaHistory{
	margin-top: 7px;;
}
.footerToggle{
	margin-bottom: 10px;
	color: var(--primary-dark-l40);
}
.plus{
	place-self: center;
	span{
	font-style: normal;
	}
}

.rollHelp {
	margin: 5px 15px 5px 15px;
}
:deep(button.el-button.is-text.firstColBtn), :deep(button.el-button.is-text.gridBtn){
	&:hover {
		background: transparent;
		border: 1px solid var(--grayscale-d30);
		border-radius: 4px;
	}
	&:focus {
		background: transparent;
		border: 1px solid var(--grayscale-d30);
		border-radius: 4px;
	}
}

button.el-button.is-link{
	--el-button-hover-link-text-color: var(--link-text-hover);
}

:deep(.el-divider.el-divider--horizontal){
	border-color: var(--colors-dark-f10);
	margin: 12px 0;
}

.el-input-number{
	width: 76px;
	min-width: 76px;
}

.el-select.el-select{
	width: auto;
}

#dice-roller-gm-only-toggle :deep(span){
	font-style: normal;
	font-weight: 400;
	font-size: 16px;
	line-height: 22px;
}
:deep(main.el-main){
	padding-left: 0;
	padding-right: 0;
	padding-top: 0;
}
