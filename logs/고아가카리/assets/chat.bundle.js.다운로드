.video-container {
  position: relative;
}

.av-controls {
  position: absolute;
  z-index: 2;
  background: var(--bg-av-controls);
  bottom: 0;
  width: 100%;
  justify-content: center;
  align-items: center;
  align-self: flex-end;
  padding: 0.25em 0;
  gap: 0.5em;
}

