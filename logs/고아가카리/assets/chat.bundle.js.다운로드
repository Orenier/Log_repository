.draw-options-outer {
	position: absolute;
	top: 24px;
	left: 64px;
	height: 44px;
	z-index: 10502;
	gap: 4px;
	background: var(--surface-dark2);
	border-radius: 12px;
	display: flex;
	align-items: center;
	padding: 4px;
}

.draw-tool-font {
	width: 180px;
	height: 100%;
	position: relative;
}

.draw-tool-font-select {
	padding-left: 14px;
	outline: none;
}

.draw-tool-size {
	height: 100%;
	position: relative;
	width: 48px;
}

.draw-tool-size-select {
	width: 64px;
	text-align: center;
}

.size-select-item {
	background: var(--surface-dark2);
}

.draw-tool-select:focus {
	border: none;
	outline: 1px solid var(--colors-dark-f20);
}

.draw-tool-wall-mode,
.draw-tool-width {
	position: relative;
	width: 157px;
	height: 100%;
}

.draw-tool-separator {
	height: 100%;
	background: var(--colors-dark-f20);
	width: 2px;
	margin: 0 3px;
	border-radius: 0.5px;
}

.draw-tool-color {
	position: relative;
	display: flex;
	justify-content: center;
	align-items: center;
	height: 100%;
	margin-right: 6px;
	padding-left: 8px;
	gap: 12px;
}

.submenu-caret {
	position: absolute;
	background-image:
		linear-gradient(to top left, var(--grayscale-d30) 50%, transparent 0);
	background-size: 100% 100%;
	background-repeat: no-repeat;
	background-position: left, right;
	width: 6px;
	height: 6px;
	bottom: 12px;
	right: 7px;
}

.draw-tool-toggles {
	font-size: 16px;
	color: var(--grayscale-d30);
	margin-right: 12px;
}

.draw-tool-toggles :deep(label) {
	margin-bottom: 0;
	padding-left: 5px;
}

.draw-tool-oneway-toggles {
	box-sizing: border-box;
	border-radius: 8px;
	width: 40px;
	height: 100%;
	display: flex;
	align-items: center;
	justify-content: center;
	color: var(--grayscale-d30);
}
.draw-tool-oneway-toggles.selected {
	background-color: var(--colors-dark-f10);
}

.draw-tool-oneway-toggles:hover {
	border: 1px solid;
	border-radius: 12px;
	border-color: var(--grayscale-d30);
}

.draw-tool-select {
	border-radius: 8px;
	height: 100%;
	margin-bottom: 0px;
	border: none;
	appearance: none;
	display: flex;
	align-items: center;
	color: var(--grayscale-dark-base);
}

.draw-tool-select:hover {
	background: var(--colors-dark-f10);
}

:deep(.el-color-picker__icon) {
	display: none !important;
}

:deep(.el-color-picker__trigger) {
	border: none;
}

:deep(.el-color-picker__color) {
	border: 0.5px solid var(--grayscale-dark-base);
}

