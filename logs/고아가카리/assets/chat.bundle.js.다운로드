.v-enter-active,
.v-leave-active {
  transition: opacity 0.5s ease;
}

.v-enter-from,
.v-leave-to {
  opacity: 0;
}

.scrollableBody {
	overflow-y: auto;
	height: 80vh;
}
.whats-new-container-outer {
	border-radius: 12px;
	background: var(--background-light);
	padding: 24px;
	width: 645px;
	height: 85vh;
	max-height: 800px;
	box-shadow: 0px 25px 50px rgba(31, 41, 55, 0.25);
	user-select: text;
	pointer-events: auto;
	.header {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding-bottom: 16px;

		.whatsNewClose {
			cursor: pointer;
			width: 25px;
			height: 25px;
			-webkit-appearance: none;
			padding: 0;
			background: transparent;
			border: 0;
				* {
					color:var(--grayscale-d30)
				}
		}

	}

	.callToActionRow{
		height: 54px;
		display: flex;
		flex-direction: row;
		justify-content: center;
		gap: 16px;
		margin-top: 20px;
	}
	.callToActionRow > * {
		padding: 0px;
		width: 286px;
		border-radius: 10px;
	}

	.btn-lg {
		display: flex;
		flex-direction: row;
		justify-content: center;
		align-items: center;
		padding: 16px 24px;

		box-sizing: border-box;
		border-radius: 10px;
	}

	.hide {
		display: none;
	}

	/* text */

	.text-xl {
		font-weight: 900;
		font-size: 25px;
		line-height: 35px;
	}

	.btn-text-primary {
		font-weight: 900;
	}

	.btn-text-secondary {
		font-weight: 700;
	}

	.btn-text-primary, .btn-text-secondary {
		line-height: 120%;
		letter-spacing: 0.02em;
	}

	.text-normal, .btn-text-primary, .btn-text-secondary {
		font-size: 16px;
	}

	.text-normal {
		font-weight: 400;
		line-height: 22px;
	}

	.text-nunito.text-nunito{
		font-family: 'Nunito';
	}

	.text-base {
		font-family: 'proxima-nova';
		font-style: normal;
	}

	.learnMore{
		font-family: 'Nunito';
		font-style: normal;
		font-weight: 900;
		font-size: 16px;
		line-height: 120%;
		display: flex;
		align-items: center;
		letter-spacing: 0.02em;
		color: var(--primary-light);
		margin-left: 220px;

		span {
			margin-left: 17px;
		}
	}
	.video{
		display: flex;
		align-items: center;
		justify-content: center;

		iframe{
			border-radius: 4px;
		}

	}

	.footerText {
		text-align: center;
		font-family: var(--font-family-proxima-nova);
		font-style: normal;
		font-weight: 400;
		font-size: 13px;
		line-height: 18px;
		align-items: center;
		color: var(--grayscale-l60);
		margin-top: 20px;
	}

	.subheader{
		font-family: 'Nunito';
		font-style: normal;
		font-weight: 700;
		font-size: 20px;
		line-height: 27px;
		padding-bottom: 15px;
	}
	.changelog{
		font-family: var(--font-family-proxima-nova);
		font-style: normal;
		font-weight: 700;
		font-size: 16px;
		line-height: 22px;
		display: flex;
		align-items: center;
		color: #54B8EC;
	}

	.whatsNewBodyCopy, .whatsNewBodyCopy :deep(p) {
		font-family: var(--font-family-proxima-nova) !important;
		font-style: normal;
		font-weight: 400 !important;
		font-size: 16px !important;
		line-height: 150%;
		color: var(--grayscale-d90);
	}
	.bold{
		font-weight: 700;
	}

	.vid-divider {
		margin: 20px 0px;
	}

	ul li {
		margin-top: 5px;
		margin-bottom: 5px;
	}
}

/* Dark */
.dark{
    .whats-new-container-outer {
        background: var(--surface-dark);
    }

    .learnMore{
        color: var(--primary-dark-l40);
    }

	.whatsNewBodyCopy, .whatsNewBodyCopy :deep(p) {
		color: var(--grayscale-dark-base);
	}

}

