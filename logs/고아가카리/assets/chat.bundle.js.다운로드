@use '../../../styles/toolbar.css' as *;

$left-position: 80px;

.vtt-scene-card-menu {
	height: 65vh;
	max-height: calc(100vh - 224px);
	min-height: 270px;

	color: var(--grayscale-base);
	margin: 0px;
	padding-right: 0;
	position: absolute;
	top: 0;
	left: $left-position;
	right: 460px;
	min-width: 524px;
	z-index: 10700;

	transform: translateY(-100%);
	transition: transform 250ms ease-out;

	&.opened {
		transform: translateY(0);
	}

	.drawer {
		background-color: var(--surface);
		height: 100%;
		padding: 4px;
		border-bottom-left-radius: 8px;
	}

	&.opened .drawer {
		box-shadow: 0px 10px 50px rgba(31, 41, 55, 0.25);
		.dark & {
			box-shadow: 0px 11px 15px rgba(0, 0, 0, .2),
						0px 9px 46px rgba(0, 0, 0, 0.12),
						0px 24px 38px rgba(0, 0, 0, 0.14);
		}
	}

	.header {
		height: fit-content;
		padding: 8px;
	}

	.main {
		padding: 4px;
		padding-left: 0;
		flex: 1;
		display: flex;
	}

	.search-results-empty {
		font-family: var(--proxima-nova);
		margin: auto;
		width: 280px;
		text-align: center;

		p {
			font-weight: 600;
			line-height: 18px;
			padding: 0;
			margin: 2px;
			color: var(--grayscale-d30);
			&.search-results-empty-header {
				font-size: var(--el-font-size-medium);
				font-weight: 600;
				line-height: 24px;
				color: var(--grayscale-base);
			}
		}
	}
	.scene-container {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
		margin-right: 24px;
		padding-left: 4px;
		flex-wrap: wrap;
		& .vtt-scene-card {
			margin: 0;
			flex-shrink: 0;
			width: 100%;
		}

		&::after {
			content: "";
			flex: auto;
		}
	}

	.scene-scrollbar {
		flex: 1;
		height: auto;
	}

	&.condensed .scene-container {
		grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
	}

	&.opened .page-button {
		border-top-left-radius: 0;
		border-top-right-radius: 0;
		background-color: #555;
		bottom: -40px;

		.dark & {
			background-color: var(--surface);
		}
	}

	.grimoire__button {
		&--primary:focus,
		&--secondary:focus,
		&--tertiary:focus {
			box-shadow: none;
		}
	}
}

.page-button {
	position: absolute;
	height: 40px;
	width: 40px;
	bottom: -48px;
	right: 0;
	border-radius: 8px;
	padding: 0 !important;
	background-color: black;

	&:hover {
		background-color: #1f1f1f;
	}
}

.opened .page-button :deep(span) {
	width: 24px;
	height: auto;
	color: white;
}

.drag-proxy {
	pointer-events: none;
	position: absolute;
	z-index: 1000;
	/* Cancel out the left of the parent */
	left: -$left-position;
	top: 0;
	opacity: .8;
	transition: transform 1s ease-out;

	:deep(.vtt-scene-card) {
		outline: 4px solid rgba(255, 255, 255, 0.2);
	}
}

.crossfading-scene {
	display: grid;
	grid-template-columns: 1fr;
	width: 200px;
	margin: 16px auto;
}
.crossfading-scene img {
	grid-row-start: 1;
	grid-column-start: 1;
	left:-65px;
	top:0;
	animation-name: fade;
	animation-iteration-count: infinite;
	animation-duration: 24s;
	&:nth-child(1) {
		animation-delay: 0s;
	}
	&:nth-child(2) {
		animation-delay: -18s;
	}
	&:nth-child(3) {
		animation-delay: -12s;
	}
	&:nth-child(4) {
		animation-delay: -6s;
	}
}
@keyframes fade {
	0% {opacity: 0;}
	20% {opacity: 1;}
	33% {opacity: 1;}
	53% {opacity: 0;}
