	.scene-card-menu-header {
		width: 100%;
		display: flex;
		flex-wrap: wrap;
		flex-direction: column;
		justify-content: flex-start;
		align-content: flex-start;
		gap: 8px;

		.horizontal-wrapper {
			display: flex;
			gap: 8px;
			width: 100%;
			align-items: center;
			justify-content: flex-start;
		}

		p {
			font-size: 20px;
			line-height: 20px;
			font-family: var(--font-family-proxima-nova);
		}
		.el-dropdown {
			min-width: max-content;
			//width: max-content;
			& .el-button-group .el_button {
				height: 100%;
			}
		}
		.scene-search-input.grimoire__input {
			flex-grow: 1;
			//--primary-input-border--focus:var(--primary-dark);

			.icon {
				color: var(--grayscale-base);
				&.clear {
					cursor: pointer;
				}
			}
		}

		:deep(.el-input__wrapper) {
			border-radius: 8px;
		}

		:deep(.el-input__inner) {
			padding: 8px;
		}

		.grimoire__button {
			&--primary,
			&--secondary {
				padding: 8px 16px 8px 16px;
				border-radius: 10px;
				margin: 0px;
			}
		}
	}

.party-box-wrapper {
	display: flex;
	width: 100%;
	justify-content: flex-start;
	container-type: inline-size;
	z-index: var(--vtt-overlay-z-index);
}

.announceable-button{
  position: relative;
  transition-duration: 0.4s;
  -webkit-transition-duration: 0.4s; /* Safari */
}

.announceable-button:after {
  content: "";
  display: block;
  position: absolute;
  border-radius: 4em;
  left: 0;
  top:0;
  width: 100%;
  height: 100%;
  opacity: 0;
  transition: all 0.5s;
  box-shadow: 0 0 10px 40px white;
}

.announceable-button.v-enter-from:after {
  box-shadow: 0 0 0 0 white;
  position: absolute;
  border-radius: 4em;
  left: 0;
  top:0;
  opacity: 1;
  transition: 0s;
