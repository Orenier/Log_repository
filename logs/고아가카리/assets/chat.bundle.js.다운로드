// UI sizing variables
$toolbar-width: 44px;
$toolbar-button-height: 40px;
$icon-slot-width: 36px;
$icon-slot-height: 36px;
$label-font-size: 66%;
$label-letter-spacing: .03rem;
$label-padding-horizontal: 0px;
$submenu-caret-width: 4px;
$submenu-caret-height: 4px;
$submenu-caret-bottom: 2px;
$submenu-caret-right: 4px;

.delay-enter-active {
	transition: opacity 0s ease-in 333ms;
}

.delay-enter-from {
	opacity: 0;
}

.delay-leave-to {
	opacity: 100%;
}

.toolbar-button-outer {
	position: relative;
	display: flex;
	flex-direction: row;
	justify-content: center;
	align-items: center;
}

.toolbar-button-mid {
	display: flex;
	flex-direction: column;
	align-items: center;
}

.toolbar-button-inner {
	display: flex;
	flex-direction: column;
	align-content: space-between;
	justify-content: center;
	align-items: center;
	position: relative;
	width: $toolbar-width;
	height: $toolbar-button-height;
}

.icon-selected.icon-selected {
	border: 1px solid;
	border-radius: 12px;
	border-color: var(--grayscale-d30);
    color: var(--grayscale-dark-base);
}

.icon-slot {
	color: var(--grayscale-d30);
	display: flex;
	justify-content: center;
	align-items: center;
	width: $icon-slot-width;
	height: $icon-slot-height;
	border-radius: 12px;
}

.icon-circle {
	background: #FFFFFF1A;
	border-radius: 20px;
}

.label {
	display: flex;
	justify-content: center;
	font-family:  var(--font-family-proxima-nova);
	color: var(--grayscale-d30);
	padding: 1.95px 5.85px $label-padding-horizontal;
	letter-spacing: $label-letter-spacing;
	font-size: $label-font-size;
	max-width: 0px;
}

.label:hover {
	color: var(--grayscale-dark-base);
}

.decoration {
	position: absolute;
	top: 2px;
	right: 4px;
}

.submenu-caret {
	position: absolute;
	background-image:
		linear-gradient(to top left, var(--grayscale-d30) 50%, transparent 0);
	background-size: 100% 100%;
	background-repeat: no-repeat;
	background-position: left, right;
	width: $submenu-caret-width;
	height: $submenu-caret-height;
	bottom: $submenu-caret-bottom;
	right: $submenu-caret-right;
}

.submenu-click-interceptor {
	z-index: 2;
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
}
