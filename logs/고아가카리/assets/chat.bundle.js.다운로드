.bar-background {
	height: 1em;
	background: rgba(0, 0, 0, 0.15);
	border-radius: 6px;
	box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.25), 0 1px rgba(255, 255, 255, 0.08);
	margin: auto;
	overflow: clip;
	position: relative;
}

.bar-background::before {
	content: attr(data-text);
	font-size: 0.75em;
	position: absolute;
	text-align: center;
	left: 0;
	right: 0;
	color: var(--background-light);
	font-weight: bold;
	text-shadow: -1px -1px 0 black, 1px -1px 0 black, -1px 1px 0 black, 1px 1px 0 black;
	font-family: Arial, sans-serif;
	line-height: 14px;
}

.bar-background-compact {
	height: 0.5em;
	margin: auto;
	overflow: clip;
	position: relative;
}

.token-bar {
	height: 100%;
	border-radius: 4px;
	box-shadow: 0 0 1px 1px rgba(0, 0, 0, 0.25), inset 0 1px rgba(255, 255, 255, 0.1);
}

.token-bar-compact {
	box-shadow: initial;
}

.bar-overflow {
	font-size: 20px;
	color: var(--background-light);
	font-weight: bold;
	position: absolute;
	top: 0;
	text-shadow: -1px -1px 0 black, 1px -1px 0 black, -1px 1px 0 black, 1px 1px 0 black;
	line-height: 14px;
	font-family: Arial, sans-serif;
}

.compact {
	font-size: 12px;
	top: -6px;
}

.bar-minus {
	left: 4px;
}

.bar-plus {
	right: 4px;
}
