.vision-popover {
	position: absolute;
	z-index: 1;
}
.vision-popover:focus {
	outline: none;
}

.vision-popover[x-placement="top"] .vtt-popover-caret {
	bottom: -6px;
	left: calc(50% - 6px);
	margin-right: calc(50% - 6px);
}

.vision-popover[x-placement="left"] .vtt-popover-caret {
	right: -6px;
	margin-top: calc(50% - 6px);
	margin-bottom: calc(50% - 6px);
}

.vision-popover[x-placement="bottom"] .vtt-popover-caret {
	top: -6px;
	left: calc(50% - 6px);
	margin-right: calc(50% - 6px);
}

.vision-popover[x-placement="right"] .vtt-popover-caret {
	left: -6px;
	margin-top: calc(50% - 6px);
	margin-bottom: calc(50% - 6px);
}

.vtt-popover-contents {
	display: flex;
	flex-direction: column;
	background: var(--surface-dark2);
	border-radius: 12px;
	padding: 16px;
}

.vtt-popover-buttons {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
}

.vtt-popover-title {
	color: var(--grayscale-dark-base);
	display: flex;
	justify-items: left;
	size: 16px;
	line-height: 24px;
}

.vtt-popover-message {
	color: var(--grayscale-d30);
	display: flex;
	justify-items: left;
	size: 13px;
	line-height: 18px;
	padding-bottom: 8px;
}

.vtt-popover-action {
	color: var(--primary-dark-l60);
	background: var(--surface-dark2);
	border: 1px solid transparent;
	outline: none;
}

.vtt-popover-cancel {
	background: var(--surface-dark2);
	border: 1px solid transparent;
	outline: none;
}

.vtt-popover-caret {
	position: absolute;
	background: var(--surface-dark2);
	width: 12px;
	height: 12px;
	transform: rotate(-45deg);
}
