.dark .grimoire-checkbox {
  accent-color: var(--primary-dark-l20);
}

.dark .checkbox-pill-form > .grimoire-checkbox::before {
  border: 1px solid var(--primary-dark);
}

.dark .checkbox-pill-form > .grimoire-checkbox:checked::before {
