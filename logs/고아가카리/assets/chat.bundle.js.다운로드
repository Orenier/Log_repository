@import url('https://fonts.googleapis.com/css2?family=Nunito&display=swap');

.pdf-select-outer {
	border-radius: 12px;
	background: var(--background-light);
	padding: 24px;
	/* resize: both; */
	width: 568px;
}

.pdf-title-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	padding-bottom: 16px;
}

.pdf-select-list {
	height: 400px;
	margin: initial;
	padding: 4px;
	list-style-type: none;
	overflow-y: scroll;
}

.pdf-select-list::-webkit-scrollbar {
    width: 8px;
}

.pdf-select-list::-webkit-scrollbar-track {
    -webkit-box-shadow: inset 0 0 6px rgba(0,0,0,0);
}

.pdf-select-list::-webkit-scrollbar-thumb {
	background-color: var(--grayscale-d60);
	border-radius: 4px;
}

.pdf-import-buttons {
	display: flex;
	flex-direction: row;
	justify-content: center;
	gap: 8px;
}

.btn-lg {
	display: flex;
	flex-direction: row;
	justify-content: center;
	align-items: center;
	padding: 16px 24px;

	box-sizing: border-box;
	border-radius: 10px;
}

.pdf-import-btn-secondary {
	color: var(--primary-light);
	border: 1px solid var(--primary-light);
	background: transparent;
}

.pdf-import-btn-secondary:hover {
	color: var(--background-light);
	background: var(--primary-light-l20);
}

.pdf-import-btn {
	color: var(--background-light);
	background: var(--primary-light);
	border: 1px solid var(--primary-light);
}

.pdf-import-btn:hover {
	background: var(--primary-light-l20);
}

.pdf-import-btn:disabled {
