	div.wrapper{
		overflow: hidden;
		width: 230px;
	}
	.parentContainer {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		padding: 0px;
		width: 34px;
		float: right;
		pointer-events: all;
	}
	.zoomDubMenuBtnStyle {
		width: 175px;
		float: left;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		padding: 8px;
		background: var(--surface-dark);
		box-shadow: 0px 6px 10px rgba(0, 0, 0, 0.14), 0px 1px 18px rgba(0, 0, 0, 0.12), 0px 3px 5px rgba(0, 0, 0, 0.2);
		border-radius: 8px;
		pointer-events: all;
	}

	.zoomDubMenuBtnStyle > * {
		width: 100%;
		background-color: var(--surface-dark);
		color: var(--grayscale-dark-base);
		border: 0;
		border-radius: 0;
		justify-content: left;
		font-family:  var(--font-family-proxima-nova);
	}

	.zoomDubMenuBtnStyle > *:active:not(:first-child) {
		background: var(--primary-dark-d40);
		color: var(--primary-dark-l60);
	}

	.zoomDubMenuBtnStyle > *:hover:not(:first-child) {
		background-color: var(--colors-dark-f10);
	}

	.btnStyle {
		flex: none;
		align-self: stretch;
		flex-grow: 0;
		margin:0;
		background: var(--colors-dark-080);
		color: var(--grayscale-d30);
		border-radius: 0;
		border: 0px;
		height: 34px;
		backdrop-filter: blur(15px);
	}

	.btnStyle:hover {
		border: 1px solid var(--colors-dark-f10);
		opacity: 0.8;
	}

	.btnStyle:disabled {
		background-color: var(--grayscale-d60);
	}

	.typedZoom {
		text-align-last: justify;
		text-align: left;
		:deep(input#typedZoomInputField) {
			text-align: left;
		}
	}

	.el-input input {
		text-align: left;
	}
	.el-button + .el-button{
		margin-left: 0;
	}

	.compass{
		margin-bottom: 20px;
		border-radius: 10px;
	}
	.plus {
		border-radius: 10px 10px 0 0 ;
	}

	.level {
		position: relative;
	}

	// The button hover state with border impacts the positioning of the psuedo element
	// The outline property does not impact the positioning of the psuedo element
	.level:hover {
		border: 0;
		outline: 1px solid var(--colors-dark-f10);
	}

	.level::after {
		position: absolute;
		content: '';
		background-image:
		linear-gradient(to top right, var(--grayscale-d30) 50%, transparent 0);
		background-size: 100% 100%;
		background-repeat: no-repeat;
		background-position: left, right;
		width: 4px;
		height: 4px;
		bottom: 5px;
		left: 4px;
	}

	.level span {
		font-size: 14px;
	}

	.sliderSection{
		display: flex;
		align-items: center;
	}

	.sliderSection .el-slider__bar{
		background-color: var(--surface-dark);
	}

	.minus {
		border-radius: 0 0 10px 10px;
	}

	.el-icon > * {
		font-style: normal;
	}
	.allCurvedButtons{
		border-radius: 10px;
	}

	.contextMenuSwitch {
		position: fixed;
		margin-left: 5px;
		margin-top: 70px;
		pointer-events:all;
		background-color: var(--surface-dark);
		padding:8px;
	}

	.openSlider {
		margin-top: 90px;
		margin-left: 20px;
	}

	.submenu-caret {
		position: absolute;
		background-image:
			linear-gradient(to top right, var(--grayscale-d30) 50%, transparent 0);
		background-size: 100% 100%;
		background-repeat: no-repeat;
		background-position: left, right;
		width: 6px;
		height: 6px;
		bottom: 4px;
		top: 59px;
		left: 199px;
	}

	.v-enter-active {
		animation: growDown 250ms ease-in-out forwards;
		transform-origin: top center
	}

	.v-leave-active {
		animation: growDown 250ms ease-out reverse;
		transform-origin: top center
	}

	@keyframes growDown {
		0% {
			transform: scaleY(0)
		}
		80% {
			transform: scaleY(1.1)
		}
		100% {
			transform: scaleY(1)
		}
	}

	.borderBottom {
		border-bottom: 1px solid var(--colors-dark-f10);
		padding-bottom: 10px;
	}
