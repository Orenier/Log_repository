.breadcrumb-wrapper {
	display: flex;
	font-size: 16px;
	color: var(--grayscale-label-text);
	height: 30px;

	margin-top: 6px;
	gap: 8px;
	width: 100%;
	align-items: center;
	justify-content: flex-start;

	.breadcrumb-item,
	:deep(.dropdown-header) {
		height: 100% !important;
		display: inline-block;
		border: 1px solid transparent;
		padding: 4px;
		font-weight: 400;
		line-height: 30px;
		border-radius: 4px;
		color: var(--primary-light-l-40);
		font-weight: 600;

		white-space: nowrap;
		text-overflow: ellipsis;
		overflow: hidden;

		:hover, :active {
			color: var(--grayscale-label-text);
		}
	}

	.breadcrumb-item:last-of-type {
		color: var(--grayscale-label-text);
	}

	:deep(.dropdown-header) {
		padding: 4px 8px;
	}

	:deep(.dropdown-body) {
		background-color: var(--surface-dark2);
		min-width: 169px;
		max-width: 200px;

		span {
			white-space: nowrap;
			text-overflow: ellipsis;
			overflow: hidden;
		}
	}

	.upper-folder:hover,
	:deep(.dropdown-header):hover {
		color: var(--primary);
		background-color: var(--primary-l80);
		cursor: pointer;
	}

	.ready-for-drop {
		background-color: transparent;
		border-color: var(--primary-l80);
	}

	.edit-button {
		color: var(--grayscale-dark-d30);
		cursor: pointer;

		&:hover {
			color: var(--grayscale-dark-base)
		}
	}

	:deep(.grimoire__roll20-icon:not(.edit-button)) {
		// FIXME: Find var
		color: #666666;
	}
}

.dark .breadcrumb-item {
	color: var(--primary-dark-l40);
}
