@import url("https://fonts.googleapis.com/css2?family=Nunito&display=swap");
/* text */

.text-normal {
	font-size: 14px;
}

.text-base {
	font-family: "Nunito";
	font-style: normal;
}

.hidden {
  display: none !important;
}

.dot-menu {
	position: absolute;
	right: 0px;
	top: 0px;
	background: var(--background-light);
	padding: 4px;
	border-radius: 4px;
	border-color: transparent;
	outline-color: transparent;
	width: 120px;
	z-index: 3;
	box-shadow: 6px 0px 4px rgba(31, 41, 55, 0.1), 4px 0px 2px rgba(31, 41, 55, 0.06);
}

.dot-menu-item {
	display: flex;
	flex-direction: row;
	align-items: center;
	color: var(--grayscale-l30);
	padding: 4px;
	gap: 4px;

	border-radius: 2px;
	font-size: 14px;
}

.dot-menu-item:hover {
	color: var(--primary-light);
	cursor: pointer;
}

.dotmenu-icon {
	fill: none;
}

.dotmenu-icon:hover {
	fill: none;
}

/* Darkmode */

.dark .dot-menu {
	color: var(--background-light);
	background-color: var(--surface-dark);
}

.dark .dot-menu-item {
	color: var(--background-light);
}

.dark .dot-menu-item:hover {
	color: var(--primary-dark-l40);
}

.dark .dot-menu:after {
  box-shadow: 0px 24px 38px rgba(0, 0, 0, 0.14), 0px 9px 46px rgba(0, 0, 0, 0.12), 0px 11px 15px rgba(0, 0, 0, 0.2);
}

