@import url('https://fonts.googleapis.com/css2?family=Nunito&display=swap');

.pdf-search-box {
	display: flex;
	flex-direction: row;
	justify-content: center;
	align-items: center;
	padding-left: 2px;
	width: 578px;
}

.pdf-search {
	font-family: 'proxima-nova';
	font-style: normal;
	font-size: 16px;
	position: relative;
	width: 524px;
	height: 28px;
	border: 1px solid var(--grayscale-l60);
	left: -24px;
	padding: 4px 4px 4px 36px;
	border-radius: 8px;
	margin-left: 6px;
	margin-bottom: initial;
}

.pdf-search-box input:hover {
	border: 1px solid var(--primary-light);
}

.pdf-search-box input:focus {
  box-shadow: none;
  outline: none;
  border-color: var(--primary-light);
  outline: 1px solid var(--primary-light);
  caret-color: var(--primary-light);
}

.pdf-search-box:hover {
	color: var(--primary-light) !important;
}

.pdf-search-box:focus-within {
	color: var(--primary-light);
}

.pdf-search-icon {
	position: relative;
	z-index: 1;
	left: 10px;
	fill: none;
	margin: initial;
}

.pdf-search-icon:hover {
	fill: none;
}

/* Dark */

.dark .pdf-search-box input:hover {
	border: 1px solid var(--primary-dark-l40);
}

.dark .pdf-search-box input:focus {
  box-shadow: none;
  outline: none;
  border-color: var(--primary-dark-l40);
  outline: 1px solid var(--primary-dark-l40);
  caret-color: var(--primary-dark-l40);
}

.dark .pdf-search-box:hover {
	color: var(--primary-dark-l40) !important;
}

.dark .pdf-search-box:focus-within {
	color: var(--primary-dark-l40);
}

