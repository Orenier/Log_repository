.party-banner-outer {
	display: flex;
	align-items: center;
	gap: 8px;
}

.party-ribbon {
	height: 100%;
	width: 100%;
	max-height: 32px;
	max-width: 26px;
	min-width: 26px;
	padding: 4px 0px;
	cursor: grab;
}

.player-area {
	display: flex;
	flex: 1;
	gap: 8px;
	width: 100%;
	padding-right: 8px;
}

.player-icons {
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 6px 0px;
}

.player-icons :first-child {
	transform: translate(0px);
}

.player-icon {
	display: flex;
	justify-content: center;
	align-items: center;
	width: 24px;
	height: 24px;
	border-radius: 50%;
	margin-right: -8px;
	border: 2px solid white;
	overflow: hidden;
	z-index: 1;
}

.overflow-player-icon {
	display: flex;
	justify-content: center;
	align-items: center;
	width: 24px;
	height: 24px;
	border-radius: 50%;
	margin-right: -8px;
	color: var(--primary-dark-l80);
	background: var(--primary-light-base);
	overflow: hidden;
	z-index: 2;
}

.dark .overflow-player-icon {
	background: var(--primary-dark-base);
}

.party-draggable {
	position: absolute;
	display: flex;
	align-items: center;
	left: 0px;
	top: 0px;
	border: 2px solid var(--grayscale-dark-d30);
	border-radius: 8px;
	background: var(--surface-dark-dark);
	padding: 4px;
	gap: 8px;
	z-index: var(--vtt-overlay-z-index);
	pointer-events: none;
}

.party-ribbon:active {
	cursor: grabbing;
}

@container (max-width: 190px) {
	.player-icons {
		display: none;
	}
	.player-area {
		padding: initial;
	}

	.party-banner-outer {
		gap: 0px;
	}
}

.icon-wiggle {
  animation: wiggle 1s ease alternate infinite;
  &:nth-child(2) {
    animation-delay: 0.05s;
  }
  &:nth-child(3) {
    animation-delay: 0.1s;
  }
  &:nth-child(4) {
    animation-delay: 0.15s;
  }
  &:nth-child(5) {
    animation-delay: 0.2s;
  }
}
@keyframes wiggle {
  90% {
    transform: scale(1.0) translateY(0px);
  }
  100% {
    transform: scale(1.1) translateY(-7px);
  }
}
.bounce-enter-active {
  animation: bounce-in 0.5s;
}
.bounce-leave-active {
  animation: bounce-in 0.5s reverse;
}
@keyframes bounce-in {
  0% {
    transform: scale(0);
  }
  50% {
    transform: scale(1.25);
  }
  100% {
    transform: scale(1);
  }
}

