// UI sizing variables
$toolbar-collapse-handle-left: 26px;

.delay-enter-active {
	transition: opacity 0s ease-in 333ms;
}

.delay-enter-from {
	opacity: 0;
}

.delay-leave-to {
	opacity: 100%;
}

#toolbar-collapse-handle {
	box-sizing: border-box;
	position: absolute;
	top: 0;
	left: $toolbar-collapse-handle-left;
	padding-top: 5px;
	padding-left: 6px;
	width: 45px;
	height: 35px;
	border-bottom-left-radius: 16px;
	cursor: pointer;

	/* 1 above the toolbar itself. */
	z-index: 10603;

	transition: left ease 200ms;
}

#toolbar-collapse-handle.collapse-handle-collapsed {
	/* Need the 6px padding on the left for the touch zone, so this accounts for that. */
	left: -6px;
	border-bottom-left-radius: 0;
}

#toolbar-collapse-handle>div {
	box-sizing: border-box;
	width: 24px;
	height: 24px;
	border-radius: 50%;
	background-color: var(--colors-dark-080);
	border: 1px solid rgba(255, 255, 255, 0.1);
	color: var(--grayscale-dark-base);
	display: flex;
	align-items: center;
	justify-content: center;
	backdrop-filter: blur(15px);

	/* Icon needs to be ever so slightly of center */
	padding-right: 2px;
}
#toolbar-collapse-handle.collapse-handle-collapsed>div {
	padding-right: 0;
	padding-left: 4px;
}

#toolbar-collapse-handle:hover>div {
	background-color: var(--surface-dark2);
	width: 26px;
	height: 26px;
	margin-top: -1px;
	margin-left: -1px;
}
#toolbar-collapse-handle.collapse-handle-collapsed>div {
	width: 28px;
	height: 24px;
	margin-top: 0px;
	margin-left: 0px;
	border-radius: 0 16px 16px 0;
	border: none;
	background-color: var(--colors-dark-060);
}

#toolbar-collapse-handle.collapse-handle-collapsed:hover>div {
	width: 32px;
	height: 24px;
	padding-left: 6px;
	border-radius: 0 16px 16px 0;
	background: linear-gradient(0deg, var(--colors-dark-f10), var(--colors-dark-f10)),
		var(--surface-dark2);
}

#toolbar-collapse-handle>div span {
	transition: transform ease 200ms;
	transform: rotate(v-bind("isCollapsed ? '180deg' : 0"));
}

#toolbar-collapse-handle :deep(.toolbar-tooltip-outer) {
	margin-top: 2px;
	left: v-bind("isCollapsed ? '44px' : '34px'");
}
