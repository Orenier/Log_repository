$card-min-width: 162px;
$card-max-width: 186px;

.vtt-scene-card-wrapper {
	display: flex;
	flex: 1;
	padding: 6px;
	position: relative;
	justify-content: center;
}
.insert-indicator {
	position: absolute;
	top: 12px;
	bottom: 12px;
	width: 4px;

	border-radius: 2px;
	background-color: var(--grayscale-base);
	opacity: 0.7;
	pointer-events: none;
}

.vtt-scene-card {
	display: flex;
	flex-direction: column;
	flex: 1;
	min-width: $card-min-width;
	max-width: $card-max-width;
	// Maintain a 3:2 aspect ratio regardless of width.
	aspect-ratio: 1.5;

	padding: 0;
	border-radius: 8px;
	overflow: hidden;
	cursor: pointer;

	background-position: center;
	background-repeat: no-repeat;
	background-size: cover;

	background-color: #555;

	.dark & {
		background-color: var(--surface2);
	}

	box-shadow: 0px 6px 10px rgba(0, 0, 0, 0.14),
				0px 1px 18px rgba(0, 0, 0, 0.12),
				0px 3px 5px rgba(0, 0, 0, 0.2);
	position: relative;
	text-align: center;
	transition: opacity .1s ease-in-out,;

	&.selected,
	&.selected:focus,
	&.selected:focus-within,
	&.selected:hover {
		outline: 4px solid var(--surface-contrast-border);

		.dark & {
			outline: 2px solid var(--surface-high-contrast-text);
		}
	}

	&:hover,
	&:focus,
	&:focus-within{
		outline: 4px solid rgba(255, 255, 255, 0.2);
	}

	&.merging-to {
		outline: 2px solid var(--primary-l20);
	}

	&:not(.is-folder, .merging-from, .merging-to)::after {
		pointer-events: none;
		content: "";
		position: absolute;
		top: 0;
		right: 0;
		bottom: 0;
		left: 0;
		background-color: linear-gradient(360deg, #000000 6.66%, rgba(0, 0, 0, 0) 41.59%),
							linear-gradient(0deg, rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.3));
		// opacity: .2;
		transition: opacity .15s ease-in-out;
	}

	&.merging-to {
		background-color: var(--primary-d20);

		.dark & {
			background-color: var(--banner-background)
		}
	}

	.folder-icon {
		flex: 1;
		font-size: 40px;
		line-height: 45px;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
	}

	.folder-label {
		display: block;
		margin-top: -4px;

		color: var(--grayscale-d30);
		font-family: var(--proxima-nova);
		font-weight: 600;
		font-size: 13px;
		line-height: 18px;
	}

	.vtt-scene-title > span {
		pointer-events: all;
	}

	.vtt-scene-title {
		padding: 5px 10px;
		width: 100%;
		height: 46px;
		backdrop-filter: blur(15px);
		background-color: rgba(0,0,0,0.3);
		text-align: center;
		display: flex;
		align-items: center;
		justify-content: center;
		pointer-events: none;
		box-sizing: border-box;
		overflow: hidden;

		/* Prevents a weird issue with the parent bleeding underneath */
		margin-bottom: -1px;

		.dark & {
			background-color: rgba(0,0,0,.5);
		}

		.el-text {
			color: var(--grayscale-dark-base);
			font-family: var(--proxima-nova);
			font-weight: 400;
			font-size: 13px;
			line-height: 18px;
			min-height: 18px;
			min-width: 24px;
			width: 100%;
			pointer-events: all;
			width: fit-content;
			cursor: text;
		}

		.el-input {
			pointer-events: all;
			font-size: 13px;
		}
	}

	&.is-folder,
	&.merging-from,
	&.merging-to {
		.vtt-scene-title {
			background: none;
			backdrop-filter: none;
		}
	}

	&.merging-from {
		transform: scale(0.9);
		transition: transform .5s ease-out;
	}

	&.selected {
		.vtt-scene-title {
			background-color: rgba(20, 20, 20, 0.5);
		}
	}

	&:not(.is-folder, .merging-from, .merging-to):hover .vtt-scene-title {
		background-color: rgba(0, 0, 0, .8);
	}

	.condensed & {
		height:65px;

		.vtt-scene-title {
			height: 30px;
			padding-bottom: 2px;
		}

		.folder-wrapper {
			padding:5px;
			.folder-icon {
				font-size: 25px;
				line-height: 25px;
				margin:0;
			}
			.folder-label {
				font-size: 12px;
			}
		}
	}

	.scene-controls {
		position: absolute;
		top: 0px;
		right: 0px;
		width:100%;
		box-sizing: border-box;
		opacity: 0;
		transition: opacity 0.1s ease;
	}

	&:hover .scene-controls,
	&:focus .scene-controls,
	&:focus-within .scene-controls {
		opacity:.95;
	}

	.merge-drop-zone {
		position: absolute;
		height: 100%;
		width: 60%;
		transform: translate(35%, 0);
	}
}

