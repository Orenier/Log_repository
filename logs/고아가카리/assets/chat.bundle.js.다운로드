  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  font-size: 1em;
	font-family: 'Nunito';
  font-weight: 600;
  content: "\u2713";

  color: var(--surface-light);
  background-color: var(--primary-light);
}

.checkbox-pill-form > .grimoire-checkbox:focus {
  outline: none;
  outline-offset: initial;
}

