.block-submenu {
    background: var(--colors-dark-080);
	// Minimum value to put it over zoom.
	z-index: 10001;
	border-radius: 10px;

    display: flex;
    flex-direction: column;
    border: 1px solid var(--colors-dark-f20);
	backdrop-filter: blur(15px);
	color: var(--grayscale-dark-base);
	overflow: visible;

	opacity: 100%;
	transition: opacity 200ms ease-out;

	&.isResizable {
		overflow: auto;
	}
	&.isHidden {
		opacity: 0%;
	}
	&::-webkit-resizer {
		background-color: transparent;
	}
	&::-moz-resizer {
		background-color: transparent;
	}
}

.block-submenu-header {
    color: var(--grayscale-dark-base);
	background-color: var(--colors-dark-030);
    font-style: normal;
    font-family: 'proxima-nova';
	cursor: move;
	border-top-left-radius: 12px;
	border-top-right-radius: 12px;
	padding: 8px 8px 8px 16px;
	border-bottom: 1px solid var(--colors-dark-f10);
}
.block-submenu-body{

	height: 100%;

}
.block-submenu-body,
.block-submenu-footer {
    display: flex;
    min-height: 30px;
	span{
		margin-bottom: 10px;
	}
}

.block-submenu-footer{
	background-color: var(--colors-dark-030);
	box-sizing: border-box;
	min-height: 30px;
	display: flex;
	justify-content: flex-start;
	align-items: flex-end;
	padding: 4px 8px 4px 8px;
	gap: 42px;
	width: 100%;
	height: 46px;
	flex-shrink: 0;
	border-top: 1px solid var(--colors-dark-f10);

}
.title{
    user-select: none;
    -webkit-user-select: none;
    width: 70%;
    margin-top: 5px;
    margin-bottom: 0px;
	font-family:  var(--font-family-proxima-nova);
	font-style: normal;
	font-weight: 600;
	font-size: 16px;
	line-height: 150%;
	color: var(--grayscale-dark-base);
}

:deep(.el-dialog__header) {
    border-bottom: 1px solid var(--colors-dark-f10);
    margin: 0px;
    align-items: center;
    padding-top: 8px;
    padding-right: 12px;
    padding-bottom: 8px;
    padding-left: 10px;
}
:deep(.el-dialog__body) {
    background-color: var(--colors-dark-030);
}

button.pin{
	background-color: var(--dark-card-green);
    border-radius: 4px;
    border: none;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 0px;
    gap: 10px;
    width: 28px;
    height: 28px;
    margin-left: 25%;
    flex-direction: row;
    padding: 0px;
    min-width: 28px;
    min-height: 28px;
	border: 1px solid transparent;
	display:none;
}

button.pin.active, button.pin:active, button.pin:hover {
    border: 1px solid var(--green-l40);
}

button.close{
	background: var(--red-dark-d60) !important;
    color: var(--red-dark-l40) !important;
    border-radius: 4px;
    border: none;
    opacity: 1;
    height:28px;
    text-shadow: none;
    min-width: 28px;
    min-height: 28px;
    margin-left: 8px;
	border: 1px solid transparent;
}

button.close:active, button.close:hover {
    border: 1px solid #F0A4A2;
    opacity: 1;
}

.dottedResizer {
	position: absolute;
    right: 4px;
    bottom: 1px;
}

