.turn-tracker__settings {
	display: flex;
	flex-direction: column;
	padding: 8px;
	gap: 4px;
	font-size: 12px;
}

.turn-tracker__settings-row {
	display: flex;
	flex-direction: row;
	gap: 4px;
}

.turn-tracker__autosort-label {
	display: flex;
	align-items: center;
	gap: 4px;
	cursor: pointer;
}

.turn-tracker__custom-input {
	width: 180px;
