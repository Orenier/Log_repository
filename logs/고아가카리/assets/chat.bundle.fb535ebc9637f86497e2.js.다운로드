.header {
	height: 45px;
	padding-left: 8px;
	padding-right: 8px;
	&{
		font-family: var(--font-family-proxima-nova);
	}
	.rollModifierBtnContainer {
		display: flex;
		justify-content: flex-end;
	}
	.baseButton{
		color: var(--vtt-submenu-label-color);
		border: 1px solid transparent;
	}

	:deep(.baseButton span) {
		pointer-events: none;
	}

	.baseButton:focus, .baseButton:active {
		background: var(--vtt-submenu-btn-bg);
		border: 1px solid var(--vtt-submenu-header-btn-color);
	}
	.baseButton:focus {
		border: 1px solid var(--vtt-submenu-header-btn-color);
	}
	.baseButton.isActive {
		background: var(--vtt-submenu-highlight-color);
	}
	.baseButton:hover {
		border: 1px solid var(--vtt-submenu-btn-border-color);
		background: var(--vtt-submenu-btn-bg);
	}
	.baseButton.isActive:hover {
		background: var(--vtt-submenu-highlight-color);
	}
	.brackets {
		border-right: 1px solid var(--vtt-submenu-highlight-color);
	}
	div div{
		font-size: 16px;
	}
}

.targetNumberContainer {
	display: flex;
	flex-direction: column;
}

.targetNumberInputs {
	display: flex;
	gap: 8px;
	padding-bottom: 8px;
	width: 150px;
}

.subtitle{
	margin-left: 10px;
	margin-bottom:10px;
	font-family:  var(--font-family-proxima-nova);
	font-style: normal;
	font-weight: 600;
	font-size: 14px;
	color: var(--vtt-grayscale-base);
}

.footerToggle{
	margin-bottom: 10px;
	color: var(--vtt-footer-link-color);
}
.multi{
	place-self: center;
}
.plus {
	margin-top: 6px;
}
.dark {
	.multi, .plus {
		img {
			filter: invert(100%) sepia(2%) saturate(192%) hue-rotate(319deg) brightness(116%) contrast(78%);
		}
	}

}
:deep(button.el-button.is-text.firstColBtn), :deep(button.el-button.is-text.gridBtn){
	&:hover {
		background: var(--vtt-submenu-btn-bg);
		border: 1px solid var(--vtt-submenu-btn-border-color);
		border-radius: 4px;
	}
	&:focus {
		background: var(--vtt-submenu-btn-bg);
		border: 1px solid var(--vtt-submenu-btn-border-color);
		border-radius: 4px;
	}
}

button.el-button.is-link{
	--el-button-hover-link-text-color: var(--vtt-submenu-link-btn-hover-color);
}

:deep(.el-divider.el-divider--horizontal){
	border-color: var(--vtt-submenu-highlight-color);
	margin: 0;
}

.el-input-number{
	width: 76px;
	min-width: 76px;
}

.el-select.el-select{
	width: 100%;
}

:deep(main.el-main){
	padding-left: 0;
	padding-right: 0;
	padding-top: 0;
}

.button {
	border-radius: 4px;
	font-family: var(--font-family-proxima-nova);
	font-size: 13px;
	font-style: normal;
	font-weight: 600;
	line-height: normal;
	background-color: unset;
	color: var(--vtt-submenu-header);
	min-width: 20px;
	min-height: 20px;
	justify-items: center;
	margin-right: 16px;
	vertical-align: middle;
	&:hover {
		background-color: var(--vtt-submenu-divider-color);
	}

	&.disabled:hover {
		background-color: unset;
	}
}

.wrapper {
	padding: 0px;
	margin-top: 10px;
	display: flex;
	flex-direction: column;
}

.hug-edges {
	display: flex;
	justify-content: space-between;
	align-items: center;
	width: 100%;
	padding: 0px;
}

.hug-half-mid {
	display: flex;
	justify-content: space-between;
	align-items: center;
	width: 100%;
	padding: 0px;
	gap: 40px
}

.block-submenu-divider {
	margin: 16px 0 16px 0px;
	height: 1px;
	width: 38px;
	background-color: var(--vtt-submenu-divider-color);
}

:deep(.block-submenu-body) {
	padding: 8px 16px 16px 16px;
	overflow: auto;
}
.section {
	width: 100%;
	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-bottom: 8px;

		.title-wrapper {
			display: flex;
			align-items: center;
		}
	}
}
.title {
	margin-right: 6px;
	color: var(--vtt-component-title-color);
	display: inline;
	font-family: "Proxima Nova";
	font-size: 14.625px;
	font-style: normal;
	font-weight: 600;
	line-height: normal;
	text-transform: capitalize;
	min-width: 40px;
}

.large-title{
	color: var(--vtt-component-large-title-color);
	font-size: 16.458px;
	font-style: normal;
	font-weight: 700;
	line-height: normal;
}

.smallerTitle {
	font-size: 13px;
	margin-right: 10px;
	text-transform: unset;
}
.switch-label {
	display: flex;
	align-items: center;
	min-width: 40px;
}

.colorpicker-blocks {
	margin: 8px 0px;
	flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.rowspacer {
	display: flex;
	justify-content: flex-start;
	align-items: center;
	gap: 6px;
}
.rowNumberInput {
	width: 60px;
}

.rowScaleDropdown {
	width: 200px;
	z-index: 3000;
}

.rowScaleDropdown :deep(.el-select__wrapper) {
	box-shadow: none;
    background-color: var(--vtt-component-background-color);
	& {
		border-radius: 0 4px 4px 0;
	}
}

.text-tool-color {
	position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
	height: 100%;
	width: 100%;
}
.text-tool-color-backdrop {
	position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
	height: 100%;
}

.with-switch-in-row {
	:deep(.color-picker-trigger) {
		width: 32px;
		max-width: 32px;
		min-width: 32px;
	}
}
.subheader {
	letter-spacing: 0;
	font-family: "Proxima Nova";
	font-size: 11.557px;
	font-style: normal;
	font-weight: 400;
	line-height: normal;
}

.colorpicker-blocks {
    display: flex;
	flex-direction: row;
    justify-content: center;
    align-items: center;
	gap: 70px;
	width: fit-content;
    height: 100%;
}
.submenu-caret {
	position: absolute;
	background-image: linear-gradient(to top left, var(--grayscale-d30) 50%, transparent 0);
	background-size: 100% 100%;
	background-repeat: no-repeat;
	background-position: left, right;
	width: 6px;
	height: 6px;
	bottom: 12px;
	right: 7px;
}

:deep(.color-picker-popup) {
	z-index: 3100;
}

.wide-divider {
	margin: 8px 0px;
	img {
		width: 100%;
	}
}
.el-input-number__increase, .el-input-number__decrease {
	color: #555;
}

:deep(.block-submenu-footer-content) {
	height: 60px;
	display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 8px;
    align-self: stretch;
	margin:0;
	padding-top: 0px;
	border-radius: 0 0 8px 8px;
