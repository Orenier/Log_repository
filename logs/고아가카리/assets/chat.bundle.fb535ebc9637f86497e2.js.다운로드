A,CACA,+BAAA,CACA,WAAA,CACA,UAAA,CACA,iBAAA,CACA,mCAAA,CACA,qBAAA,CAEA,4CACC,cAAA,CAIF,0CACC,UAAA,CAGD,uDACC,SAAA,CAGD,sCACC,2CAAA,CACA,gEAAA,CAGC,sDACC,uDAAA,CAIF,4CACC,iDAAA,CAIF,gCACC,gDAAA,CAIF,0BACC,WAAA,CAGD,4CACC,WAAA,CACA,gDAAA,CAGD,mCACC,2CAAA",sourcesContent:[`
// Off-flow probe for measuring the name's natural single-line width.
.name-measure {
	position: absolute;
	top: 0;
	left: 0;
	visibility: hidden;
	pointer-events: none;
	white-space: nowrap;
	font-size: 16px;
	padding-left: 4px;
}

li.token {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	margin: 0;
	padding: 4px;
	border-bottom: 1px solid var(--turn-tracker-entry-bottom-border);
	background-color: var(--turn-tracker-entry-background);
	position: relative;
	min-height: 30px;
	justify-content: space-between;
	color: var(--turn-tracker-label);

	// Normal (wide) layout: avatar + name grouped at the left, initiative
	// pushed to the right. The auto margin overrides justify-content so the
	// avatar/name pair stays packed together on the left.
	.avatar {
		order: 0;
	}

	.name {
		order: 1;
		margin-right: auto;
	}

	div.initiative {
		order: 2;
	}

	// Narrow layout: avatar left, initiative right, name drops
	// to its own full-width row below.
	&.narrow {
		div.initiative {
			order: 1;
		}

		.name {
			order: 2;
			flex: 1 1 100%;
			margin-right: 0;
		}
	}

	&.gmlayer {
		opacity: 0.5;
	}

	&.drag-over {
		border-top: 2px solid var(--vtt-primary, #e10085);
	}

	img {
		max-width: 30px;
		max-height: 30px;
		display: inline-block;
		vertical-align: middle;
	}

	div.initiative {
		display: flex;
		align-items: center;
		justify-content: right;
		font-size: 25px;
		font-weight: bold;
		text-align: right;
		float: right;
		width: fit-content;
		height: 38px;
		border-radius: 6px;

		&.dropping {
			background-color: var(--turn-tracker-input-hover);
		}

		:deep(.el-input) {
			width: 90px;
			height: 38px;
			text-align: center;
		}

		:deep(.el-input__wrapper) {
			border-radius: 6px;
			box-shadow: 0 0 0 2px var(--vtt-input-border-color);
			width: 90px;
			height: 38px;
			padding: 0px;
		}

		:deep(.el-input__inner) {
			font-size: 25px;
			height: 100%;
			font-family: "Proxima Nova";
			font-style: normal;
			font-weight: 700;
			line-height: normal;
			text-align: center;
		}
	}

	div.name {
		font-size: 16px;
		padding-left: 4px;
	}

	.controls {
		position: absolute;
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		top: -1px;
		left: -1px;
		background-color: rgba(0, 0, 0, 0.60);
		height: 30px;
		width: 30px;
		border-radius: 4px;
		border: 2px solid rgba(31, 41, 55, 0.08);
		box-sizing: border-box;

		.remove {
			cursor: pointer;
		}
	}

	&:hover .controls {
		opacity: 0.8;
	}

	&.ui-sortable-helper .controls {
		opacity: 0;
	}

	&:first-child {
		background-color: var(--turn-tracker-active);
		border-bottom: 1px solid var(--turn-tracker-active-bottom-border);

		.editable {
			&:hover{
				background-color: var(--turn-tracker-active-input-hover);
			}
		}

		&:hover {
			background-color: var(--turn-tracker-active-hover);
		}
	}

	&:hover {
		background-color: var(--turn-tracker-entry-hover);
	}
}

li.token {
	cursor: move;
}

.initiative.editable:hover {
	cursor: text;
	background-color: var(--turn-tracker-input-hover);
}

:deep(.el-input__inner) {
	font-family: var(--font-family-proxima-nova);
}

