.dl-footer-outer {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	width: 100%;
	font-weight: 600;
	font-size: 10px;
	color: var(--vtt-footer-text-color);
}

.dl-footer-outer__right {
	display: flex;
	align-items: center;
	gap: 8px;
}

.positive-count {
	color: var(--vtt-positive-count);
}

.zero-count {
	color: var(--vtt-zero-count);
}

.footer-section {
	display: flex;
	gap: 2px;
}

.icon-spacing {
	margin-right: 2px;
}

.icon--selectable {
	cursor: pointer;
	border-radius: 8px;
	border: 1px solid transparent;

	&:hover {
