.feature-card {
	display: flex;
	flex-direction: column;
	width: 100%;
	height: 100%;
	max-height: 100%;
	box-sizing: border-box;
	padding: 15px;
	user-select: text;
	pointer-events: auto;

	border-radius: 8px;
	border: 1px solid rgba(255, 255, 255, 0.10);
	background: var(--background-light);
	box-shadow: 0 4px 6px 0 rgba(31, 41, 55, 0.10), 0 2px 4px 0 rgba(31, 41, 55, 0.06);

	&.hover-effect {
        cursor: pointer;

        &:hover {
            background: #F5F5F5;
			.vid-icon {
				opacity: 1;
			}
        }
    }

	.header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		padding-bottom: 0;
		flex-shrink: 0;
		height: 30px;
	}

	.feature-tab-scrollbar {
		flex-grow: 1;
		min-height: 0;
		margin: 0 -8px;
		padding: 0 8px;
	}

	.feature-card-content {
		display: flex;
		flex-direction: column;
		padding-bottom: 16px;
	}

	.video-container {
		width: 100%;
		aspect-ratio: 16 / 9;
		border-radius: 6px;
		overflow: hidden;
		background: #000;

		.dummy-video {
			width: 100%;
			height: 100%;
			display: flex;
			justify-content: center;
			align-items: center;
			cursor: pointer;
			color: white;
			text-decoration: none;
		}
	}

	.vid-divider {
		margin: 8px 0;
		font-family: "Proxima Nova";
		font-size: 10px;
		font-style: normal;
		font-weight: 600;
		line-height: 14px;
	}

	.feature-card-title {
