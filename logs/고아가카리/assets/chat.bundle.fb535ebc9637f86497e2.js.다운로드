.btn-add {
	position: relative;
	display: flex;
	flex-direction: row;
	gap: 8px;

	.el-button {
		padding: 10px 12px;
		margin: 0px;
		height: 40px !important;
	}
	.folder__add {
		border-radius: 6px;
		border: 1px solid;
		border-color: var(--color-action-secondary, #BB1A79);
		color: var(--color-action-on-secondary, #B4006A);
	}

	.btn-label {
		margin-left: 8px;
		display: none;
		font-weight: 700;
	}
}

@media (min-width: 1440px) {
	.btn-add .btn-label {
		display: block;
	}
}

.page-card-menu-header {
	width: 100%;
	display: flex;
	flex-wrap: wrap;
	flex-direction: column;
	justify-content: flex-start;
	align-content: flex-start;
	gap: 8px;

	.current-page-wrapper {
		display: flex;
		align-items: center;
		height: 100%;

		.current-page {
			display: flex;
			flex-flow: row nowrap;
			align-items: center;
			cursor: pointer;

			&__title {
				max-width: 200px;
				overflow: hidden;
				text-overflow: ellipsis;
			}

			&__thumbnail {
				display: none;
				width: 60px;
				height: 35px;
				border-radius: 4px;
				object-fit: cover;
				background-color: var(--surface-light-light-4);
			}

			&:hover {
				.current-page__title {
					color: var(--primary-light-l-20);
				}
			}
		}

		.current-page__title,
		.current-page-settings__text,
		.current-page-settings__icon {
			color: var(--primary-light-base);
		}

		.current-page__title,
		.current-page-settings__text {
			font-family: var(--font-family-proxima-nova);
			font-size: 16px;
			font-weight: 600;
			white-space: nowrap;
			color: var(--primary-light-base);
		}

		.current-page-settings {
			display: none;
			align-items: center;
			padding: 10px;
			cursor: pointer;

			&__icon {
				margin-right: 4px;
			}

			&:hover {
				.current-page__title,
				.current-page-settings__text {
					color: var(--primary-light-l-20);
				}
			}
		}
	}

	.horizontal-wrapper {
		display: flex;
		gap: 8px;
		width: 100%;
		align-items: center;
		justify-content: flex-start;

		&__space-between {
			justify-content: space-between;
		}
	}

	.menu-header-title {
		font-family: var(--font-family-proxima-nova);
		font-size: 20px;
		font-weight: 600;
		flex-shrink: 0;
	}

	p {
		font-size: 20px;
		line-height: 20px;
		font-family: var(--font-family-proxima-nova);
	}
	.el-dropdown {
		min-width: max-content;
		//width: max-content;
		& .el-button-group .el_button {
			height: 100%;
		}
	}
	.page-search-input.grimoire__input {
		flex-grow: 1;
		height: 40px;

		.icon {
			color: var(--grayscale-base);
			&.clear {
				cursor: pointer;
			}
		}
	}

	:deep(.el-input__wrapper) {
		border-radius: 8px;
	}

	:deep(.el-input__inner) {
		padding: 8px;
	}
}

@media (min-width: 600px) {
	.page-card-menu-header {
		.current-page-wrapper {
			gap: 16px;
			min-width: 500px;

			.current-page {
				&__thumbnail {
					margin-right: 12px;
					display: block;
				}
			}

			.current-page-settings {
				display: flex;
			}
		}
	}
}

.party-box-wrapper {
	display: flex;
	width: 100%;
	justify-content: flex-end;
	container-type: inline-size;
	z-index: var(--vtt-overlay-z-index);
	gap: 10px;
}

.grimoire__button.btn-cancel {
	background-color: transparent;
	&:deep(span) {
		color: var(--grayscale-light-l-30);
	}
	&:hover,
	&:focus {
		color: var(--el-button-hover-text-color);
		border-color: #585b60;
		background-color: var(--surface-light-light-2);
		outline: none;
	}
}

.dark .grimoire__button.btn-cancel {
	&:deep(span) {
		color: var(--grayscale-dark-d-30);
	}
	&:hover,
	&:focus {
		background-color: var(--surface2);
	}
}

@media (max-width: 1200px) {
	.create-page__label {
		display: none;
	}
	.player-icons {
		display: none;
	}
	.party-banner-outer,
	.party-box-wrapper {
		gap: 0px;
	}
}

.el-button.page-button {
	background-color: var(--surface-dark-dark);
	&:deep(span) {
		width: 24px;
		height: auto;
		color: var(--grayscale-dark-d30);
	}
}

.horizontal-wrapper.input-row {
	gap: 8px;
}

.el-popper.grimoire__tooltip {
	z-index: 10701 !important;
}

.dark .page-card-menu-header .current-page-wrapper .current-page .current-page__title,
.dark
	.page-card-menu-header
	.current-page-wrapper
	.current-page-settings
	.current-page-settings__text,
.dark
	.page-card-menu-header
	.current-page-wrapper
	.current-page-settings
	.current-page-settings__icon {
	color: var(--primary-dark-l40);
}

.dark .page-card-menu-header .current-page-wrapper .current-page:hover .current-page__title,
.dark
	.page-card-menu-header
	.current-page-wrapper
	.current-page-settings:hover
	.current-page-settings__text,
.dark
	.page-card-menu-header
	.current-page-wrapper
	.current-page-settings:hover
	.current-page-settings__icon {
	color: var(--primary-dark-l60);
}

.dark .page-card-menu-header .current-page-wrapper .current-page__thumbnail {
	background-color: var(--surface2);
}
