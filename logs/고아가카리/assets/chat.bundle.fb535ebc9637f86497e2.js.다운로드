.launchpad-card {
	display: flex;
	flex-direction: column;
	width: 100%;
	height: 200px;
	background: var(--vtt-surface2);
	border-radius: 8px;
	overflow: hidden;
	cursor: pointer;
	padding: 0;
	font-family: 'Proxima Nova', sans-serif;
	box-shadow: var(--vtt-card-box-shadow);

	&:hover {
		outline: 2px solid var(--vtt-card-outline-color-hover);
	}

	&:focus {
		outline: 1px solid var(--vtt-card-outline-color-selected);
	}

	&--compact {
		height: 170px;

		&--has-description:not(&--description-on-reveal) {
			.launchpad-card__thumbnail-wrap {
				height: 86px;
			}
		}
	}

	&--selected,
	&--selected:focus,
	&--selected:hover {
		outline: 3px solid var(--vtt-card-outline-color-selected);
	}

	&__thumbnail-wrap {
		position: relative;
		width: 100%;
		height: 160px;
		overflow: hidden;

		&::after {
			content: '';
			position: absolute;
			inset: 0;
			background: rgba(0, 0, 0, 0);
			transition: background 0.15s ease;
			pointer-events: none;
		}
	}

	&:hover .launchpad-card__thumbnail-wrap::after {
		background: rgba(0, 0, 0, 0.15);
	}

	&:hover .launchpad-card__thumbnail-wrap > img {
		transform: scale(1.05);
	}

	&__thumbnail {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
		display: block;
		transition: transform 0.2s ease;

		&--placeholder {
			height: 100%;
			background: var(--vtt-card-placeholder-bg);
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: 8px;
			color: var(--vtt-card-placeholder-icon-color);
		}
	}

	&__overlay-description {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		padding: 6px 10px;
		background: rgba(0, 0, 0, 0.55);
		font-size: 11px;
		color: #fff;
		text-align: center;

		&--below-icon {
			position: static;
			background: transparent;
			color: var(--vtt-submenu-label-color);
			font-size: 11px;
			padding: 0;
		}
	}

	&__info {
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 10px;
		height: 40px;
		flex-shrink: 0;
		box-sizing: border-box;
	}

	&__info--has-description {
		height: 84px;
	}

	// Cards that always show description need a taller card
	&--has-description:not(&--description-on-reveal) {
		.launchpad-card__thumbnail-wrap {
			height: 116px;
		}
	}

	&__title {
		font-family: 'Proxima Nova', sans-serif;
		font-size: 16px;
		font-weight: 700;
		color: var(--vtt-submenu-header);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		margin-bottom: 2px;
	}

	&__description {
		font-family: 'Proxima Nova', sans-serif;
		font-size: 13px;
		font-weight: 100;
		color: var(--vtt-submenu-label-color);
		overflow: hidden;
		text-overflow: ellipsis;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
	}

	&--description-on-reveal {
		.launchpad-card__info {
			height: 40px;
			transition: height 0.1s ease;
		}

		.launchpad-card__thumbnail-wrap {
			transition: height 0.1s ease;
		}

		.launchpad-card__description {
			max-height: 0;
			overflow: hidden;
			opacity: 0;
		}

		&.launchpad-card--has-description:hover,
		&.launchpad-card--has-description.launchpad-card--selected {
			.launchpad-card__info {
				height: 84px;
			}

			.launchpad-card__thumbnail-wrap {
				height: 116px;
			}

			.launchpad-card__description {
				max-height: 200px;
				opacity: 1;
			}
		}
	}

	&__badge {
		font-family: 'Proxima Nova', sans-serif;
		font-size: 16px;
		font-weight: 700;
		color: var(--vtt-primary-color);
	}

	&--installed {
		opacity: 0.55;
		cursor: default;

		&:hover {
			outline-color: var(--vtt-submenu-divider-color);
		}
	}

	&--featured {
		width: auto;
		max-width: 300px;

		.launchpad-card__thumbnail {
			height: 100%;
			aspect-ratio: 16 / 9;
		}
	}
}

