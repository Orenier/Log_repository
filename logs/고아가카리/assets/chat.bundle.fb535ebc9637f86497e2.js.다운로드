.turn-tracker {
	.block-submenu-body {
		padding: 5px;
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}

	// Preserve the same list styles as the legacy #initiativewindow
	ul.characterlist {
		margin: 0;
		padding: 0 0 2rem;
		list-style: none;
		overflow-y: auto;
		flex: 1;

	}

	.token_list_outer {
		display: flex;
		flex-direction: column;
		gap: 2px;
		width: 100%;
		flex: 1;
		overflow: hidden;
		padding: 4px;
	}

	.initiative_top_section {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 2px 4px;

		.count__wrapper {
			display: flex;
			align-items: center;
			gap: 4px;
			font-family: var(--font-family-proxima-nova);
			font-weight: 600;
			font-size: 12px;
			font-style: normal;
			line-height: normal;
			color: var(--turn-tracker-count-color);

			p {
				margin: 0px;
			}

		}

		.sortlist_quicksort {
			display: flex;
			align-items: center;
			height: 24px;
			width: 26px;
			font-size: 18px;
			cursor: pointer;
			border-radius: 4px;
			color: var(--turn-tracker-count-color);

			span {
				font-family: Roll20Icons;
				text-align: center;
			}

			&:hover {
				background-color: var(--turn-tracker-sort-hover);
			}
		}
	}

	.settings-button {
		display: flex;
		align-items: center;
		color: var(--turn-tracker-settings-button);
		height: 28px;
		width: 28px;
		box-sizing: border-box;
		padding: 8px;

		&:hover {
			background: var(--turn-tracker-sort-hover);
		}
	}

	.turn-tracker__end-drop-zone {
		height: 32px;
		margin: 2px 0;
		border-radius: 4px;
		border: 1px dashed var(--turn-tracker-count-color);
		opacity: 0.4;
		transition: opacity 0.1s, background-color 0.1s;

		&.drag-over {
			opacity: 1;
			background-color: var(--turn-tracker-sort-hover);
		}
	}

	// Footer prev/next buttons
	.turn-tracker__footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		width: 100%;
		padding: 8px;
		gap: 4px;
	}

	.turn-tracker__change-button {
		display: flex;
		justify-content: center;
		align-items: center;
		box-sizing: border-box;
		padding: 8px;
		height: 28px;
		width: 100%;
		border-radius: 4px;
	}

	.turn-tracker__forward {
		font-size: 10px;
		color: white;
		background-color: var(--turn-tracker-forward);

		&:hover {
			background-color: var(--turn-tracker-forward-hover);
		}
	}

	.turn-tracker__back {
		box-sizing: border-box;
		background-color: var(--turn-tracker-back);
		border: 0.5px solid var(--turn-tracker-back-border);
		color: var(--color-action-on-secondary);

		&:hover {
			background-color: var(--turn-tracker-back-hover);
			border: 1px solid var(--turn-tracker-back-border);
		}
	}

	.turn-tracker__learn-more {
		color: var(--color-action-on-secondary);
		font-weight: 600;
	}

	.turn-tracker__back-arrow {
		height: 14px;
		width: 14px;
	}

	.turn_tracker__empty-first-block {
		padding: 5px;
		font-weight: 600px;
	}

	.turn-tracker__empty-outer {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		font-family: var(--font-family-proxima-nova);
		line-height: normal;
		text-align: center;
		gap: 18px;
		font-weight: 600;
		font-size: 13px; 
	}
}

:deep(.block-submenu-footer) {
	background: transparent;
}

