@font-face {
	font-family:"Proxima Nova";
	src:url("https://use.typekit.net/af/2555e1/00000000000000007735e603/30/l?primer=7cdcb44be4a7db8877ffa5c0007b8dd865b3bbc383831fe2ea177f62257a9191&fvd=n7&v=3") format("woff2"),url("https://use.typekit.net/af/2555e1/00000000000000007735e603/30/d?primer=7cdcb44be4a7db8877ffa5c0007b8dd865b3bbc383831fe2ea177f62257a9191&fvd=n7&v=3") format("woff"),url("https://use.typekit.net/af/2555e1/00000000000000007735e603/30/a?primer=7cdcb44be4a7db8877ffa5c0007b8dd865b3bbc383831fe2ea177f62257a9191&fvd=n7&v=3") format("opentype");
	font-display:auto;font-style:normal;font-weight:700;
}

.text-sm-medium {
	font-family: var(--font-family-proxima-nova);
	font-size: 13px;
	font-weight: 600;
	line-height: 18px;
	letter-spacing: 0em;
	text-align: center;
}

.text-base-regular {
	font-family: var(--font-family-proxima-nova);
	font-weight: 400;
	font-size: 16px;
	line-height: 22px;
}

#foreground-layer-button .icon-slot:hover {
	border-radius: 12px;
	filter: drop-shadow(0px 0px 4px rgba(242, 42, 42, 0.1))
		drop-shadow(0px 0px 4px rgba(227, 110, 115, 0.3))
		drop-shadow(1px 1px 4px rgba(255, 88, 97, 0.6));
}

#map-layer-button .icon-slot:hover {
	border-radius: 12px;
	filter: drop-shadow(0px 0px 4px rgba(197, 11, 157, 0.3))
		drop-shadow(0px 0px 2px rgba(143, 1, 84, 0.1))
		drop-shadow(1px 1px 4px rgba(155, 37, 108, 0.6));
}

#tokens-layer-button .icon-slot:hover {
	border-radius: 12px;
	filter: drop-shadow(0px 0px 4px rgba(60, 150, 100, 0.3))
		drop-shadow(0px 0px 2px rgba(27, 174, 92, 0.1))
		drop-shadow(1px 1px 4px rgba(64, 193, 84, 0.6));
}

#gm-layer-button .icon-slot:hover {
	border-radius: 12px;
	filter: drop-shadow(0px 0px 4px rgba(107, 175, 255, 0.3))
		drop-shadow(0px 0px 2px rgba(67, 147, 189, 0.1))
		drop-shadow(1px 1px 4px rgba(92, 199, 255, 0.6));
}

#lighting-layer-button .icon-slot:hover {
	border-radius: 12px;
	filter: drop-shadow(0px 0px 4px rgba(248, 218, 112, 0.3))
		drop-shadow(0px 0px 2px rgba(255, 179, 21, 0.1))
		drop-shadow(1px 1px 4px rgba(255, 200, 87, 0.6));
}

/* Collapsible Toolbar Adjustments */

.toolbar-collapse-adjust {
	transition: left ease 200ms;
}

#secondary-toolbar.legacy-menu.toolbar-collapse-adjust {
	left: 92px;
}

#secondary-toolbar.legacy-menu.toolbar-collapse-adjust.master-toolbar-collapsed {
	left: 36px;
}

#playerzone.toolbar-collapse-adjust {
	left: 44px;
}

#playerzone.toolbar-collapse-adjust.shortened-toolbar {
	left: 0;
}

@media (max-height: 768px) {
	#playerzone.toolbar-collapse-adjust.shortened-toolbar {
		left: 44px;
	}
}

#playerzone.toolbar-collapse-adjust.master-toolbar-collapsed {
	left: 0;
}

/* FX Tool Restyling */

#secondary-toolbar.legacy-menu .fxtools {
	height: 48px;
	padding: 2px;
	border-radius: 12px;
}

.dark #secondary-toolbar.legacy-menu .fxtools {
	background: var(--vtt-surface2);
}

#secondary-toolbar.legacy-menu .fxtools select {
	height: 100%;
	outline: none;
	cursor: pointer;
}

.dark #secondary-toolbar.legacy-menu .fxtools select:hover {
 	background: var(--vtt-submenu-input-hover-color);
}

#secondary-toolbar.legacy-menu .fxtools li {
	height: 100%;
	padding: initial;
	border-right: initial;
	border-radius: 12px;
}

#secondary-toolbar.legacy-menu .fx-tools-edit-outer.fx-tools-edit-outer {
	height: 100%;
	width: 40px;
	padding: 2px;
