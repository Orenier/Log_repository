$primary-pink: #E10085;
$secondary-pink: #ED66B6;

// dark theme
$highlight-purple: #A980BD;
$primary-purple: #702C91;
$text-white: #E6E6E6;

@forward 'element-plus/theme-chalk/src/common/var.scss' with (
  $colors: (
    'primary': (
      'base': #E10085,
    ),
    'success': (
      'base': #00853C,
    ),
    'info': (
      'base': #0B7BB8,
    ),
    'warning': (
      'base': #FFAB00,
    ),
    'danger': (
      'base': #DA1C17,
    )
  ),
  $text-color: (
    'primary': $primary-pink,
    'regular': #1E1523,
    'secondary': $secondary-pink,
    'placeholder': #A5A1A7,
    'disabled': #E9E8E9,
  ),
  $font-size: (
    'base': 16px,
  ),
  $border-color: (
      '': #dcdfe6,
      'light': #e4e7ed,
      'lighter': #ebeef5,
      'extra-light': #f2f6fc,
      'dark': #d4d7de,
      'darker': #cdd0d6,
  ),
  $popover: (
    'title-text-color': var(--el-text-color-secondary),
  ),
);

// If you just import on demand, you can ignore the following content.
// if you want to import all styles:
@use "element-plus/theme-chalk/src/index.scss" as *;
@use "element-plus/theme-chalk/src/dark/var.scss" as * with (

    $colors: (
      'primary' : (
        'base': $primary-purple,
      ),
    ),

    $bg-color: (
        '': #0C0C0C,
        'page': blue,
    ),
    $text-color: (
        'primary': $primary-purple,
        'secondary': $highlight-purple,
    ),

    $border-color : (
      '' : $highlight-purple,
    ),

    $button : (
      'hover-border-color' : $highlight-purple,
      'hover-text-color' : $text-white,
      'border-color': $primary-purple,
      'hover-bg-color' : $highlight-purple,
      'active-bg-color' : $highlight-purple,
    ),


    $fill-color: (
      '': $highlight-purple,
      'light': $highlight-purple,
    ),
);
@use "element-plus/theme-chalk/src/dark/css-vars.scss" as *;
@use "element-plus/theme-chalk/src/common/var.scss" as *;

// Custom Theme Vars
@import "./vars/light.scss";
@import "./vars/dark.scss";

@import url("https://use.typekit.net/fdn1nsr.css");

@font-face {
  font-family: "Proxima Nova";
  src: url("https://use.typekit.net/af/2555e1/00000000000000007735e603/30/l?primer=7cdcb44be4a7db8877ffa5c0007b8dd865b3bbc383831fe2ea177f62257a9191&fvd=n7&v=3") format("woff2"), url("https://use.typekit.net/af/2555e1/00000000000000007735e603/30/d?primer=7cdcb44be4a7db8877ffa5c0007b8dd865b3bbc383831fe2ea177f62257a9191&fvd=n7&v=3") format("woff"), url("https://use.typekit.net/af/2555e1/00000000000000007735e603/30/a?primer=7cdcb44be4a7db8877ffa5c0007b8dd865b3bbc383831fe2ea177f62257a9191&fvd=n7&v=3") format("opentype");
  font-display: auto;
  font-style: normal;
  font-weight: 700;
}

@font-face {
  font-family:"Proxima Nova";
  src:url("https://use.typekit.net/af/e37e5a/00000000000000007735e60d/31/l?primer=7cdcb44be4a7db8877ffa5c0007b8dd865b3bbc383831fe2ea177f62257a9191&fvd=n6&v=3") format("woff2"),url("https://use.typekit.net/af/e37e5a/00000000000000007735e60d/31/d?primer=7cdcb44be4a7db8877ffa5c0007b8dd865b3bbc383831fe2ea177f62257a9191&fvd=n6&v=3") format("woff"),url("https://use.typekit.net/af/e37e5a/00000000000000007735e60d/31/a?primer=7cdcb44be4a7db8877ffa5c0007b8dd865b3bbc383831fe2ea177f62257a9191&fvd=n6&v=3") format("opentype");
  font-display:auto;
  font-style:normal;
  font-weight:600;
  font-stretch:normal;
}

@font-face {
  font-family: "Proxima Nova";
  src: url("https://use.typekit.net/af/efe4a5/00000000000000007735e609/30/l?primer=7cdcb44be4a7db8877ffa5c0007b8dd865b3bbc383831fe2ea177f62257a9191&fvd=n4&v=3") format("woff2"), url("https://use.typekit.net/af/efe4a5/00000000000000007735e609/30/d?primer=7cdcb44be4a7db8877ffa5c0007b8dd865b3bbc383831fe2ea177f62257a9191&fvd=n4&v=3") format("woff"), url("https://use.typekit.net/af/efe4a5/00000000000000007735e609/30/a?primer=7cdcb44be4a7db8877ffa5c0007b8dd865b3bbc383831fe2ea177f62257a9191&fvd=n4&v=3") format("opentype");
  font-display: auto;
  font-style: normal;
  font-weight: 400;
}

:root {
  font-size: 16px;
}

body {
  font-family: "Proxima Nova", "ProximaNova-Regular", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen-Sans, Ubuntu, Cantarell, "Helvetica Neue", sans-serif;
  font-size: 13px;
}

h1, h2, h3, h4, h5 {
  font-family: Nunito, sans-serif;
}

.el-popper.is-dark {
  --el-bg-color: #E6E6E6;
}

.el-dialog__title {
  --el-text-color-primary: var(--vtt-grayscale-base);
  font-weight: 600;
  --el-dialog-title-font-size: 1rem;
  font-family: var(--font-family-proxima-nova);
}

.el-dialog__headerbtn .el-dialog__close {
  --el-color-info: var(--vtt-close-btn-color);
  background: var(--vtt-close-btn-bg);
  font-size: 24px;
  padding: 4px;
  border-radius: 4px;
}

.el-dialog__headerbtn:focus .el-dialog__close, .el-dialog__headerbtn:hover .el-dialog__close {
  color: var(--el-color-info);
  border: 1px solid var(--vtt-close-btn-hover-border-color);
  opacity: 1;
}

.el-dialog {
  --el-dialog-border-radius: 16px;
  font-family: var(--font-family-proxima-nova);
}

.el-popover {
  --el-popover-border-radius: 16px;
  --el-popover-padding: 8px;
}

.el-notification__content {
  text-align: start; // TODO: File an issue upstream requesting that this can be customized via a CSS var: https://github.com/element-plus/element-plus/blob/dev/packages/theme-chalk/src/notification.scss#L54
}

.el-popper.join-prompt {
  // Ensures that block submenus render above the prompt
  z-index: 10000 !important;
}

.el-popper.no-arrow-dropdown .el-popper__arrow {
  display: none;
}
`,`// CSS3 var
@use 'common/var' as *;
@use 'mixins/var' as *;
@use 'mixins/mixins' as *;

// for better performance do not dynamically change the root variable if you really
// do not need that, since this could introduce recalculation overhead for rendering.
// https://lisilinhart.info/posts/css-variables-performance/

// common
:root {
  @include set-css-var-value('color-white', $color-white);
  @include set-css-var-value('color-black', $color-black);

  // get rgb
  @each $type in (primary, success, warning, danger, error, info) {
    @include set-css-color-rgb($type);
  }

  // Typography
  @include set-component-css-var('font-size', $font-size);
  @include set-component-css-var('font-family', $font-family);

  @include set-css-var-value('font-weight-primary', 500);
