:deep(.el-checkbox__input) {
	.el-checkbox__inner {
		background-color: var(--vtt-checkbox-secondary-unchecked-background);
		border-color: var(--dark-primary-highlight) !important;
	}
}

.customization-subheader {
	font-size: 14px;
}

.title-row {
	position: relative;
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 44px;
	gap: 20px;
}

.text-area {
	position: absolute;
	display: flex;
	align-items: center;
	right: 0px;
	gap: 6px;
}

.title {
	margin-right: 8px;
	color: var(--vtt-component-large-title-color);
	display: inline;
	font-family: "Proxima Nova";
	font-size: 14.625px;
	font-style: normal;
	font-weight: 600;
	line-height: normal;
	text-transform: capitalize;
	min-width: 40px;
}

.icon-select-outer {
	display: flex;
	flex-wrap: wrap;
	gap: 6px;
	width: 100%;
	padding-bottom: 8px;
}

.color-container {
	position: relative;
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	gap: 2px;

	height: 24px;
	width: 24px;
	border-radius: 4px;
	color: var(--vtt-pin-select-text);
}

.color-container:hover {
	color: var(--vtt-pin-select-hover-text);
	background-color: var(--vtt-pin-select-hover);
}

.color-option {
	width: 24px;
	height: 24px;
	border-radius: 3px;
}

.selected-color {
	border: 1px solid var(--vtt-pin-shape-selected-border);
	background: var(--vtt-pin-shape-selected-background);
	color: var(--vtt-pin-select-hover-text);
}

.color-picker-selection-indicator {
	position: absolute;
	top: 32%;
	right: 32%;
	bottom: 32%;
	left: 32%;
	border-radius: 50%;
	opacity: 1;
	background: var(--background-light);
}

.color-picker-item--white {
	box-shadow: inset 0 0 0 1px #ddd;
}

.color-picker-item--white .color-picker-selection-indicator {
	background: #000;
}

.icon-container {
	position: relative;
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	gap: 2px;

	padding: 5px;
	height: 34px;
	width: 34px;
	border-radius: 4px;
	color: var(--vtt-pin-select-text);
	box-sizing: border-box;
}

.icon-container:hover {
	color: var(--vtt-pin-select-hover-text);
	background-color: var(--vtt-pin-select-hover);
}

.premium-star {
	position: absolute;
	top: 6px;
	right: 6px;
	color: #CC8900;
}

.selected-icon {
	border: 1px solid var(--vtt-pin-shape-selected-border);
	background-color: var(--vtt-pin-shape-selected-background);
	color: var(--vtt-pin-select-hover-text);
}

.fg-color-switch {
	display: flex;
	flex-direction: row;
	align-items: center;	
	gap: 12px;
}

.icon-text-input {
	width: 58px;
	height: 20px
}

