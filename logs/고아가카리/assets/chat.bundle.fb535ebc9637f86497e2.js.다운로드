	&:hover {
		background: rgba(0, 0, 0, 0.85);
	}

	// The ArrowLeft icon points left; rotate it to face each button's nudge direction.
	// CSS rotate() is clockwise on screen: left\u2192up = 90deg, left\u2192down = -90deg, left\u2192right = 180deg.
	&--up {
		top: 0;
		left: 50%;
		transform: translate(-50%, calc(-100% - 4px));

		:deep(svg) {
			transform: rotate(90deg);
			transform-origin: center;
		}
	}

	&--down {
		bottom: 0;
		left: 50%;
		transform: translate(-50%, calc(100% + 4px));

		:deep(svg) {
			transform: rotate(-90deg);
			transform-origin: center;
		}
	}

	&--left {
		left: 0;
		top: 50%;
		transform: translate(calc(-100% - 4px), -50%);
	}

	&--right {
		right: 0;
		top: 50%;
		transform: translate(calc(100% + 4px), -50%);

		:deep(svg) {
			transform: rotate(180deg);
			transform-origin: center;
		}
	}
}
