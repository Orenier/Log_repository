.grid-options-menu__body {
	position: relative;
	display: flex;
	flex-direction: column;
	width: 100%;
	padding: 8px;
	padding-top: 0px;
}

.grid-options-menu__toggle {
	display: flex;
	align-items: center;
	justify-content: space-between;
}

.hug-edges {
	display: flex;
	justify-content: space-between;
	align-items: center;
	width: 100%;
	padding: 0;
}

.grid-type-submenu {
	display: flex;
	align-items: center;
	justify-content: center;
	flex-wrap: wrap;
	box-sizing: border-box;
	width: 100%;
	gap: 2px;
	padding: 4px 0px;
}

.grid-options-menu__divider {
	height: 1px;
	background-color: var(--color-overlay-grayscale-xs);
}

.grid-options-menu__section {
	display: flex;
	flex-direction: column;
	width: 100%;
	box-sizing: border-box;
	gap: 4px;
	padding: 4px 0px;
}

.grid-options-menu__row {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	gap: 16px;
}

.grid-options-menu__input {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 4px;
}

.grid-options-menu__color-row {
	display: flex;
	justify-content: space-between;
	align-items: center;
	width: 100%;
}

.grid-options-menu__label {
	font-family: var(--font-family-proxima-nova);
	font-size: 12px;
	font-weight: 600;
	color: var(--vtt-color-text-tertiary);
}

.grid-options-menu__opacity-label {
	font-family: var(--font-family-proxima-nova);
	font-size: 11px;
	font-weight: 400;
	color: var(--color-text-default);
}

:deep(.color-picker-popup) {
	top: auto;
	bottom: 0;
	left: calc(100% + 8px);
}

.grid-type-container {
	position: relative;
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	gap: 1px;
	box-sizing: border-box;
	padding: 4px;
	height: 46px;
	width: 50px;
	border-radius: 4px;
	cursor: pointer;
	color: var(--vtt-pin-select-text);
	border: 1px solid transparent;
	transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
	font-size: 10px;

	&:hover {
		color: var(--vtt-pin-select-hover-text);
		background-color: var(--vtt-pin-select-hover);
	}

	&.selected-grid-type {
		color: var(--vtt-pin-select-hover-text);
		border-color: var(--vtt-pin-shape-selected-border);
		background-color: var(--vtt-pin-shape-selected-background);
	}
}

.grid-type-icon {
	display: flex;
	justify-content: center;
	align-items: center;
	height: 16px;
	width: 16px;

	svg {
		height: 16px;
		width: 16px;
	}
}

.grid-type-title {
	height: 13px;
	font-family: 'Proxima Nova', sans-serif;
	font-size: 12px;
	font-weight: 600;
}

.grid-options-menu__column {
	display: flex;
	flex-direction: column;
	gap: 4px;
}

