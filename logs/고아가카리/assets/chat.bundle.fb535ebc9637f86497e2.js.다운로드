.customization-menu__body {
	position: relative;
	display: flex;
	flex-direction: column;
	padding-top: 4px;
	padding-bottom: 6px;
	padding-left: 8px;
	padding-right: 8px;
	width: 100%;
}

.customization-menu__row {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding-bottom: 12px;
}

.customization-menu__picker-row {
	display: flex;
	flex-direction: column;
	height: fit-content;
	align-items: left;
	gap: 6px;
	padding-bottom: 12px;
	padding-top: 4px;
	font-size: 12px;
	font-weight: 600;
}

.customization-menu__color_row {
	padding-left: 4px;
}

.customization-menu__toggle {
	width: 100%;
	display: flex;
	justify-content: space-between;
	align-items: center;
	gap: 4px;
}

.hug-edges {
	display: flex;
	justify-content: space-between;
	align-items: center;
	gap: 4px;
	width: 100%;
	padding: 0;
}

.customization-menu__label {
	font-family: 'Proxima Nova', sans-serif;
	font-size: 14px;
	font-weight: 600;
	color: var(--vtt-color-text-tertiary);
}

.customization-menu__label-sm {
	font-family: 'Proxima Nova', sans-serif;
	font-size: 10px;
	font-weight: 400;
	color: var(--vtt-color-text-tertiary);
}

.customization-menu__divider {
	margin: 0 16px;
	height: 1px;
	background-color: var(--color-overlay-grayscale-xs);
}

:deep(.color-picker-popup) {
	top: auto;
	bottom: 0;
	right: 0;
	left: auto;
}

:deep(.chip-toggle .vtt-chip-row) {
	background-color: var(--vtt-chip-toggle-background);
	border: var(--vtt-chip-toggle-border);
	border-radius: 6px;
	padding: 4px;

	.vtt-chip {
		flex-grow: 1;
		justify-content: center;
		align-items: center;
		background-color: transparent;
		padding: 4px;

		&.selected-chip {
			background-color: var(--vtt-submenu-chip-color);
		}
	}

	.vtt-chip.selected-chip {
		border-color: var(--vtt-pin-shape-selected-border);
