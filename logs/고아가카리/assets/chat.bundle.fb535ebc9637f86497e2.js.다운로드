}

@keyframes cil-potion-color {
	0%, 100% { fill: rgba(140, 80, 220, 0.5); }
	25%      { fill: rgba(60, 180, 220, 0.5); }
	50%      { fill: rgba(80, 220, 140, 0.5); }
	75%      { fill: rgba(220, 100, 60, 0.5); }
}

.cil-potion__bubble {
	animation:
		cil-potion-rise 2.2s ease-in infinite,
		cil-potion-bubble-color 8s ease-in-out infinite;
}

.cil-potion__bubble--1 {
	animation-duration: 2.2s, 8s;
	animation-delay: 0s, 0s;
}

.cil-potion__bubble--2 {
	animation-duration: 2.6s, 8s;
	animation-delay: 0.5s, 0.5s;
}

.cil-potion__bubble--3 {
	animation-duration: 1.8s, 8s;
	animation-delay: 1.0s, 1.0s;
}

.cil-potion__bubble--4 {
	animation-duration: 2.4s, 8s;
	animation-delay: 1.5s, 1.5s;
}

.cil-potion__bubble--5 {
	animation-duration: 2.0s, 8s;
	animation-delay: 0.8s, 0.8s;
}

@keyframes cil-potion-rise {
	0% {
		opacity: 0;
		transform: translateY(0);
	}
	15% {
		opacity: 0.8;
	}
	80% {
		opacity: 0.5;
		transform: translateY(-4px);
	}
	100% {
		opacity: 0;
		transform: translateY(-6px);
	}
}

@keyframes cil-potion-bubble-color {
	0%, 100% { fill: rgba(180, 130, 255, 0.6); }
	25%      { fill: rgba(130, 210, 255, 0.6); }
	50%      { fill: rgba(130, 255, 180, 0.6); }
	75%      { fill: rgba(255, 160, 120, 0.6); }
}

.cil-potion__glow {
	animation:
		cil-potion-glow 2s ease-in-out infinite,
		cil-potion-glow-color 8s ease-in-out infinite;
}

@keyframes cil-potion-glow {
	0%, 100% { opacity: 0.3; }
	50%      { opacity: 0.6; }
