.outer {
	max-width: 100%;
	border-radius: 6px;
	padding: 1px;
	background: var(--vtt-mini-menu-background);
	box-shadow: 0 2px 4px 0 rgba(0, 0, 0, 0.10),
		1.2px 1.2px 0 0 var(--vtt-mini-menu-shadow),
		1.2px -1.2px 0 0 var(--vtt-mini-menu-shadow),
		-1.2px 1.2px 0 0 var(--vtt-mini-menu-shadow),
		-1.2px -1.2px 0 0 var(--vtt-mini-menu-shadow),
		-1.2px 0 0 0 var(--vtt-mini-menu-shadow),
		1.2px 0 0 0 var(--vtt-mini-menu-shadow),
		0 -1.2px 0 0 var(--vtt-mini-menu-shadow),
		0 2px 4px 0 rgba(0, 0, 0, 0.20),
		0 1px 10px 0 rgba(0, 0, 0, 0.12),
		0 4px 5px 0 rgba(0, 0, 0, 0.14);
	pointer-events: auto;

	&.wider-than-minimenu {
		min-width: 200px;
	}

	.inner {
		display: flex;
		/* Positioning relative so we can absolutely position things inside */
		position: relative;
		flex-direction: column;
		align-items: left;
		border-radius: 6px;
		background: var(--vtt-mini-menu-background);
		color: var(--vtt-map-pin-tooltip-text);
		padding: 8px;
		padding-top: 4px;
		border: solid var(--vtt-mini-menu-border) 2px;
		overflow: clip;

		&.secret {
			border: 0px;
			border: dashed var(--vtt-mini-menu-border) 2px;
		}

		.header {
			display: flex;
			gap: 8px;
			justify-content: space-between;
			align-items: flex-end;
			padding: 0 7px;

			&.border-bottom {
				border-bottom: 1px solid var(--vtt-map-pin-tooltip-tab-background);
			}

			.title {
				color: var(--vtt-mini-menu-title);
				font-size: 16px;
				font-weight: 700;
				display: flex;
				flex-grow: 1;
				overflow: hidden;
				text-overflow: ellipsis;
				max-width: var(--calculated-title-width);
				max-height: 70px;

				&.error {
					padding-bottom: 2px;
				}

				.error-title {
					text-decoration-line: underline;
					text-decoration-style: wavy;
					text-decoration-color: var(--vtt-close-btn-color);
					font-style: italic;
					// line-height: 16px; // Needed for the underline to show properly
				}

				.error-message {
					font-size: 14px;
					font-weight: 400;
					color: var(--vtt-close-btn-color);
					text-transform: lowercase;
					padding-left: 12px;
				}
			}

			:deep(.el-radio-group) {
				min-width: 68px;

				&.small {
					min-width: 60px;

					.el-radio-button .el-radio-button__inner {
						width: 28px;
						height: 28px;
					}
				}

				.el-radio-button {
					margin-bottom: 0;

					.el-radio-button__inner {
						width: 32px;
						height: 32px;
						padding: 0;
						display: flex;
						align-items: center;
						justify-content: center;
						border-radius: 8px 8px 0 0;
						border: none;
						color: var(--vtt-map-pin-header-primary-icon-color);
						box-shadow: none;
						transition: none !important;

						&:hover {
							color: var(--vtt-map-pin-header-primary-hover-icon-color);
						}

						.radio-button-content {
							line-height: 1px;
						}
					}

					&.is-active .el-radio-button__inner {
						border: 1px solid var(--vtt-map-pin-tooltip-tab-border);
						border-bottom: none;
						background-color: var(--vtt-map-pin-tooltip-tab-background);
						color: var(--vtt-map-pin-header-primary-hover-icon-color);
					}

					&.is-disabled .el-radio-button__inner{
						color: var(--vtt-map-pin-header-primary-disabled-icon-color);
						cursor: default;
					}

					&.gm-tab.is-active .el-radio-button__inner {
						color: var(--vtt-map-pin-tooltip-gm-color);
						background-color: var(--vtt-map-pin-tooltip-gm-surface);
					}

					&.non-interactive .el-radio-button__inner {
						cursor: default;
					}
				}
			}
		}

		.main {
			display: flex;
			flex-direction: column;
			gap: 4px;
			font-size: 15px;

			&.error {
				gap: 0;
				align-items: center;

				.divider {
					width: 160px;
					height: 1px;
					background-color: var(--vtt-map-pin-tooltip-gm-border);
				}
			}

			.gm-underlay {
				padding: 6px;
				background-color: var(--vtt-map-pin-tooltip-gm-surface);
				border-radius: 0 0 6px 6px;
				/* Positioning relative so we can absolutely position things inside */
				position: relative;

				.notes .more-gradient-bottom {
					background-image: linear-gradient(transparent, var(--vtt-map-pin-tooltip-gm-surface));
				}
			}

			.player-underlay {
				padding: 6px;

				.image-outer {
					display: flex;
					justify-content: center;
					padding-bottom: 4px;

					.image {
						max-width: 100%;
						/* Hardcoded height here so we can make overlay height 100% */
						&.small {
							max-height: 80px;
						}
						&.large {
							max-height: 180px;
						}
						&.xl {
							max-height: 240px;
						}
						&.medium {
							max-height: 125px;
						}

						&:hover {
							filter: brightness(0.9);
						}
					}
				}
			}

			.notes {
				display: flex;
				/* Positioning relative so we can absolutely position things inside */
				position: relative;
				height: auto;
				width: auto;
				max-height: var(--max-notes-height);

				&.calculated-dimensions {
					height: var(--calculated-notes-height);
					width: var(--calculated-notes-width);
				}

				:deep(.el-scrollbar) {
					flex-grow: 1;
					height: auto;
				}

				.more-gradient-bottom {
					position: absolute;
					bottom: 0;
					height: 16px;
					width: 100%;
					background-image: linear-gradient(transparent, var(--vtt-mini-menu-background));
					display: none;
				}
			}
		}
	}
}
