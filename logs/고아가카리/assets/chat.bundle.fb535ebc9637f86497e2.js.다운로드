@import url('https://fonts.googleapis.com/css2?family=Nunito&display=swap');

.pdf-select-outer {
	border-radius: 12px;
	background: var(--background-light);
	padding: 24px;
	/* resize: both; */
	width: 568px;
}

.pdf-title-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	padding-bottom: 16px;
}

.pdf-select-list {
	height: 400px;
	margin: initial;
	padding: 4px;
	list-style-type: none;
	overflow-y: scroll;
}

.pdf-select-list::-webkit-scrollbar {
    width: 8px;
}

.pdf-select-list::-webkit-scrollbar-track {
    -webkit-box-shadow: inset 0 0 6px rgba(0,0,0,0);
}

.pdf-select-list::-webkit-scrollbar-thumb {
	background-color: var(--grayscale-d60);
	border-radius: 4px;
}

.pdf-import-buttons {
	display: flex;
	flex-direction: row;
	justify-content: center;
	gap: 8px;
}

.btn-lg {
	display: flex;
	flex-direction: row;
	justify-content: center;
	align-items: center;
	padding: 16px 24px;

	box-sizing: border-box;
	border-radius: 10px;
}

.pdf-import-btn-secondary {
	color: var(--primary-light);
	border: 1px solid var(--primary-light);
	background: transparent;
}

.pdf-import-btn-secondary:hover {
	color: var(--background-light);
	background: var(--primary-light-l20);
}

.pdf-import-btn {
	color: var(--background-light);
	background: var(--primary-light);
	border: 1px solid var(--primary-light);
}

.pdf-import-btn:hover {
	background: var(--primary-light-l20);
}

.pdf-import-btn:disabled {
	color: var(--grayscale-l60);
	background: var(--grayscale-l90);
	border: 1px solid var(--grayscale-d30);
}

.hide {
	display: none;
}

/* text */

.text-xl {
	font-weight: 900;
	font-size: 25px;
	line-height: 35px;
}

.btn-text-primary {
	font-weight: 900;
}

.btn-text-secondary {
	font-weight: 700;
}

.btn-text-primary, .btn-text-secondary {
	line-height: 120%;
	letter-spacing: 0.02em;
}

.text-normal, .btn-text-primary, .btn-text-secondary {
	font-size: 16px;
}

.text-normal {
	font-weight: 400;
	line-height: 22px;
}

.pdf-text-nunito.pdf-text-nunito {
	font-family: 'Nunito';
}

.text-base {
	font-family: 'proxima-nova';
	font-style: normal;
}

/* Close */
.pdf-dialog-close {
	cursor: pointer;
}

/* Dark */

.dark .pdf-select-outer {
	background: var(--dark-background);
}

.dark .pdf-import-btn-secondary {
	color: var(--background-light);
	border: 1px solid var(--primary-dark-l20);
	background: transparent;
}

.dark .pdf-import-btn-secondary:hover {
	color: var(--background-light);
	background: var(--primary-dark-l20);
}

.dark .pdf-import-btn {
	background: var(--primary-dark);
	border: 1px solid var(--primary-dark);
}

.dark .pdf-import-btn:hover {
	color: var(--background-light);
	background: var(--primary-dark-l20);
}

.dark .pdf-import-btn:disabled {
	color: var(--grayscale-d60);
	background: var(--grayscale-d30);
	border: 1px solid var(--grayscale-d30);
}

