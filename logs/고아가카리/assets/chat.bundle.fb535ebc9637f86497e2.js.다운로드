@keyframes cil-potion-glow-color {
	0%, 100% { fill: rgba(140, 80, 220, 0.2); }
	25%      { fill: rgba(60, 180, 220, 0.2); }
	50%      { fill: rgba(80, 220, 140, 0.2); }
	75%      { fill: rgba(220, 100, 60, 0.2); }
}

/* ---- Complete state ---- */
.cil-potion__liquid--full {
	fill: rgba(80, 220, 140, 0.55);
	animation: cil-potion-full-settle 0.8s ease-out forwards;
}

@keyframes cil-potion-full-settle {
	0%   { transform: translateY(30px); opacity: 0; }
	30%  { opacity: 0.6; }
	100% { transform: translateY(0); opacity: 1; }
}

.cil-potion__glow--full {
	fill: rgba(80, 220, 140, 0.15);
	animation: cil-potion-full-glow 2s ease-in-out infinite;
}

@keyframes cil-potion-full-glow {
	0%, 100% { opacity: 0.4; }
	50%      { opacity: 0.7; }
}

.cil-potion__shimmer {
	animation: cil-potion-shimmer 2s ease-in-out infinite;
}

@keyframes cil-potion-shimmer {
	0%, 100% { opacity: 0.1; }
	50%      { opacity: 0.25; }
}
