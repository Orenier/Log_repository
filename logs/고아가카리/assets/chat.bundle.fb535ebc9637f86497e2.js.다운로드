.vtt-button {
	display: flex;
	width: 90px;
	padding: 12px 16px;
	justify-content: center;
	align-items: center;
	border-radius: 4px;
	font-family: 'Proxima Nova', sans-serif;
	gap: 6px;
	font-size: 14px;
	font-weight: 600;
	cursor: pointer;
	border: none;
	outline: none;
	box-sizing: border-box;
	transition: background 0.15s ease, color 0.15s ease;
	color: var(--color-text-default);

	&--small {
		height: 28px;
	}

	&--medium {
		height: 32px;
	}

	&--large {
		height: 36px;
	}

	&--primary {
		background: var(--color-action-tool-primary);
		color: var(--color-text-default);
		border: 1px solid var(--color-border-default);

		&.branded {
			color: var(--color-action-on-primary);
			background: var(--color-action-primary);
			border: 1px solid var(--color-action-primary);

			:slotted(a) {
				color: var(--color-action-on-primary);
			}
		}

		&:hover {
			background: linear-gradient(0deg, var(--color-overlay-grayscale-xxs, rgba(255, 255, 255, 0.05)) 0%, var(--color-overlay-grayscale-xxs, rgba(255, 255, 255, 0.05)) 100%), var(--color-action-tool-primary, #1E1E1E);

			&.branded {
				background: var(--color-action-primary-hover);
			}
		}

		&:active {
			border: 2px solid var(--color-border-focus-agnostic);
		}
	}

	&--secondary {
		background: transparent;
		border: 1px solid var(--color-border-subtle);

		&:hover {
			background: var(--color-overlay-grayscale-xxs);
			opacity: 0.7;
		}

		&:active {
			border: 2px solid var(--color-border-focus-agnostic);
			opacity: 1;
		}
	}

	&--tertiary {
		color: var(--color-action-on-tertiary);
		background: transparent;

		&:hover {
			background: var(--color-overlay-grayscale-xxs);
			opacity: 0.7;

			&.branded {
				color: var(--color-action-primary-hover);
			}
		}

		&:active {
			border: 2px solid var(--color-border-focus-agnostic);
			opacity: 1;
		}
	}

	&:disabled {
		background: var(--color-action-disabled);
		opacity: 0.5;
		cursor: not-allowed;
	}
}
