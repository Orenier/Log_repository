.color-picker-popup {
	position: absolute;
	top: calc(100% + 8px);
	left: -4px;
	padding: 4px;
	width: calc((28px + 4px) * 8 + 4px);
	border-radius: 4px;
	box-sizing: border-box;
	box-shadow: 0 2px 10px rgba(0,0,0,.12), 0 2px 5px rgba(0,0,0,.16);
	background-color: var(--vtt-surface2);
	line-height: 0px;
}

.flipHorizontal {
	left: auto;
	right: -4px;
}

.color-picker-palette {
	overflow: hidden;
	padding: 0;
	margin: 0;
	display: flex;
	flex-wrap: wrap;
	gap: 4px;
}

.color-picker-trigger {
	width: 32px;
	height: 32px;
	border: 2px solid var(--colors-dark-f30);
	border-radius: 4px;
	grid-area: 1 / 1 / 2 / 2;
}

.color-picker-item {
	width: 28px;
	height: 28px;
	border-radius: 2px;
}

.color-picker-trigger,
.color-picker-item {
	display: inline-block;
	box-sizing: border-box;
	padding: 0;
	position: relative;
	cursor: pointer;
}
.color-picker-item--white {
	box-shadow: inset 0 0 0 1px #ddd;
}

.color-picker-item--white .color-picker-selection-indicator {
	background: #000;
}

.color-picker-item--transparent,
.color-picker-trigger::before,
.picker-item-checker-backer {
	background-position: 0px 0px, 8px 8px;
    background-size: 16px 16px;
	/* Checkerboard pattern */
    background-image:
		linear-gradient(45deg, #DDDDDD 25%, transparent 25%,
						transparent 75%, #DDDDDD 75%, #DDDDDD 100%),
		linear-gradient(45deg, #DDDDDD 25%, white 25%,
						white 75%, #DDDDDD 75%, #DDDDDD 100%);
}

.color-picker-trigger::before {
	content: '';
	position: absolute;
	z-index: -1;
	left: -1px;
	right: -1px;
	top: -1px;
	bottom: -1px;
	border-radius: 5px;
}

.picker-item-checker-backer {
	position: absolute;
	width: 28px;
	height: 28px;
	border-radius: 4px;
}

.color-picker-selection-indicator {
	position: absolute;
	top: 32%;
	right: 32%;
	bottom: 32%;
	left: 32%;
	border-radius: 50%;
	opacity: 1;
	background: var(--background-light);
}

.color-picker-input-row {
	display: flex;
	flex-direction: row;
	align-content: center;
	align-items: center;
	justify-content: start;
	gap: 4px;
}

.color-picker-input-row .color-picker-item {
	margin: 0;
	min-width: 28px;
	min-height: 28px;
}

.spacer {
	border-top: 1px solid rgba(255, 255, 255, 0.2);
	margin: 8px 4px;
}

/*
	NOTE: These override light mode colors from grimoire. Remove this if the toolbar gets light mode
		support, or make it a conditional if this gets used somewhere that needs light mode support.
 */
:deep(.grimoire__input .el-input__wrapper:hover) {
	box-shadow: var(--vtt-submenu-input-label-color) 0px 0px 0px 1px inset;
}

:deep(.grimoire__input .el-input__wrapper.is-focus) {
	box-shadow: var(--vtt-submenu-input-label-color) 0px 0px 0px 2px inset;
}

:deep(.grimoire__input .el-input__inner) {
	color: var(--vtt-grayscale-base);
}
.trigger--disabled {
	cursor: not-allowed;
	z-index: 1000;
}
.gridStack{
	display: grid;
	scroll-margin-bottom: 40px;
	& {
		grid-area: 1 / 1 / 2 / 2;
	}
