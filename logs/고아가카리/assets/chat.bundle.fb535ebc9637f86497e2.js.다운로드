.dynamic-lighting-preview {
    display: flex;
    flex-flow: column wrap;
    justify-content: center;
    align-items: center;
    width: 100%;
    padding: 8px;
    gap: 10px;

    &__title {
        font-family: 'Proxima Nova', sans-serif;
        font-size: 16px;
        font-weight: 600;
        color: var(--vtt-dl-preview-title);
    }

    &__image {
        width: 100%;
        height: auto;
    }

    &__description {
        font-family: 'Proxima Nova', sans-serif;
        font-size: 13px;
        font-weight: 600;
        text-align: left;
        color: var(--vtt-dl-preview-description);
    }

