			&.search-results-empty-header {
				font-size: var(--el-font-size-medium);
				font-weight: 600;
				line-height: 24px;
				color: var(--grayscale-base);
			}
		}
	}
	.page-container {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(148px, 1fr));
