#announcements-tab {
    display: flex;
    flex-direction: column;
    height: inherit;
	overflow-y: scroll;
	overflow-x: hidden;
}

#categories {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}

.section {
    width: 100%;

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 8px;

        .title-wrapper {
            display: flex;
            align-items: center;
        }
    }
}

.tabs {
    display: flex;
    justify-content: flex-start;
    gap: 12px;

    :deep(span) {
        font-family: "Proxima Nova", sans-serif;
        font-size: 13px;
        font-style: normal;
        font-weight: 700;
        line-height: normal;
        color: var(--grayscale-light-base);
    }

    .dark & :deep(span) {
        color: var(--grayscale-dark-base);
    }
}

.announcement-rail {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex: 1 0 0;
    gap: 8px;
    padding: 0 8px;
}

.help-card-wrapper {
    width: 100%;
}

:deep(.grimoire-tab__button) {
    padding-bottom: 0;
}
