@import '../sharedCardStyles.scss';

@keyframes bounceIn {
	from,
	20%,
	40%,
	60%,
	80%,
	to {
		animation-timing-function: cubic-bezier(0.215, 0.61, 0.355, 1);
	}

	0% {
		opacity: 0;
		transform: scale3d(0.3, 0.3, 0.3);
	}

	20% {
		transform: scale3d(1.1, 1.1, 1.1);
	}

	40% {
		transform: scale3d(0.9, 0.9, 0.9);
	}

	60% {
		opacity: 1;
		transform: scale3d(1.03, 1.03, 1.03);
	}

	80% {
		transform: scale3d(0.97, 0.97, 0.97);
	}

	to {
		opacity: 1;
		transform: scale3d(1, 1, 1);
	}
}

.new-item-added {
	animation: bounceIn 1s;
}

.new-item-added .folder-image :deep(.folder-back) {
	fill: #48bd7d;
}

.new-item-added .folder-image :deep(.folder-paper) {
	fill: #daf2e5;
}

.new-item-added .folder-image :deep(.folder-front) {
	fill: #1aad5c;
}

.new-item-added .folder-image :deep(.folder-highlight) {
	fill: #1aa355
}

.new-item-added .grimoire__roll20-icon {
	color: var(--grayscale-dark-base);
	font-size: 20px;
}

.grayscale .folder-image :deep(.folder-front) {
	fill: #363636;
}
.grayscale .folder-image :deep(.folder-back) {
	fill: var(--grayscale-d60);
}
.vtt-page-title :deep(.el-text) {
	word-break: keep-all;
}
