	height: 100%;
	max-height: 100%;
	box-sizing: border-box;
	padding: 15px;
	user-select: text;
	pointer-events: auto;

	border-radius: 8px;
	border: 1px solid rgba(255, 255, 255, 0.10);
	background: var(--background-light);
	box-shadow: 0 4px 6px 0 rgba(31, 41, 55, 0.10), 0 2px 4px 0 rgba(31, 41, 55, 0.06);

	&.hover-effect {
        cursor: pointer;

        &:hover {
            background: #F5F5F5;
        }
    }

	.header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		padding-bottom: 0;
		flex-shrink: 0;
		height: 30px;
	}

	.help-tab-scrollbar {
		flex-grow: 1;
		min-height: 0;
		margin: 0 -8px;
		padding: 0 8px;
	}

	.help-card-content {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		gap: 12px;
		padding-bottom: 16px;
	}

	.help-card-icon {
		display: flex;
		width: 40px;
		height: 40px;
		justify-content: center;
		align-items: center;
		border-radius: 8px;
		background: var(--color-chip-Blue-Chip-BG, #CCE3F0);
		flex-shrink: 0;

		// Colors mirror the matching .help-card-chip colors so the icon and
		// the cardTag chip always line up.
		&.green {
			color: #284643;
			background: #CCE7D8;
		}

		&.blue {
			color: #074A6E;
			background: #E0EEF6;
		}

		&.pink {
			color: #B4006A;
			background: #F1CFE3;
		}

		&.purple {
			color: #702C91;
			background: #E4D7EA;
		}
	}

