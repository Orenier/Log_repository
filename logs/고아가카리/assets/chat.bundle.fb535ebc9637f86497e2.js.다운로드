// UI sizing variables
$toolbar-width: 42px;
$toolbar-button-height: 34px;
$icon-slot-width: 34px;
$icon-slot-height: 34px;
$label-font-size: 66%;
$label-letter-spacing: .03rem;
$label-padding-horizontal: 0px;
$submenu-caret-width: 4px;
$submenu-caret-height: 4px;
$submenu-caret-bottom: 2px;
$submenu-caret-right: 4px;

button {
	// Remove some default stuff and some vendor stuff.
	background-color: inherit;
	border: none;
	padding-inline: 0;
	padding-block: 0;
}

.delay-enter-active {
	transition: opacity 0s ease-in 333ms;
}

.delay-enter-from {
	opacity: 0;
}

.delay-leave-to {
	opacity: 100%;
}

.toolbar-button-outer {
	position: relative;
	display: flex;
	flex-direction: row;
	justify-content: center;
	align-items: center;
}

.toolbar-button-mid {
	display: flex;
	flex-direction: column;
	align-items: center;
}

.toolbar-button-inner {
	display: flex;
	flex-direction: column;
	align-content: space-between;
	justify-content: center;
	align-items: center;
	position: relative;
	width: $toolbar-width;
	height: $toolbar-button-height;
}

.icon-selected.icon-selected {
	border: 1px solid;
	border-radius: 12px;
	border-color: var(--vtt-toolbar-border-color);
	color: v-bind("isSelectedLayer ? 'var(--vtt-toolbar-active-layer-selection-color)' : 'var(--vtt-toolbar-active-selection-color)'");
}

.icon-slot {
	color: var(--vtt-toolbar-icon-color);
	display: flex;
	justify-content: center;
	align-items: center;
	width: $icon-slot-width;
	height: $icon-slot-height;
	border-radius: 12px;
}

.icon-slot.disabled {
	color: var(--vtt-toolbar-disabled-icon-color);
}

.icon-background {
	background: var(--vtt-layer-btn-bg);
}

.icon-slot.icon-collapsed {
	position: relative;
	background-color: var(--vtt-toolbar-collapsed-selection-bg);
	color: var(--vtt-toolbar-collapsed-selection-color);
	border-color: var(--vtt-toolbar-collapsed-selection-border);

	&:after {
		position: absolute;
		right: 2px;
		content: '';
		background-color: var(--vtt-toolbar-collapsed-selection-indicator);
		height: 4px;
		width: 4px;
		border-radius: 100%;
	}
}

.label {
	display: flex;
	justify-content: center;
	font-family: var(--font-family-proxima-nova);
	color: var(--vtt-layer-label-color);
	padding: 1.95px 5.85px $label-padding-horizontal;
	letter-spacing: $label-letter-spacing;
	font-size: $label-font-size;
	max-width: 0px;
}

.label:hover {
	color: var(--vtt-toolbar-active-selection-color);
}

.decoration {
	position: absolute;
	top: 0px;
	right: 2px;
	line-height: 12px;
	text-shadow: 2px 2px 2px rgba(0, 0, 0, 0.2);
}

.decoration-slot {
	position: absolute;
	top: 0px;
	right: 2px;
	line-height: 12px;
	text-shadow: 2px 2px 2px rgba(0, 0, 0, 0.2);
}

.premium-decoration {
	color: var(--vtt-premium-gold);
}

.submenu-caret {
	position: absolute;
	background-image:
		linear-gradient(to top left, var(--vtt-submenu-caret-color) 50%, transparent 0);
	background-size: 100% 100%;
	background-repeat: no-repeat;
	background-position: left, right;
	width: $submenu-caret-width;
	height: $submenu-caret-height;
	bottom: $submenu-caret-bottom;
	right: $submenu-caret-right;
}

.submenu-click-interceptor {
	z-index: 2;
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
}

.toolbar-icon-svg svg{
	color: var(--vtt-grayscale-base);
}
