.nexus-compendium-container {
	border-radius: 5px;
	background: var(--vtt-nexus-compendium-container-background);
	max-width: 400px;
	width: 100%;
	margin: 0 auto;
	position: fixed;
	bottom: 0;
	transition: all 0.3s;
	z-index: 10;

	&__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.25rem;

		padding: 12px 16px 12px 8px;
		border: 1px solid transparent;

		&:hover {
			border-radius: 5px;
			border: var(--vtt-nexus-compendium-header-hover-border);
