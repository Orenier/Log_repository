.submenu {
	display: flex;
    padding: 8px;
	padding-bottom: 12px;
	top: -6px;
	min-width: 324px;
	font-weight: 500;
	font-size: 13px;
	line-height: 16px;
}

.menu-entry {
	padding: 8px;
}

.switch-wrapper {
	display: flex;
    align-self: stretch;
    padding-right: 8px;

	.switch {
		display: flex;
		flex-grow: 1;
		justify-content: space-between;
	}
}

.menu-divider-wide {
	padding: 0;
	margin: 4px 5px;
	background-color: rgba(0, 0, 0, .1);
	height: 1px;
	width: calc(100% - 10px);
}

.dark .menu-divider, .dark .menu-divider-wide {
	background-color: rgba(255, 255, 255, .05);
}

.sub-label {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 4px;
	margin: 4px 0;
}

.shortcut-text {
	color: var(--vtt-submenu-tooltip-bold-text-color);
}

.darkness-label {
	color: var(--vtt-toolbar-lighting-layer-icon);
}

.foreground-label {
	color: var(--vtt-toolbar-foreground-layer-icon);
}

.gm-layer-label {
	color: var(--vtt-toolbar-gm-layer-opacity);
}

.layer-icon-svg {
	width: 16px;
}

// So toolbar doesn't jump up.  Not exactly beautiful, but functional.
@media(max-height: 316px) {
	.submenu {
		top: -14px;
		padding-top: 1px;
		padding-bottom: 1px;
	}
}
