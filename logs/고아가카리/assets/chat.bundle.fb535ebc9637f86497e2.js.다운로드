			white-space: nowrap;
			text-overflow: ellipsis;
			width: 200px;
			overflow: hidden;
		}
	}

	.help-card-body-copy {
		max-height: 217px;
		overflow: hidden;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 9;

		&,
		&:deep(p) {
			margin: 0;
			color: var(--grayscale-d90);
			font-family: "Proxima Nova", sans-serif;
			font-size: 13px;
			font-style: normal;
			font-weight: 400;
			line-height: normal;
			overflow: hidden;
		}

		&:deep(ul) {
			padding-left: 20px;
			margin-top: 8px;
			margin-bottom: 0;
		}

		&:deep(li) {
			margin-bottom: 6px;
		}
	}

	.help-card-footer {
		display: flex;
		justify-content: flex-start;
		align-items: center;
		gap: 12px;
		// 40px icon + 12px gap, so the footer lines up with .help-card-body-copy
