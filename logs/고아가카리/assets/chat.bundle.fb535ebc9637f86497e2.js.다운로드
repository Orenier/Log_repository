@import url("https://fonts.googleapis.com/css2?family=Nunito&display=swap");

.pdf-item {
	position: relative;
	max-height: 76px;
	border-radius: 12px;
	margin-bottom: 4px;
	background-color: var(--background-light);
}

.pdf-item:after {
	content: "";
	position: absolute;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;
	z-index: 0;
	border-radius: 12px;
	box-shadow: 0px 20px 25px rgba(31, 41, 55, 0.1), 0px 10px 10px rgba(31, 41, 55, 0.04);
}

.pdf-item-inner {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	padding: 12px;
}

.pdf-title-card {
	display: flex;
	align-content: center;
	align-items: center;
	flex-direction: row;
	gap: 8px;
	width: 50%;
}

.pdf-thumb {
	width: 48px;
	height: 52px;
	border-radius: 8px;
}

.pdf-desc-box {
	display: flex;
	align-content: center;
	align-items: center;
	width: 121px;
}

.pdf-import-buttons {
	display: flex;
	flex-direction: row;
	justify-content: center;
	gap: 8px;
}

/* text */

.pdf-desc-text {
	margin: 0px;

	display: -webkit-box;
	-webkit-line-clamp: 2;
	-webkit-box-orient: vertical;
	overflow: hidden;
	text-overflow: ellipsis;
}

.text-normal {
	font-size: 16px;
}

.text-base {
	font-family: "Nunito";
	font-style: normal;
}

.dot-menu {
	position: absolute;
	right: 28px;
	top: 32px;
	background: var(--background-light);
	padding: 4px;
	border-radius: 4px;
	width: 120px;
	z-index: 2;
	box-shadow: 6px 0px 4px rgba(31, 41, 55, 0.1), 4px 0px 2px rgba(31, 41, 55, 0.06);
}

.dot-menu-item {
	display: flex;
	flex-direction: row;
	align-items: center;
	color: var(--grayscale-l30);
	padding: 4px;
	gap: 4px;

	border-radius: 2px;
	font-size: 16px;
}

.dot-menu-item:hover {
	color: var(--primary-light);
	cursor: pointer;
}

.dot-menu-delete {
	color: var(--red-dark-base);
}

.dot-menu-wrapper {
	z-index: 1;
	display: flex;
	align-items: center;
	padding: 0 20px;
	cursor: pointer;
}

/* Dark */

.dark .pdf-item {
	color: var(--background-light);
	background-color: var(--surface-dark);
}

.dark .pdf-item:after {
  box-shadow: 0px 24px 38px rgba(0, 0, 0, 0.14), 0px 9px 46px rgba(0, 0, 0, 0.12), 0px 11px 15px rgba(0, 0, 0, 0.2);
}

