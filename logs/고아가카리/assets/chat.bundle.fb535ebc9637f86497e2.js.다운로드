.map-layer-toolbar {
	position: fixed;
	bottom: 16px;
	left: 50%;
	transform: translateX(-50%);
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	padding: 4px;
	padding-left: 8px;
	gap: 8px;
	border-radius: 8px;
	background-color: var(--color-surface-glass-Glass-Tool);
	box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
	backdrop-filter: blur(15px);
	-webkit-backdrop-filter: blur(15px);
	color: var(--color-action-on-secondary);
	font-family: 'Proxima Nova', sans-serif;
	font-size: 14px;
	font-weight: 600;
	z-index: 2200;
	transition: opacity 0.15s ease;

	&.collapsed {
		width: 70px;
		min-height: 32px;
		padding: 4px;
		gap: 4px;
		justify-content: flex-start;
		opacity: 0.5;

		.map-layer-toolbar__grip {
			padding-right: 0;
			margin-right: 0;
			border-right: 0;
		}
	}
}

.map-layer-toolbar__grip {
	display: flex;
	align-items: center;
	justify-content: center;
	align-self: stretch;
	box-sizing: border-box;
	color: var(--color-text-subtle);
	cursor: grab;
	touch-action: none;
	user-select: none;
	-webkit-user-select: none;
	transition: color 0.15s ease;

	&:hover {
		color: var(--color-text-default);
	}

	&.dragging {
		cursor: grabbing;
		color: var(--color-text-default);
	}
}

.map-layer-toolbar__collapsed-label {
	display: flex;
	align-items: center;
	min-height: 14px;
	padding: 2px 6px;
	border-radius: 6px;
	box-sizing: border-box;
	color: #E6E6E6;
	background: #880854;
	font-family: var(--font-family-proxima-nova);
	font-size: 9px;
	font-weight: 800;
	line-height: normal;
	letter-spacing: undefined;
	text-transform: uppercase;
}

.map-layer-toolbar__btn {
	display: flex;
	height: 36px;
	padding: 12px 16px;
	justify-content: center;
	align-items: center;
	border-radius: 8px;
	border: 1px solid var(--color-overlay-grayscale-sm, rgba(255, 255, 255, 0.20));
	outline: none;
	cursor: pointer;
	box-sizing: border-box;
	font-family: 'Proxima Nova', sans-serif;
	font-size: 18px;
	font-weight: 600;
	background: var(--color-overlay-grayscale-xs);
	color: var(--color-text-subtle);
	transition: background 0.15s ease, color 0.15s ease;

	&:hover {
		color: var(--color-text-default);
		border: 1px solid  var(--color-overlay-grayscale-xl);
	}

	&.active {
		color: var(--color-text-default);
		border-color: var(--color-text-default);
	}

	&.disabled {
		color: var(--color-text-disabled);
		border-color: var(--color-text-disabled);
	}
}
