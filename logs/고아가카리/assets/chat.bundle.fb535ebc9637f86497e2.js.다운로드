.notifier {
	font-family: var(--font-family-proxima-nova);
	font-size: 16px;
	font-weight: 400;
	line-height: 22px;
	display: flex;
	flex-flow: row nowrap;
	align-items: center;
	justify-content: space-between;
	padding: 0 8px;

	&--default {
		.notifier__icon {
			.grimoire__roll20-icon {
				color: #E10085;
			}
		}
	}

	&--danger {
		.notifier__icon {
			.grimoire__roll20-icon {
				color: var(--vtt-danger-notification-color);
			}
		}

		.notifier__action {
			color: var(--vtt-danger-notification-color);
		}

		.notifier__message {
			color: var(--vtt-danger-notification-color);
		}

		.notifier__divider {
			border-left: 1px solid var(--vtt-danger-notification-color);
		}
	}

	&--warning {
		.notifier__icon {
			.grimoire__roll20-icon {
				color: var(--vtt-warning-notification-color);
			}
		}

		.notifier__action {
			color: var(--vtt-warning-notification-color);
		}

		.notifier__message {
			color: var(--vtt-warning-notification-color);
		}

		.notifier__divider {
			border-left: 1px solid var(--vtt-warning-notification-color);
		}
	}

	&__message-wrapper {
		display: flex;
		align-items: center;
		color: var(--vtt-grayscale-base);
		overflow: hidden;
		flex: 1;
	}

	&__icon {
		display: flex;
		align-items: center;
		margin-right: 10px;
		padding: 4px;
	}

	&__action {
		margin-left: 16px;
		cursor: pointer;
		color: var(--vtt-notification-color);
