.join-popover-container {
	position: relative;
	width: 100%;
}

.join-popover {
	position: absolute;
	z-index: 2000;
	background-color: #ffffff;
	border: 1px solid  #e4e7ed;
	border-radius: 4px;
	box-shadow: 0px 2px 12px 0px rgba(0, 0, 0, 0.1);
	width: auto;
}
.dark .join-popover {
	background-color:  var(--surface-dark);
}

.join-popover.top-start {
	bottom: calc(100% + 10px);
	left: 0;
}

.join-popover.bottom-start {
	top: calc(100% + 10px);
	left: 0;
}

.content {
	display: flex;
	width: 100%;
}

#row-rev {
	flex-direction: row-reverse;
}

.name-box {
	flex-grow: 1;
	background-color: rgba(0, 0, 0, 0.5);
	color: var(--background-light);
}

.name-box .text {
	font-size: medium;
	display: flex;
	align-items: center;
	justify-content: center;
	height: 100%;
}

.nameplate-join {
	width: 24px;
	height: 24px;
	flex-shrink: 0;
	aspect-ratio: 1/1;
	background-color: black;

	.button {
		width: 100%;
		height: 100%;
	}
}

.pop-title {
	display: flex;
	gap: 100px;

	h3 {
		align-content: space-around;
	}
}

.button-row {
	display: flex;
	align-items: flex-start;
	gap: 8px;
	align-self: stretch;
}

.names-only-prompt {
	display: flex;
	padding: 12px 16px 16px 16px;
	flex-direction: column;
	align-items: flex-start;
	gap: 8px;
	align-self: stretch;
	width: 300px;

	p {
		color: var(--vtt-dl-preview-description);
		font-family: "Proxima Nova";
		font-size: 16px;
		font-style: normal;
		font-weight: 400;
		line-height: 22px;
	}

	.grimoire__button {
		padding: 8px;
		display: flex;
		height: 36px;
		padding: 8px;
		justify-content: center;
		align-items: center;
		gap: 4px;
		flex: 1 0 0;
	}

	.grimoire__button.goToSettings {
		text-transform: capitalize;
	}

	.grimoire__button.join {
		text-transform: capitalize;
	}

	.grimoire__button.cancel {
		color: var(--vtt-modal-close-btn-color);
		border-radius: 8px;
		font-size: 1rem;
		font-weight: bold;
		background-color: transparent;
	}

	.grimoire__button.cancel:hover,
	.grimoire__button.cancel:focus {
		background-color: var(--vtt-modal-close-btn-hover-bg-color);
		color: var(--vtt-modal-close-btn-hover-color);
		box-shadow: none;
	}
}

.headphoneicon {
	color: var(--background-light);
}
