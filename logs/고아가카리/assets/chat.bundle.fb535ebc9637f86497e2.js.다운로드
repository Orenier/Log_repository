		font-size: 16px;
		font-style: normal;
		font-weight: 700;
		line-height: 150%;

		&:hover {
			border: var(--vtt-nexus-compendium-button-hover-border);
			cursor: pointer;
			text-decoration: none;
		}
	}
}
