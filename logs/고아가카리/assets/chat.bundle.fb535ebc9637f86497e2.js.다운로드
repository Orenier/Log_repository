.tree-view {
	margin: 5px 5px 5px 0;

	.tree-view-header {
		display: flex;

		.all-btn {
			display: flex;
			justify-content: flex-start;
			flex: 1;
			margin-left: 10px;

			.grimoire__roll20-icon {
				padding-right: 8px;
			}
		}
	}

	.all-btn-wrapper {
		display: flex;
		width: 100%;
		z-index: 1;
	}

	.all-btn, :deep(.node-button) {
		font-family: "Proxima Nova", sans-serif;
		font-size: 16px;
		font-style: normal;
		font-weight: 600;
		padding: 4px;
		border: none;
		background-color: transparent;
		border-radius: 4px;
		line-height: 125%;

		.grimoire__roll20-icon {
			color: var(--blue-dark-base);
		}
	}

	:deep(.node-button.node-info) {
		padding-left: 0;
	}

	:deep(.node-button.node-icon) {
		padding-right: 0;
	}

	:deep(.node-button) {
		.grimoire__roll20-icon {
			padding-right: 8px;
		}
	}

	:deep(.node-wrapper) {
		.node {
			width: 100%;
			position: relative;
			display: flex;
			flex-flow: row nowrap;
			border-radius: 4px;
			margin: 2px 0;
		}
	}

	.all-btn, :deep(.node) {
		&:hover {
			background-color: var(--opacity-colors-5-white-light-515);
		}

		.node-children-count {
			background-color: var(--opacity-colors-5-white-light-520);
		}
	}

	:deep(.node-button.node-icon) {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	:deep(.node-button) {
		outline: none;
		border: none;

		&:hover {
			.grimoire__roll20-icon {
				color: var(--blue-light-d-20);
			}
		}
	}

	:deep(.node-button.node-info) {
		display: flex;
		width: 100%;
		white-space: nowrap;
		overflow: hidden;
	}

	:deep(.node.active) {
		background: var(--opacity-colors-5-white-light-515);
		outline: 1px solid var(--primary-light-l60);
	}

	:deep(.node.dragging) {
		background-color: var(--opacity-colors-5-white-light-515);
	}

	.all-btn.dragging-over, :deep(.node.dragging-over) {
		background: var(--opacity-colors-5-white-light-515);
		outline: 1px solid var(--primary-light-l60);
	}

	.all-btn.file-added, :deep(.node.file-added) {
		background: var(--light-green-l80);
		outline: none;
	}

	:deep(.node-name) {
		flex: 1;
		text-align: left;
		text-overflow: ellipsis;
		overflow: hidden;
		white-space: nowrap;
	}

	:deep(.node-children-count) {
		font-family: Proxima Nova;
		font-size: 13px;
		font-weight: 400;
		background: var(--opacity-colors-5-white-light-515);
		color: var(--grayscale-light-base);
		border: none;
		padding: 0px 4px;
		margin-left: 20px;
		border-radius: 4px;
		text-align: center;
	}

	:deep(.node-no-children-placeholder) {
		width: 10px;
		margin-left: 20px;
	}
}

.dark .tree-view {
	:deep(.node-children-count) {
		background: var(--colors-dark-f20);
		color: var(--dark-primarytext);
	}

	.all-btn, :deep(.node) {
		color: var(--grayscale-dark-d30);

		&:hover {
			color: var(--dark-primarytext);
			background: var(--colors-dark-f10);
		}
	}

	:deep(.node.active) {
		color: var(--dark-primarytext);
	}

	:deep(.node-button) {
		&:hover {
			.grimoire__roll20-icon {
				color: var(--blue-dark-l-40);
			}
		}
	}

	:deep(.node.active) {
		outline: 1px solid var(--dark-purple-text);
		background: var(--colors-dark-f10);
	}

	:deep(.node.dragging) {
		background: var(--colors-dark-f10);
		color: var(--grayscale-dark-base);
	}

	.all-btn.dragging-over, :deep(.node.dragging-over) {
		background: var(--dark-gamecard);
		outline: 1px solid var(--dark-purple-text);
	}

	.all-btn.file-added, :deep(.node.file-added) {
		background: var(--dark-card-green);
		border: none;
	}
}
