.flex-wrapper {
	display: flex;
    flex-flow: row nowrap;
    width: auto;
    gap: 12px;
    box-sizing: border-box;
    position: relative;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;

	:not(.disabled).__box:hover ~ .__units,
	:not(.disabled).__box:focus ~ .__units {
		display: none;
	}

	.__box, .__units {
		font-size: 13px;
		font-family: 'Proxima Nova', sans-serif;
		font-weight: 600;
		color: var(--vtt-dl-preview-description);
	}

	.__container {
		position: relative;

		.label {
			font-family: "Proxima Nova";
			font-size: 11.56px;
			font-style: normal;
			font-weight: 600;
			line-height: 16px;
			letter-spacing: 1.2px;
			padding-left: 0px;
			padding-right: 0px;
			color: var(--vtt-submenu-header);
		}

		.pillBox {
			display: flex;

			.__box {
				width:  v-bind(width);
				background-color: transparent;
				border: 1px solid var(--vtt-input-outline-color);
				border-radius: 4px 0px 0px 4px;
				padding: 9px;
				appearance: textfield;
				max-width: 55px;
				font-family: "Proxima Nova";
				font-size: 13px;
				font-style: normal;
				font-weight: 600;
				line-height: normal;
			}

			.append {
				display: flex;
				height: 36px;
				padding: 0px 8px;
				align-items: center;
				border: 1px solid var(--vtt-input-outline-color);
				border-left: none;
				border-radius: 0px 4px 4px 0px;
				color: var(--vtt-dl-preview-description);
				background-color: var(--vtt-component-background-color);
				font-size: 11.557px;
				font-style: normal;
				font-weight: 600;
				line-height: normal;
				letter-spacing: 0;
			}

			&:not(.disabled):focus, &:not(.disabled):active {
				appearance: inherit;
				border: 1px solid var(--vtt-block-submenu-secondary-btn-color);
			}

			&:not(.disabled):hover {
				appearance: inherit;
			}

			&.disabled {
				> * {
					border:none;
				}

				.__box {
					color: var(--vtt-color-text-disabled);
					background-color: rgba(80, 87, 110, 0.1);
					user-select: none;
				}
			}
		}

		.__units {
			position: absolute;
			right: 10px;
			top: 25%;
		}
	}
}

