		font-family: 'Proxima Nova';
		font-size: 13px;
		font-style: normal;
		font-weight: 600;
		line-height: 18px;
	}

	&__body-button {
		display: flex;
		padding: 0.5rem;
		justify-content: center;
		align-items: center;
		gap: 0.25rem;
		border-radius: 0.25rem;
		border: var(--vtt-nexus-compendium-button-border);
		background: var(--vtt-nexus-compendium-button-background);
		color: var(--vtt-nexus-compendium-button-text-color);
