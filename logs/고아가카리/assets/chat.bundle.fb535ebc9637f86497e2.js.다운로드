#whats-new-insert-outer {
	display: flex;
	flex-direction: column;
	justify-content: space-between;
	background: var(--primary-light-l80);
	max-height: v-bind(computedHeight);
	background-size: cover;
	padding: 0px;
	margin: initial;
}

#whats-new-insert-outer.whats-new-hidden {
	transition: max-height 0.55s ease-out;
	overflow: hidden;
}

#whats-new-insert-outer .whats-new-inner {
	display: flex;
	flex-direction: column;
	margin:20px;
	gap: 8px;
	padding-left: 25px;
}

#whats-new-insert-outer .whats-new-inner .whats-new-upper {
	display: flex;
	flex-direction: column;
	gap: 8px;
}

#whats-new-insert-outer .font-normal {
	color: #F5F5F5;
	font-family: "Nunito", sans-serif;
	font-style: normal;
	font-weight: bold;
}

#whats-new-insert-outer .whats-new-title {
	font-size: 1.2em;
	line-height: 150%;
}
#whats-new-insert-outer .whats-new-date {
	line-height: 14px;
	font-size: 10px;
	color: var(--primary-light-l60);
}
#whats-new-insert-outer .whats-new-text {
	font-size: 13px;
	line-height: 18px;
}

/* Buttons */

#whats-new-insert-outer .whats-new-buttons {
	display: flex;
	flex-direction: left;
	gap: 4px;
}

#whats-new-insert-outer .whats-new-button.opt-in-button {
	color: #F5F5F5;
	background-color: var(--expertise-dark-l20);
}

#whats-new-insert-outer .opt-in-button:hover {
	background-color: var(--primary-light-l20);
}

#whats-new-insert-outer .feedback-button:hover {
	background-color: var(--primary-light-l20);
}

#whats-new-insert-outer .learn-more-button {
	color: var(--expertise-dark-l20);
}

#whats-new-insert-outer .learn-more-button:hover {
	background-color: var(--primary-light-l80);
}

#whats-new-insert-outer .learn-more-button:active {
	height: 30px;
	background-color: var(--primary-light-l80);
	border: 4px solid var(--primary-light-l60);
}

#whats-new-insert-outer .whats-new-button {
	font-family: var(--font-family-proxima-nova);
	font-style: normal;
	font-weight: 400 !important;
	font-size: 13px;
	line-height: 18px;

	display: flex;
	align-items: center;
	justify-content: center;
	letter-spacing: 0.02em;
	height: 0px;
	border-radius: 10px;
	border: none;
	background: none;
	color: var(--surface-primary-text);
}

#whats-new-close.whats-new-close {
	position: absolute;
	border: none;
	background-color: transparent;
	box-shadow: none;
	color: var(--vtt-secondary-text);
	height: 30px;
	width: 30px;
	right: 20px;
	top: 20px;
	padding: 13px;
	opacity: 60%;
}

#whats-new-close.whats-new-close:hover {
	background-color: var(--vtt-submenu-input-hover-color);
}

#whats-new-learn-more .whats-new-button .feedback-button .linkLikeButton {
	background: none;
	border: none;
	padding: 0;
	justify-content: flex-start;
	font-style: normal;
	font-weight: 400;
	line-height: 18px;
	font-family: var(--font-family-proxima-nova) !important;
	font-size: 13px !important;
    letter-spacing: 0px;
}

#whats-new-insert-outer .font-normal{
	color: #333333;
}

/* Dark Styles */

.dark #whats-new-insert-outer {
	background: #2D123A;
}

.dark #whats-new-insert-outer .font-normal{
	color: #F5F5F5;
}
.dark #whats-new-insert-outer .whats-new-button.opt-in-button {
	background: var(--primary-dark);
}

.dark #whats-new-insert-outer .opt-in-button:hover {
	background-color: var(--primary-dark-l20);
}

.dark #whats-new-insert-outer .opt-in-button:active {
	background-color: var(--primary-dark-l20);
	border: 4px solid var(--primary-dark-l60);
}

.dark #whats-new-insert-outer .feedback-button:hover {
	background-color: var(--primary-dark-l20);
}

.dark #whats-new-insert-outer .learn-more-button {
	color: var(--primary-dark-l40);
}

.dark #whats-new-insert-outer .learn-more-button:hover {
	background-color: var(--primary-dark-l80);
}

.dark #whats-new-insert-outer .learn-more-button:active {
	background-color: var(--primary-dark-l80);
	border: 4px solid var(--primary-dark-l20);
}

.dark #whats-new-insert-outer .learn-more-button:active {
	background-color: var(--primary-dark-l80);
	border: 4px solid var(--primary-dark-l20);
}

.dark #whats-new-insert-outer .whats-new-date {
	color: var(--primary-dark-l60);
}

.dark #whats-new-insert-outer .whats-new-button {
	color: var(--vtt-submenu-link-btn-color);
}

.dark #whats-new-insert-outer .whats-new-button:hover{
	color: var(--primary-dark-l40);
}
