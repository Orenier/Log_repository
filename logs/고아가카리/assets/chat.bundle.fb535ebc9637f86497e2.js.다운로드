.dark {
	.multiple-sheets-settings {
		p {
			color: #FFFFFF;
		}

		.info-description {
			color: var(--dark-secondarytext);
		}

		.enable-multiple-sheets-wrapper {
			background-color: var(--dark-surface2);
		}

		.el-button {
			color: #ffffff;
		}
	}
}
.multiple-sheets-settings {
    .el-button {
        font-family: 'Nunito';
    }

    p {
        font-family: 'Proxima Nova';
        font-size: 13px;
    }

    .multiple-sheets-header {
        margin-bottom: 8px;
    }

    .info-title {
        font-family: 'Proxima Nova';
        font-size: 14px;
        font-weight: 900;
        display: flex;
        align-items: center;
    }

    .sheet-name {
        font-family: 'Proxima Nova';
        font-size: 14px;
    }

    .current-sheet-overview-wrapper {
       display: flex;
       flex-flow: row nowrap;
       align-items: center;
       gap: 8px;

       .current-sheet-preview-image {
           width: 60px;
           height: 70px;
           border-radius: 4px;
       }

       .current-sheet-information {
           display: flex;
           flex-flow: column wrap;
           align-items: flex-start;
           justify-content: center;

           .sheet-name {
                margin-bottom: 0;
           }
       }
    }

    .enable-multiple-sheets-wrapper {
        display: flex;
        flex-flow: column wrap;
        background-color: #f9f9f9;
        padding: 8px;
        gap: 8px;
        margin-top: 12px;
        border-radius: 10px;

        .multiple-sheets-preview-image {
            width: 90px;
            height: 110px;
        }

        .enable-multiple-sheets-overview-wrapper {
            display: flex;
            flex-flow: row nowrap;
            align-items: flex-start;
            gap: 8px;
        }

        .add-new-sheet-actions {
			display: flex;
			flex-flow: column wrap;

            .sheet-action-btn {
                font-size: 13px;
                font-weight: 900;
				width: 100%;
				margin: 0;
            }
        }
    }

    .multiple-sheets-overview-wrapper {
        display: flex;
        flex-flow: row nowrap;
        align-items: center;
        gap: 8px;
        margin-bottom: 12px;

        .multiple-sheets-information {
            flex: 1 1 auto;

            &__name-with-chip {
                display: flex;
                align-items: center;
                gap: 6px;
                margin-top: -2px;
            }
        }
    }

    .default-sheet-settings {
        margin-top: 16px;

        .default-sheet-label {
            display: inline-block;
            font-size: 14px;
            font-weight: 900;

			.el-icon {
				transform: translateY(3px);
			}
        }

        .default-sheet-choice {
            flex-flow: column wrap;
            align-items: flex-start;
            justify-content: center;
        }
    }

    .revert-multiple-sheets-wrapper {
        margin-top: 20px;

        .revert-multiple-sheets {
            background-color: transparent !important;
            color: var(--yellow-d20);
            font-weight: 900;

            &:hover {
                color: var(--yellow-d40);
            }

            &:before {
                display: none;
            }
        }
    }
}

.multiple-sheets-stacked-preview-image {
	position: relative;
	min-width: 80px;
    height: 90px;
	margin-right: 4px;

	img {
		width: 60px;
		height: 74px;
		border-radius: 4px;
	}

	img:first-child {
		position: absolute;
		top: 0;
		left: 0;
	}

	img:last-child {
		position: absolute;
		bottom: 0;
		right: 0;
	}
}
