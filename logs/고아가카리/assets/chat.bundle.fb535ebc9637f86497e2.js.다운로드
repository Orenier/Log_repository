.submenu {
	position: absolute;
	background-color: var(--vtt-surface2);
	bottom: -52px;
	left: 52px;
	padding: 16px;
	min-width: 300px;

	font-size: 0.8125;
	line-height: 1.125em;
	color: var(--vtt-submenuy-label-color);
	border-radius: 8px;
}

.submenu::before {
	top: v-bind(movingArrow);
}

.submenu-info-title {
	display: flex;
	flex-direction: row;
	align-items: left;
	gap: 4px;
	font-size: 1em;
	font-weight: 601;
	line-height: 2em;
	color: var(--vtt-label-color);
	margin-bottom: 2px;
}

.subscribe-button {
	margin-top: 8px;
	color: var(--primary-dark-l60);
	cursor: pointer;
	margin-left: auto;
	margin-right: 0;
}

.subscribe-button:hover {
	text-decoration: none;
}

.toolbar-teaser-preview {
    display: flex;
    flex-flow: column wrap;
    justify-content: center;
    width: 100%;
    gap: 10px;
	flex-direction: row;

    &__title {
        font-family: 'Proxima Nova', sans-serif;
        font-size: 16px;
        font-weight: 600;
        color: var(--vtt-dl-preview-title);
    }

    &__image {
        width: 100%;
        height: auto;
    }

    &__description {
        font-family: 'Proxima Nova', sans-serif;
        font-size: 13px;
        font-weight: 600;
        text-align: left;
        color: var(--vtt-dl-preview-description);
    }

    &__buttons-bar {
        display: flex;
        flex-flow: column wrap;
        width: 100%;
        gap: 8px;

        .button {
            font-family: 'Proxima Nova', sans-serif;
            font-size: 14px;
            font-weight: 700;
            padding: 9px;
            border-radius: 4px;
            transition: all 0.2s;
        }

        .button--primary {
            background-color: var(--vtt-block-submenu-primary-btn-bg);
            color: var(--vtt-block-submenu-primary-btn-color);

            &:hover {
                background-color: var(--vtt-block-submenu-primary-btn-hover-bg);
                color: var(--vtt-block-submenu-primary-btn-hover-color);
            }
        }

        .button--tertiary {
            background-color: var(--vtt-block-submenu-tertiary-btn-bg);
            color: var(--vtt-block-submenu-tertiary-btn-color);

            &:hover {
                background-color: var(--vtt-block-submenu-tertiary-btn-hover-bg);
                color: var(--vtt-block-submenu-tertiary-btn-hover-color);
            }
        }
    }
}

.lighting-header-link {
	font-family: 'Proxima Nova', sans-serif;
	font-size: 13px;
	font-weight: 600;
}

#lighting-header-help-link {
	color: var(--vtt-block-submenu-tertiary-btn-color);
}

.lighting-header-lock-icon, #lighting-header-subscription-link {
	color: var(--vtt-premium-gold);
}

.lighting-header-lock-icon {
	margin-right: 6px;
}

