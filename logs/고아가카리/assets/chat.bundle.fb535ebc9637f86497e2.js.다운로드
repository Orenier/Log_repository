.choice-modal {
	position: fixed;
	top: 50%;
	left: 50%;
	transform: translate(-50%, -50%);
	z-index: 10601;
	width: 551px;
	height: 432px;

	background: var(--vtt-container-bg);
	border-radius: 10px;
	box-shadow: 0px 6px 10px rgba(0, 0, 0, .14), 0px 1px 18px rgba(0, 0, 0, .12), 0px 3px 5px rgba(0, 0, 0, .2);
	backdrop-filter: blur(15px);
	color: var(--vtt-grayscale-base);

	display: flex;
	flex-direction: column;

	span, label {
		margin-bottom: 0px;
	}
}

.choice-modal__header {
	color: var(--vtt-grayscale-base);
	font-style: normal;
	font-family: 'proxima-nova';
	border-top-left-radius: 12px;
	border-top-right-radius: 12px;
	padding: 24px 20px;
	display: flex;
	justify-content: space-between;
	flex-shrink: 0;
}

.title-area {
	display: flex;
	align-items: center;
}

.title {
	font-family: var(--font-family-proxima-nova);
	font-style: normal;
	font-weight: 700;
	font-size: 20px;
	color: var(--color-text-default);
}

.dark .title {
	color: var(--vtt-grayscale-base);
}

.buttons-container {
	display: flex;
	align-items: center;
	gap: 4px;
}

button.close {
	display: flex;
	justify-content: center;
	align-items: center;
	border-radius: 4px;
	border: none;
	opacity: 1;
	height: 28px;
	text-shadow: none;
	min-width: 20px;
	min-height: 20px;
	font-size: 16px;
	border: 1px solid transparent;
	color: var(--vtt-layer-label-color) !important;
}

button.close:active, button.close:hover {
	border: 1px solid var(--vtt-layer-label-color);
	opacity: 1;
}

.choice-modal__body {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 10px;
	width: 100%;
	box-sizing: border-box;

	font-family: var(--font-family-proxima-nova);
}

.choice-list {
	display: flex;
	flex-direction: column;
	box-sizing: border-box;
	gap: 10px;
	width: 100%;
	padding: 24px 20px;
}

.choice-modal__choice-row {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 8px 12px;
	gap: 8px;
	width: 100%;
	box-sizing: border-box;
	border-radius: 6px;

	background: var(--color-surface-elevated);
}

.choice-modal__input-row {
	display: flex;
	align-items: center;
	justify-items: left;
	box-sizing: border-box;
	width: 100%;
	padding-left: 20px;
	gap: 8px;
	text-align: center;
}

.choice-modal__choice_desc_area {
	display: flex;
	flex-direction: column;
}

.choice-modal__choice-title {
	font-size: 16px;
	font-weight: 600;
}

.choice-modal__choice-icon {
	height: 44px;
	width: 44px;
	box-sizing: border-box;
	border-radius: 4px;
	padding: 8px;

	background: var(--color-feedback-info-bg);
}

.choice-modal__choice-description {
	font-size: 14px;
	font-weight: 400;
	line-height: 12px;
}

.choice-modal__choice-arrow-button {
	display: flex;
	align-items: center;
	justify-items: center;
	height: 12px;
	width: 12px;
	padding: 8px;
	border-radius: 6px;
	background: var(--color-action-primary);
	color: #FFFFFF;

	:hover {
		background: var(--color-action-primary-hover);
	}
}

