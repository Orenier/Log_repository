.header {
	height: 45px;
	padding-left: 8px;
	padding-right: 8px;
	&{
		font-family: var(--font-family-proxima-nova);
	}

	.baseButton{
		color: var(--vtt-submenu-label-color);
		// Note: Border-box isn't working here because of el+ weirdness
		border: 1px solid transparent;
	}

	:deep(.baseButton span) {
		pointer-events: none;
	}

	.baseButton:focus, .baseButton:active {
		background: var(--vtt-submenu-btn-bg);
		border: 1px solid var(--vtt-submenu-header-btn-color);
	}
	.baseButton:focus {
		border: 1px solid var(--vtt-submenu-header-btn-color);
	}
	
	div div{
		font-size: 16px;
	}

	:deep(.chip-toggle .vtt-chip-row) {
		background-color: var(--vtt-chip-toggle-background);
		border: var(--vtt-chip-toggle-border);
		border-radius: 6px;
		padding: 4px;

		.vtt-chip {
			flex-grow: 1;
			justify-content: center;
			align-items: center;
			background-color: transparent;
			padding: 4px;

			&.selected-chip {
				background-color: var(--vtt-submenu-chip-color);
			}
		}

		.vtt-chip.selected-chip {
			border-color: var(--vtt-pin-shape-selected-border);
		}
	}
}
.baseButton.isActive {
	border: 1px solid transparent;
	background: var(--vtt-submenu-highlight-color);
}
.baseButton:hover {
	border: 1px solid var(--vtt-submenu-btn-border-color);
	background: var(--vtt-submenu-btn-bg);
}
.baseButton.isActive:hover {
	background: var(--vtt-submenu-highlight-color);
}
.brackets {
	border-right: 1px solid var(--vtt-submenu-highlight-color);
}

.colBtn {
	border-left: 1px solid var(--vtt-submenu-highlight-color);
	text-align: center;
	color: var(--vtt-grayscale-base);
}

.gridBtn {
	font-family: var(--font-family-proxima-nova);
	color: var(--vtt-grayscale-base);
}

.advancedRollBtn {
	height: 60px;
	width: 40px;
	padding: 0;
	margin: 0;
}

.firstColBtn {
	font-family: var(--font-family-proxima-nova);
	font-style: normal;
	font-weight: 600;
	font-size: 16px;
	line-height: 150%;
	width: 90%;
	justify-content: left;
	color: var(--vtt-grayscale-base);
	img{
		margin-right:4px;
	}
	// Note: Border-box isn't working here because of el+ weirdness
	border: 1px solid transparent;
}

.firstColBtn:active{
	background: var(--vtt-submenu-highlight-color);
}

.firstColBtn:hover, .gridBtn:hover{
	background: var(--vtt-submenu-btn-bg);
	border: 1px solid var(--vtt-submenu-btn-border-color);
}

.lastCol {
	border-right: 1px solid var(--vtt-submenu-highlight-color);

}

.advancedRollBtnContainer {
	display: flex;
	justify-content: center;
	gap: 2px;
	padding: 0 10px 0 6px;
}

.advancedRollBtnInner {
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	font-size: 13px;
	gap: 15px;
}

.advancedRollerContainer {
	display: flex;
	justify-content: center;
}

.advancedRollerInner {
	display: flex;
	flex-direction: column;
	gap: 10px;
	padding: 0 8px;
	align-items: flex-start;
	width: 100%;
	max-width:350px;
}

.advancedRollerInputs {
	display: flex;
	gap: 8px;
	width:100%;
}

.targetNumberContainer {
	display: flex;
	flex-direction: column;
}

label[for=dice-roller-target-number-toggle] {
	padding: 0;
	margin-bottom: 0;
}

.targetNumberInputs {
	display: flex;
	gap: 8px;
	padding-bottom: 8px;
	width: 150px;
}

.rollButton {
	width: 216px;
}

.rollHistory {
	align-items: center;
	display: flex;
	flex-direction: column;

}

.rollHistory{
	user-select: text;
	text-align: center;
	text-align: -webkit-center;
	background-color: transparent;

}

.subtitle{
	margin-left: 10px;
	margin-bottom:10px;
	font-family:  var(--font-family-proxima-nova);
	font-style: normal;
	font-weight: 600;
	font-size: 14px;
	color: var(--vtt-grayscale-base);
}

.formulaHistory{
	margin-top: 7px;;
}
.footerToggle{
	color: var(--vtt-footer-link-color);
}
.plus{
	place-self: center;
	span{
	font-style: normal;
	}
}

.rollHelp {
	margin: 5px 15px 5px 15px;
}
:deep(button.el-button.is-text.firstColBtn), :deep(button.el-button.is-text.gridBtn){
	&:hover {
		background: var(--vtt-submenu-btn-bg);
		border: 1px solid var(--vtt-submenu-btn-border-color);
		border-radius: 4px;
	}
	&:focus {
		background: var(--vtt-submenu-btn-bg);
		border: 1px solid var(--vtt-submenu-btn-border-color);
		border-radius: 4px;
	}
}

button.el-button.is-link{
	--el-button-hover-link-text-color: var(--vtt-submenu-link-btn-hover-color);
}

:deep(.el-divider.el-divider--horizontal){
	border-color: var(--vtt-submenu-highlight-color);
	margin: 12px 0;
}

.el-input-number{
	width: 76px;
	min-width: 76px;
}

.el-select.el-select{
	width: 100%;
}

:deep(main.el-main){
	padding-left: 0;
	padding-right: 0;
	padding-top: 0;
}

.rollModifierBtnContainer {
	display: flex;
	justify-content: flex-end;
}
