.content-install-loading {
	position: fixed;
	inset: 0;
	z-index: 20000;
	background: rgba(0, 0, 0, 0.85);
	display: flex;
	align-items: center;
	justify-content: center;
}

.content-install-loading__content {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 20px;
}

.content-install-loading__animation {
	width: 80px;
	height: 160px;
	display: flex;
	align-items: center;
	justify-content: center;
}

.content-install-loading__label {
	margin: 0;
	font-family: 'Nunito', sans-serif;
	font-size: 20px;
	font-style: normal;
	font-weight: 700;
	line-height: normal;
	color: #FFFFFF;
}

.content-install-loading__progress-track {
	width: 320px;
	height: 6px;
	background: var(--color-grayscale6, #444);
	border-radius: 3px;
	overflow: hidden;
}

.content-install-loading__progress-bar {
	height: 100%;
	background: #59CDE9;  /* fallback for old browsers */
	background: -webkit-linear-gradient(to right, #0A2A88, #59CDE9);  /* Chrome 10-25, Safari 5.1-6 */
	background: linear-gradient(to right, #0A2A88, #59CDE9); /* W3C, IE 10+/ Edge, Firefox 16+, Chrome 26+, Opera 12+, Safari 7+ */
	border-radius: 3px;
	transition: width 0.6s ease;
}

.content-install-loading__hints {
	margin-top: 12px;
	max-width: 360px;
	text-align: center;
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 6px;
}

.content-install-loading__hint-label,
.content-install-loading__hint-text
{
	color: #FFFFFF;
	text-align: center;
	-webkit-text-stroke-width: 1px;
	-webkit-text-stroke-color: rgba(0, 0, 0, 0.60);
	font-family: "Proxima Nova", sans-serif;
	font-size: 14px;
	font-style: normal;
	font-weight: 600;
	line-height: normal;
}

.content-install-loading__hint-text {
	min-height: 42px;
	display: flex;
	align-items: center;
	animation: cil-hint-fade-in 0.3s ease;
}

@keyframes cil-hint-fade-in {
	from { opacity: 0; transform: translateY(4px); }
	to   { opacity: 1; transform: translateY(0); }
}

.content-install-loading__hint-nav {
	display: flex;
	gap: 16px;
}

.content-install-loading__hint-btn {
	background: none;
	border: none;
	padding: 4px 8px;
	margin: 0;
	cursor: pointer;
	color: #FFFFFF;
	transition: color 0.15s ease;
	font-family: "Proxima Nova", sans-serif;
	font-size: 13px;
	font-style: normal;
	font-weight: 700;
	line-height: normal;

	&:hover {
		color: rgba(255, 255, 255, 0.8);
	}
}
