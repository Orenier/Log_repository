@import url('https://fonts.googleapis.com/css2?family=Nunito&display=swap');

.pdf-search-box {
	display: flex;
	flex-direction: row;
	justify-content: center;
	align-items: center;
	padding-left: 2px;
	width: 578px;
}

.pdf-search {
	font-family: 'proxima-nova';
	font-style: normal;
	font-size: 16px;
	position: relative;
	width: 524px;
	height: 28px;
	border: 1px solid var(--grayscale-l60);
