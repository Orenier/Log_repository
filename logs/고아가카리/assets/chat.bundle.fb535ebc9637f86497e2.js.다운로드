.cil-potion {
	width: 80px;
	height: 160px;
}

.cil-potion__svg {
	width: 80px;
	height: 160px;
}

/* ---- Smoke ---- */
.cil-potion__smoke {
	opacity: 0;
	transform-origin: 40px 20px;
}

.cil-potion__smoke--1 {
	animation: cil-smoke-rise 2.5s ease-out 0.2s infinite;
}

.cil-potion__smoke--2 {
	animation: cil-smoke-rise 2.8s ease-out 0.6s infinite;
}

.cil-potion__smoke--3 {
	animation: cil-smoke-rise 3s ease-out 0s infinite;
}

.cil-potion__smoke--4 {
	animation: cil-smoke-rise 2.2s ease-out 1s infinite;
}

.cil-potion__smoke--5 {
	animation: cil-smoke-rise 3.2s ease-out 0.4s infinite;
}

@keyframes cil-smoke-rise {
	0% {
		opacity: 0;
		transform: translateY(0) scale(0.4);
	}
	10% {
		opacity: 0.5;
		transform: translateY(-5px) scale(0.7);
	}
	35% {
		opacity: 0.35;
		transform: translateY(-18px) scale(1.3);
	}
	65% {
		opacity: 0.15;
		transform: translateY(-32px) scale(1.8);
	}
	100% {
		opacity: 0;
		transform: translateY(-44px) scale(2.2);
	}
}

/* ---- Brewing state ---- */
.cil-potion__liquid {
	animation:
		cil-potion-slosh 2s ease-in-out infinite,
		cil-potion-color 8s ease-in-out infinite;
	transform-origin: center 90px;
}

@keyframes cil-potion-slosh {
	0%, 100% { transform: scaleX(1) translateY(0); }
	25%      { transform: scaleX(0.96) translateY(-1.5px); }
	50%      { transform: scaleX(1.04) translateY(1.5px); }
