.launchpad-modal__backdrop {
	position: fixed;
	inset: 0;
	background: rgba(0, 0, 0, 0.5);
	z-index: 11999;
}

.launchpad-modal.block-submenu {
	z-index: 12000 !important;
	backdrop-filter: none;
	max-height: calc(95vh) !important;

	.block-submenu-header {
		padding: 16px 24px;
	}

	.block-submenu-footer {
		border-radius: 0 0 10px 10px;
		background-color: var(--vtt-block-submenu-alt-footer-bg);
	}

	.block-submenu-footer-content {
		padding: 16px 24px;
		width: 100%;
		justify-content: flex-end;
	}
}

.launchpad-modal__body {
	padding: 24px;
	display: flex;
	flex-direction: column;
	gap: 16px;
	width: 100%;
	box-sizing: border-box;
	overflow-y: auto;
}

.launchpad-modal__header {
	display: flex;
	gap: 24px;
	align-items: center;
}

.launchpad-modal__header-text {
	flex: 1;
	display: flex;
	flex-direction: column;
	gap: 8px;
}

.launchpad-modal__title {
	margin: 0;
	font-family: 'Nunito', sans-serif;
	font-size: 28px;
	font-weight: 800;
	color: var(--vtt-submenu-header);
}

.launchpad-modal__subtitle {
	margin: 0;
	font-family: 'Proxima Nova', sans-serif;
	font-size: 14px;
	line-height: 1.5;
	max-width: 600px;
	color: var(--vtt-submenu-label-color);
}

.launchpad-modal__pick-label {
	font-family: 'Nunito', sans-serif;
	font-size: 20px;
	font-style: normal;
	font-weight: 800;
	line-height: normal;
	font-variant: small-caps;
	color: var(--vtt-submenu-header);
}

.launchpad-modal__loading,
.launchpad-modal__error {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: 12px;
	padding: 48px 32px;
	flex: 1;
}

.launchpad-modal__empty {
	display: flex;
	align-items: center;
	justify-content: center;
	padding: 48px 32px;
	color: var(--vtt-submenu-label-color);
	font-family: 'Proxima Nova', sans-serif;
	font-size: 14px;

	p {
		margin: 0;
	}
}

.launchpad-modal__featured {
	flex-shrink: 0;
	display: flex;
	flex-direction: column;
	gap: 4px;
	padding: 0;
	border: none;
	background: none;
	cursor: pointer;
	max-width: 300px;
	outline: none;

	&:focus .launchpad-modal__featured-img-wrap {
		outline: 1px solid var(--vtt-card-outline-color-selected);
	}
}

.launchpad-modal__featured--compact {
	max-width: 250px;
}

.launchpad-modal__featured-label {
	font-family: 'Proxima Nova', sans-serif;
	font-size: 16px;
	font-weight: 700;
	color: var(--vtt-submenu-header);
}

.launchpad-modal__featured-desc {
	font-family: 'Proxima Nova', sans-serif;
	font-size: 13px;
	color: var(--vtt-submenu-label-color);
}

.launchpad-modal__featured-img-wrap {
	position: relative;
	margin-top: 8px;
	border-radius: 8px;
	overflow: hidden;
	outline: 2px solid var(--vtt-card-outline-color);
	box-shadow: var(--vtt-card-box-shadow);
	transition: outline-color 0.15s ease;

	&::after {
		content: '';
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0);
		transition: background 0.15s ease;
		pointer-events: none;
	}
}

.launchpad-modal__featured:hover .launchpad-modal__featured-img-wrap {
	outline-color: var(--vtt-card-outline-color-hover);

	&::after {
		background: rgba(0, 0, 0, 0.15);
	}
}

.launchpad-modal__featured--selected .launchpad-modal__featured-img-wrap {
	outline: 3px solid var(--vtt-card-outline-color-selected);
}

.launchpad-modal__featured-img {
	width: 100%;
	object-fit: cover;
	display: block;
	transition: transform 0.2s ease;
}

.launchpad-modal__featured:hover .launchpad-modal__featured-img {
	transform: scale(1.05);
}

.launchpad-modal__featured-overlay {
	position: absolute;
	z-index: 1;
	display: flex;
	align-items: center;
	top: 50%;
	left: 50%;
	transform: translate(-50%, -50%);
	background: rgba(0, 0, 0, 0.50);
	color: #fff;
	font-family: 'Proxima Nova', sans-serif;
	font-size: 13px;
	font-weight: 600;
	padding: 6px 16px;
	border-radius: 4px;
	white-space: nowrap;
}

.launchpad-modal__featured-overlay--video {
	background: none;

	svg {
		width: 60px;
		height: 60px;
	}
}

.launchpad-modal--narrow .launchpad-modal__featured {
	width: 100%;
}

.launchpad-modal__grid {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 16px;
}

.launchpad-modal--narrow .launchpad-modal__grid {
	grid-template-columns: repeat(2, 1fr);
}

.launchpad-modal--mobile .launchpad-modal__footer,
.launchpad-modal--narrow .launchpad-modal__footer {
	width: 100%;
	flex-direction: column-reverse;
	gap: 12px;
}

.launchpad-modal--narrow .launchpad-modal__footer-btn {
	width: 100%;
	text-align: center;
}

.launchpad-modal--mobile .launchpad-modal__header {
	flex-direction: column;
	align-items: flex-start;
}

.launchpad-modal--mobile .launchpad-modal__featured {
	display: none;
}

.launchpad-modal--mobile .launchpad-modal__grid {
	grid-template-columns: 1fr;
}

.launchpad-modal--mobile .launchpad-modal__footer {
	flex-direction: column-reverse;
	gap: 12px;
}

.launchpad-modal--mobile .launchpad-modal__footer-btn {
	width: 100%;
	text-align: center;
}

.launchpad-modal--mobile .launchpad-modal__footer-btn--decline {
	border: none;
	background: transparent;
	color: var(--vtt-submenu-link-btn-color);
}

.launchpad-modal__footer {
	display: flex;
	justify-content: flex-end;
	align-items: center;
	gap: 8px;
	width: 100%;
}

.launchpad-modal__footer-btn {
	display: flex;
	height: 46px;
	padding: 12px 16px;
	justify-content: center;
	align-items: center;
	gap: 12px;
	border-radius: 8px;
	font-family: 'Proxima Nova', sans-serif;
	font-size: 14px;
	font-weight: 600;
	cursor: pointer;
	border: none;
	outline: none;
	box-sizing: border-box;
	transition: background 0.15s ease, color 0.15s ease;

	&--decline {
		background: transparent;
		color: var(--vtt-launchpad-decline-color);

		&:hover {
			color: var(--vtt-launchpad-decline-color-hover);
		}

		&:focus {
			outline: 1px solid var(--vtt-launchpad-decline-color-hover);
		}
	}

	&--close {
		@extend .launchpad-modal__footer-btn--decline;

		display: none;
		margin-right: auto;
	}

	&--confirm {
		background: var(--vtt-launchpad-confirm-bg);
		color: var(--vtt-launchpad-confirm-color);

		&:disabled {
			cursor: not-allowed;
		}

		&:not(:disabled) {
			background: var(--vtt-launchpad-confirm-active-bg);
			color: var(--vtt-launchpad-confirm-active-color);

			&:hover, &:focus {
				background: var(--vtt-launchpad-confirm-active-bg-hover);
			}
		}
	}
}

.launchpad-modal.launchpad-modal--wide .launchpad-modal__footer-btn {
	min-width: 380px;
}

.launchpad-modal.launchpad-modal--wide .launchpad-modal__footer-btn--close {
	display: flex;
	min-width: 280px;
}
