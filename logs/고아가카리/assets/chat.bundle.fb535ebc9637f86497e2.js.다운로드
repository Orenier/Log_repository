.btn-add .create-page {
	display: flex;
	align-items: center;

	.el-button {
		height: 40px;
		margin: 0;
	}

	.create-page__add {
		padding: 10px;
		border-radius: 4px 0 0 4px;
		border:0;
		width: 40px;
	}

	.create-page__caret {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 10px 14px;
		margin-left: -1px;
		border-radius: 0 4px 4px 0;
		border-left-color: rgba(255, 255, 255, 0.25);
	}

	.create-page__label {
		font-weight: 700;
		white-space: nowrap;
		color: inherit;
		padding-right: 10px;
	}

	.create-page__caret-icon {
		color: inherit;
		transition: transform 0.2s ease;
	}
}

.dark .create-background-dropdown .background-menu-item:focus {
	color: var(--primary-dark-l60);
	background-color: var(--colors-dark-f10);
	.background-menu-item__description {
		color: var(--primary-dark-l60);
	}
}

.dark .create-background-dropdown .create-background-dropdown-container {
	.background-menu-group__description {
		color: var(--color-text-placeholder, #8a8a8a);
	}
	.background-menu-item__badge {
		background: var(--color-chip-Blue-Chip-BG, #183442);
		color: var(--color-chip-One-pale-blue, #c8e8f9);
	}
	.background-menu-group__title {
		color: var(--color-feedback-info-fg, #adddf6);
	}
	.background-menu-item__icon--blank-page {
		color: var(--color-text-brand, #ba9aca);
		background-color: var(--color-surface-brand-tint, #130719);
	}
	.background-menu-item__icon--upload {
		color: var(--color-chip-Blue-Chip-FG, #adddf6);
		background: linear-gradient(0deg, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.2) 100%),
			var(--color-feedback-info-chip, #183442);
	}
	.background-menu-item__description {
		color: var(--color-text-subtle, #C2C2C2);

	}
}

.create-background-dropdown {
	z-index: 10701 !important;
	border: 0 !important;
	.el-dropdown__list {
		margin: 5px;
		.el-dropdown-menu__item {
			padding: 5px;
		}
	}

	.create-background-dropdown-container {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		align-items: start;

		@media (max-width: 600px) {
			grid-template-columns: 1fr;
		}

		.background-menu-group {
			padding: 0 4px;

			&:not(:last-child) {
				border-right: 1px solid var(--grayscale-d30);
			}

			@media (max-width: 600px) {
				&:not(:last-child) {
					border-right: 0;
					border-bottom: 1px solid var(--grayscale-d30);
					padding-bottom: 4px;
					margin-bottom: 4px;
				}
			}

			&__header {
				padding: 5px;
			}

			&__title {
				color: var(--color-feedback-info-fg, #085984);
				font-weight: 700;
				font-size: 16px;
			}

			&__description {
				color: var(--color-text-placeholder, #595959);
				font-size: var(--el-font-size-small);
				line-height: 14px;
			}
		}
	}

	.background-menu-item__name {
		font-size: var(--size-md-1, 14px);
		font-weight: 600;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
	}
	.background-menu-item__body {
		flex: 1;
	}
	.background-menu-item__badge {
		background: var(--color-chip-Blue-Chip-BG, #cce3f0);
		color: var(--color-chip-One-deep-green, #004d23);
		border-radius: 4px;
		padding: 2px 6px;
		font-size: var(--el-font-size-small);
		font-weight: 600;
	}

	.dark .create-background-dropdown-container .background-menu-group__title {
		color: var(--color-feedback-info-fg, #adddf6);
	}

	.background-menu-item__description {
		color: var(--color-text-subtle, #262626);
		line-height: 14px;
		font-size: var(--el-font-size-small);
	}

	.background-menu-item {
		margin: 0;
		&__container {
			display: flex;
			align-items: center;
			gap: 10px;
			width: 100%;
		}

		&__title {
			width: 36px;
			height: 36px;
			background-color: white;
			border-radius: 4px;
			overflow: hidden;
			display: flex;
			align-items: center;
			justify-content: center;
			color: var(--grayscale-light-text);
			border: 0;
		}

		&__title-image {
			height: 100%;
		}

		&__icon--blank-page {
			color: #87004f; // var(--color-text-brand)
			background-color: var(--color-surface-brand-tint, #f8e8f2);
		}

		&__icon--upload {
			color: var(--color-chip-Blue-Chip-FG, #085984);
			background: var(--color-feedback-info-chip, #e9f3f9);
		}
	}
	.background-menu-item:focus {
		.background-menu-item__description {
			color: var(--primary-light-l40);
		}
	}
	.el-popper__arrow {
		display: none;
	}
}

.btn-add {
	.el-button--primary {
		background: var(--color-action-primary, #B4006A);
		border-top-width: 0;
		border-bottom-width: 0;
		border-right-width: 0;
	}
	.el-button--primary:hover {
		background: var(--primary-light-base);
	}
}

.dark .btn-add {
	.folder__add {
		border-color: #9867b0;
		color: var(--color-action-on-secondary, #FFF);
	}
	.el-button--secondary {
		color: white;
	}
	.el-button--primary {
		background: #702C91;
	}
	.el-button:hover {
		background-color: var(--dark-primary-highlight);
	}
}
