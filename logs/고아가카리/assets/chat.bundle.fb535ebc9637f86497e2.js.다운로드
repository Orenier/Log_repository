.grid-align-full-grid {
	position: fixed;
	top: 0;
	left: 0;
	width: 100vw;
	height: 100vh;
	pointer-events: none;
	z-index: 99;

	&__canvas {
		position: absolute;
		top: 0;
		left: 0;
	}

	&__handle {
		position: absolute;
		width: 20px;
		height: 20px;
		transform: translate(-50%, -50%);
		// Purely a visual marker \u2014 the resize drag is started from a document-level pointerdown so
		// middle/right-button presses fall through to the engine canvas for panning.
		pointer-events: none;

		&::before,
		&::after {
			content: '';
			position: absolute;
			background: v-bind(gridColorCss);
			border-radius: 2px;
		}

		// Horizontal bar of the plus sign
		&::before {
			top: 50%;
			left: 0;
			width: 100%;
			height: 4px;
			transform: translateY(-50%);
		}

		// Vertical bar of the plus sign
		&::after {
			left: 50%;
			top: 0;
			width: 4px;
			height: 100%;
