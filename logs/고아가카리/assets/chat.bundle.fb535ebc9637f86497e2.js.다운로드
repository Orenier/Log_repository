.grid-align-magnifier {
	position: fixed;
	transform: translate(-50%, -50%);
	width: 316px;
	height: 316px;
	pointer-events: none;
	z-index: 99;
}

.grid-align-magnifier__canvas {
	display: block;
	width: 316px;
	height: 316px;
	border-radius: 50%;
	border: 2px solid rgba(255, 255, 255, 0.25);
	box-shadow: 0 2px 16px rgba(0, 0, 0, 0.5);
	box-sizing: border-box;
	// Non-interactive so every pointer event except a left-drag (caught at the document level in
	// the capture phase) falls through to the engine canvas for pan / context menu / zoom.
	pointer-events: none;
}

.grid-align-magnifier__center {
	position: absolute;
	top: 50%;
	left: 50%;
	width: 52px;
	height: 52px;
	transform: translate(-50%, -50%);
	border-radius: 50%;
	background: v-bind(gridColorCss);
	opacity: 0.15;
	pointer-events: none;
}

.grid-align-magnifier__btn {
	position: absolute;
	width: 28px;
	height: 28px;
	padding: 0;
	border: 1px solid #545454;
	border-radius: 50%;
	background: rgba(0, 0, 0, 0.7);
	color: #fff;
	font-size: 7px;
	line-height: 1;
	display: flex;
	align-items: center;
	justify-content: center;
	cursor: pointer;
	pointer-events: all;
