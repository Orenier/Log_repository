.grid-align-tool__skew-controls {
	// The main tool sits at bottom: 16px with height 76px (top edge at 92px); place these
	// 8px above it.
	position: fixed;
	bottom: 100px;
	left: 50%;
	height: 40px;
	width: 196px;
	padding: 6px;
	box-sizing: border-box;
	border-radius: 8px;
	background: var(--align-to-grid-skew-background);
	border: 1px solid var(--color-overlay-grayscale-sm, rgba(255, 255, 255, 0.20));
	font-weight: 600;

	transform: translateX(-50%);
	display: flex;
	justify-content: center;
	align-items: center;
	gap: 6px;
	z-index: 2200;
}

.grid-align-tool__color-picker {
	// Sits 16px above the main tool's top edge (bottom: 16px + height: 76px = 92px), left-aligned
	// with the main tool's left edge (which sits at calc(50% - 325px) since the tool is centered
	// via left: 50% / translateX(-50%) at width 650px).
	position: fixed;
	bottom: 108px;
	left: calc(50% - 325px);
	height: 40px;
	padding: 6px 10px;
	box-sizing: border-box;
	border-radius: 8px;
	background: var(--align-to-grid-skew-background);
	border: 1px solid var(--color-overlay-grayscale-sm, rgba(255, 255, 255, 0.20));
	font-weight: 600;
	display: flex;
	align-items: center;
	gap: 8px;
	z-index: 2200;

	// Open the color popup upward instead of its default downward placement, so it doesn't
	// overlap the main tool sitting just below this panel.
	:deep(.color-picker-popup) {
		top: auto;
		bottom: calc(100% + 8px);
		left: -4px;
	}
}

.grid-align-tool__skew-btn {
	// Matches the magnifier nudge buttons' look (GridAlignMagnifier.vue): dark translucent fill,
	// grey border, and the #0C0C0C box-shadow outline. Dimensions and font are kept larger than
	// the magnifier's icon-only buttons since these carry text labels.
	position: relative;
	display: flex;
	width: 28px;
	height: 28px;
	padding: 0;
	justify-content: center;
	align-items: center;
	border-radius: 50%;
	border: 1px solid #545454;
	outline: none;
	box-sizing: border-box;
	cursor: pointer;
	font-family: 'Proxima Nova', sans-serif;
	font-size: 13px;
	font-weight: 600;
	line-height: 1;
	background: var(--align-to-grid-circle-button);
	box-shadow: 0.8px 0.8px 0 0 var(--fun-pin-surface), 0.8px -0.8px 0 0 var(--fun-pin-surface), -0.8px 0.8px 0 0 var(--fun-pin-surface), -0.8px -0.8px 0 0 var(--fun-pin-surface), -0.8px 0 0 0 var(--fun-pin-surface), 0.8px 0 0 0 var(--fun-pin-surface), 0 -0.8px 0 0 var(--fun-pin-surface), 0 0.8px 0 0 var(--fun-pin-surface);
	transition: background 0.15s ease, color 0.15s ease;

	&::before {
		content: '';
		position: absolute;
		top: 50%;
		left: 50%;
		width: 38px;
		height: 40px;
		transform: translate(-50%, -50%);
	}

	&:hover {
		background: var(--color-overlay-grayscale-xs);
