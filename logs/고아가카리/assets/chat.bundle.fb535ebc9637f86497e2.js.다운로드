.upload-details {
	display: flex;
	flex-flow: row nowrap;
	align-items: center;
	justify-content: space-between;
	width: 100%;
	height: 30px;

	&-info {
		display: flex;
		align-items: center;

		&__preview {
			display: flex;
			justify-content: center;
			align-items: center;
			margin-right: 10px;
			width: 40px;
			height: 40px;

			img {
				max-width: 100%;
				max-height: 100%;
			}
		}

		&__name {
			font-family: 'Proxima Nova', sans-serif;
			font-size: 15px;
			font-weight: 600;
			color: var(--vtt-submenu-label-color);
			margin-right: 10px;
		}

		&__chip {
			font-family: 'Proxima Nova', sans-serif;
			font-size: 11px;
			font-weight: 600;
			padding: 2px 6px;
			border-radius: 4px;
			background-color: var(--vtt-chip-toggle-background);
			border: var(--vtt-chip-toggle-border);
			color: var(--vtt-submenu-label-color);
			margin-right: 10px;
			cursor: pointer;

			&--warning {
				background-color: var(--vtt-danger-notification-bg);
				border-color: var(--vtt-danger-notification-color);
				color: var(--vtt-danger-notification-color);
			}
		}

		&__status {
			display: flex;
			align-items: center;

			&-icon {
				margin-right: 5px;

				&--success {
					color: var(--vtt-multi-dropzone-success-color);
				}

				&--error {
					color: var(--vtt-multi-dropzone-warning-color);
				}

			}

			&-message {
				font-family: 'Proxima Nova', sans-serif;
				font-size: 13px;
				font-weight: 600;
				color: var(--vtt-multi-dropzone-warning-color);
			}
		}
	}

	&-actions {
		display: flex;
		flex-flow: row nowrap;

		button {
			display: flex;
			align-items: center;
			padding: 4px;
		}

		&__retry {
			margin-right: 10px;

			.grimoire__roll20-icon {
				display: block;
				transform: scaleX(-1);
				color: var(--vtt-multi-dropzone-control-button-bg);
			}

			&:hover .grimoire__roll20-icon {
				color: var(--vtt-multi-dropzone-control-button-bg-hover);
			}
		}

		&__cancel {
			.grimoire__roll20-icon {
				color: var(--vtt-multi-dropzone-cancel-color);
				transition: color 0.2s;
			}

			&:hover .grimoire__roll20-icon {
				color: var(--vtt-multi-dropzone-cancel-hover-color);
			}
		}

		&__delete {
			.grimoire__roll20-icon {
				transition: color 0.2s;
				color: var(--vtt-multi-dropzone-control-button-bg);
			}

			&:hover .grimoire__roll20-icon {
				color: var(--vtt-multi-dropzone-control-button-bg-hover);
			}
		}
	}
}
