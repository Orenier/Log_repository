.header {
	height: 45px;
	padding-left: 8px;
	padding-right: 8px;

	& {
		font-family: var(--font-family-proxima-nova);
	}

	.rollModifierBtnContainer {
		display: flex;
		justify-content: flex-end;
	}

	.baseButton {
		color: var(--vtt-submenu-label-color);
		border: 1px solid transparent;
	}

	:deep(.baseButton span) {
		pointer-events: none;
	}

	.baseButton:focus,
	.baseButton:active {
		background: var(--vtt-submenu-btn-bg);
		border: 1px solid var(--vtt-submenu-header-btn-color);
	}

	.baseButton:focus {
		border: 1px solid var(--vtt-submenu-header-btn-color);
	}

	.baseButton.isActive {
		background: var(--vtt-submenu-highlight-color);
	}

	.baseButton:hover {
		border: 1px solid var(--vtt-submenu-btn-border-color);
		background: var(--vtt-submenu-btn-bg);
	}

	.baseButton.isActive:hover {
		background: var(--vtt-submenu-highlight-color);
	}

	.brackets {
		border-right: 1px solid var(--vtt-submenu-highlight-color);
	}

	div div {
		font-size: 16px;
	}
}

.targetNumberContainer {
	display: flex;
	flex-direction: column;
}

.targetNumberInputs {
	display: flex;
	gap: 8px;
	padding-bottom: 8px;
	width: 150px;
}

.subtitle {
	margin-left: 10px;
	margin-bottom: 10px;
	font-family: var(--font-family-proxima-nova);
	font-style: normal;
	font-weight: 600;
	font-size: 14px;
	color: var(--vtt-grayscale-base);
}

.footerToggle {
	margin-bottom: 10px;
	color: var(--vtt-footer-link-color);
}

.multi {
	place-self: center;
	margin-top: 20px;
}

.plus {
	margin-top: 20px;
}

.dark {
	.multi,
	.plus {
		img {
			filter: invert(100%) sepia(2%) saturate(192%) hue-rotate(319deg) brightness(116%) contrast(78%);
		}
	}

}
:deep(.el-checkbox__input) {
	.el-checkbox__inner {
		background-color: var(--vtt-checkbox-secondary-unchecked-background);
		border-color: var(--vtt-checkbox-secondary-unchecked-border);
	}
	+ .el-checkbox__label {
		color: var(--vtt-mini-menu-text);
		font-weight: 400;
	}

	&.is-checked {
		.el-checkbox__inner {
			background-color: var(--vtt-checkbox-secondary-checked-background);
			border-color: var(--vtt-checkbox-secondary-checked-border);
		}
		+ .el-checkbox__label {
			color: var(--vtt-mini-menu-text);
		}
		// ::after {
		// 	border-color: var(--vtt-component-large-title-color);
		// }
	}
}

:deep(.tertiary .el-checkbox__input) {
	+ .el-checkbox__label {
		color: var(--vtt-map-pin-edit-notes-tag-color);
	}
	&.is-checked + .el-checkbox__label {
		color: var(--vtt-map-pin-edit-notes-tag-color);
	}
}

:deep(.el-select__selection) {
	.is-transparent {
		color: var(--vtt-map-pin-edit-tertiary) !important;
	}
}

:deep(button.el-button.is-text.firstColBtn),
:deep(button.el-button.is-text.gridBtn) {
	&:hover {
		background: var(--vtt-submenu-btn-bg);
		border: 1px solid var(--vtt-submenu-btn-border-color);
		border-radius: 4px;
	}

	&:focus {
		background: var(--vtt-submenu-btn-bg);
		border: 1px solid var(--vtt-submenu-btn-border-color);
		border-radius: 4px;
	}
}

button.el-button.is-link {
	--el-button-hover-link-text-color: var(--vtt-submenu-link-btn-hover-color);
}

:deep(.el-divider.el-divider--horizontal) {
	border-color: var(--vtt-submenu-highlight-color);
	margin: 0;
}

.el-input-number {
	width: 76px;
	min-width: 76px;
}

.el-select.el-select {
	width: 100%;
}

:deep(main.el-main) {
	padding-left: 0;
	padding-right: 0;
	padding-top: 0;
}

.button {
	border-radius: 4px;
	font-family: var(--font-family-proxima-nova);
	font-size: 13px;
	font-style: normal;
	font-weight: 600;
