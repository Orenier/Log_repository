.file-uploader {
	width: 100%;

	&__avatar-preview {
		display: flex;
		justify-content: flex-start;
		align-items: center;
		margin-bottom: 12px;
		gap: 12px;
	}

	&__avatar-image {
		display: flex;
		justify-content: center;
		align-items: center;
		width: 120px;
		height: 120px;
		border-radius: 4px;
		background-color: var(--vtt-single-dropzone-avatar-background-color);
		border: 1px solid var(--vtt-single-dropzone-avatar-border-color);

		img, video {
			max-width: 120px;
			max-height: 120px;
			border-radius: 2px;
			object-fit: cover;
		}
	}

	&__avatar-buttons {
		display: flex;
		flex-flow: column wrap;
		align-self: flex-start;
		gap: 12px;

		button {
			font-family: 'Proxima Nova', sans-serif;
			width: 17px;
			height: 17px;
			border-radius: 4px;
			padding: 8px;
			cursor: pointer;
			transition:
				background-color 0.2s ease-in-out,
				color 0.2s ease-in-out,
				border-color 0.2s ease-in-out;
		}

		.file-uploader__avatar-buttons-replace {
			background-color: var(--vtt-single-dropzone-replace-button-bg);
			color: var(--vtt-single-dropzone-replace-button-color);

			&:hover {
				background-color: var(--vtt-single-dropzone-replace-button-bg-hover);
			}
		}

		.file-uploader__avatar-buttons-remove {
			background-color: var(--vtt-single-dropzone-remove-button-bg);
			color: var(--vtt-single-dropzone-remove-button-color);

			&:hover {
				background-color: var(--vtt-single-dropzone-remove-button-bg-hover);
			}
		}
	}

	&__dropzone-wrapper {
		position: relative;
	}

	&__dropzone {
		display: flex;
		flex-flow: row nowrap;
		align-items: center;
		justify-content: center;
		border: 2px dashed var(--vtt-single-dropzone-border);
		background: var(--vtt-single-dropzone-background);
		border-radius: 8px;
		height: 80px;
		min-height: 80px;
		gap: 12px;
		cursor: pointer;
		transition:
			background-color 0.2s ease-in-out;

		&:hover {
			background: var(--vtt-single-dropzone-background-hover);

			.file-uploader__dropzone-message, .grimoire__roll20-icon {
				color: var(--vtt-single-dropzone-message-color-hover);
			}
		}

		.grimoire__roll20-icon {
			display: flex;
			align-items: center;
			color: var(--vtt-single-dropzone-icon-color);
			margin: 0 !important;
			pointer-events: none;
			line-height: 0;
			height: 18px;
			width: auto;
		}

		&--success {
			border: 2px dashed var(--vtt-single-dropzone-border-success);
			background: var(--vtt-single-dropzone-background-success);
			justify-content: center;

			.file-uploader__dropzone-message,
			.grimoire__roll20-icon {
				color: var(--vtt-single-dropzone-message-color-success);
			}
		}

		&--error {
			border: 2px dashed var(--vtt-single-dropzone-border-error);
			background: var(--vtt-single-dropzone-background-error);
			justify-content: center;

			.file-uploader__dropzone-message,
			.file-uploader__dropzone-sub-message,
			.grimoire__roll20-icon {
				color: var(--vtt-single-dropzone-message-color-error);
			}
		}
	}

	&__dropzone--hidden {
		display: none;
	}

	&__overlay {
		position: absolute;
		inset: 0;
		border: 2px dashed var(--vtt-single-dropzone-border);
		background: var(--vtt-single-dropzone-background);
		border-radius: 8px;
		max-height: 80px;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 12px;
		pointer-events: auto;
	}

	&__dropzone-message {
		font-family: 'Proxima Nova', sans-serif;
		font-size: 12px;
		font-weight: 600;
		color: var(--vtt-single-dropzone-message-color);
		pointer-events: none;
		text-align: center;
		opacity: 1 !important;
	}

	:deep(.upload-details-info__name) {
      font-size: 12px;
    }

    :deep(.upload-details-info__chip),
    :deep(.upload-details-info__status-message) {
      font-size: 11px;
    }

	:deep(.upload-details .upload-details-info__preview) {
		width: 20px;
		height: 20px;
	}
}
