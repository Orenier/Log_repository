		}

		&.hover-effect:hover {
           background: #2B2B2B;
        }

		.help-card-title .subheader {
			color: var(--dark-primarytext);
		}

		.help-card-icon {
			&.green {
				color: #48BD7D;
				background: #0C2918;
			}

			&.blue {
				color: #98D4F4;
				background: #021D2C;
			}

			&.pink {
				color: #E481BB;
				background: #27071A;
			}

			&.purple {
				color: #C68DE2;
				background: #1F092A;
			}
		}

		.help-card-footer .time-to-read {
			color: var(--grayscale-dark-base);
		}

		.help-card-body-copy {

			&,
			&:deep(p) {
				color: var(--grayscale-dark-base);
			}
		}

		&:deep(.el-scrollbar__thumb) {
			background-color: var(--grayscale-l30);
		}
	}
}

