.file-uploader {
  width: 100%;

  &__dropzone {
    display: flex;
    flex-flow: column nowrap;
    align-items: center;
    justify-content: center;
    border: 2px dashed var(--vtt-multi-dropzone-border);
    background: var(--vtt-multi-dropzone-background);
    border-radius: 8px;
    height: 200px;

    .grimoire__roll20-icon {
      display: flex;
      align-items: center;
      color: var(--vtt-multi-dropzone-icon-color);
      margin: 0 !important;
      pointer-events: none;
      line-height: 0;
      height: 40px;
    }

    &--success {
      border: 2px dashed var(--vtt-multi-dropzone-border-success);
      background: var(--vtt-multi-dropzone-background-success);
      justify-content: center;

      .file-uploader__dropzone-message {
        margin-top: 10px;
      }

      .file-uploader__dropzone-message,
      .grimoire__roll20-icon {
        color: var(--vtt-multi-dropzone-message-color-success);
      }
    }

    &--error {
      border: 2px dashed var(--vtt-multi-dropzone-border-error);
      background: var(--vtt-multi-dropzone-background-error);
      justify-content: center;

      .file-uploader__dropzone-message {
        margin-bottom: 10px;
      }

      .file-uploader__dropzone-message,
      .file-uploader__dropzone-sub-message,
      .grimoire__roll20-icon {
        color: var(--vtt-multi-dropzone-message-color-error);
      }
    }
  }

  &__dropzone-message {
    font-family: 'Proxima Nova', sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: var(--vtt-multi-dropzone-message-color);
    pointer-events: none;
    text-align: center;
    opacity: 1 !important;
    margin: 16px 0;
  }

  &__dropzone-sub-message {
    font-family: 'Proxima Nova', sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: var(--vtt-multi-dropzone-message-color);
    pointer-events: none;
    text-align: center;
  }

  &__dropzone-button {
    padding: 10px 20px;
    background-color: var(--vtt-multi-dropzone-button-bg);
    font-family: 'Proxima Nova', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: var(--vtt-multi-dropzone-button-color);
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background-color 0.2s;

    &:hover {
      background-color: var(--vtt-multi-dropzone-button-bg-hover);
    }
  }

  &__supported-files {
    margin-top: 10px;
    font-family: 'Proxima Nova', sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: var(--vtt-submenu-label-color);
  }

  &__latest-uploads {
    margin-top: 20px;
    width: 100%;

    &-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;

      h4 {
        font-family: 'Proxima Nova', sans-serif;
        font-size: 16px;
        font-weight: 600;
        color: var(--vtt-submenu-header);
      }

      span {
        font-family: 'Proxima Nova', sans-serif;
        font-size: 13px;
      }

      &-storage {
        color: var(--vtt-submenu-label-color);
        font-weight: 100;

        &-tier {
          margin-left: 5px;
          font-weight: 900;
        }
      }
    }

    &-list {
      padding-right: 12px;
    }
  }

  &__link {
    color: var(--vtt-submenu-link-btn-color);
    cursor: pointer;

    &:hover {
      text-decoration: underline;
    }
  }
}
