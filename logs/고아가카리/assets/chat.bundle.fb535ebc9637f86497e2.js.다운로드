.bar-background {
	display: flex;
	height: 1em;
	background: rgba(0, 0, 0, 0.15);
	border-radius: 6px;
	box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.25), 0 1px rgba(255, 255, 255, 0.08);
	margin: auto;
	overflow: clip;
	position: relative;
	text-align: center;
	opacity: v-bind("opacity ?? 1");
}

.bar-background::before {
	content: attr(data-text);
	font-size: 0.75em;
	position: absolute;
	text-align: center;
	left: 0;
	right: 0;
	color: var(--background-light);
	font-weight: bold;
	text-shadow: -1px -1px 2px black, 1px -1px 2px black, -1px 1px 2px black, 1px 1px 2px black;
	font-family: Arial, sans-serif;
	line-height: 1.4em;
}

.bar-background-compact {
	height: 0.5em;
	margin: auto;
	overflow: clip;
	position: relative;
	opacity: v-bind("opacity ?? 1");
}

.bar-background-compact .bar-overflow {
	font-size: 8px;
	top: -5px;
	line-height: unset;
}

.token-bar {
	height: 100%;
	border-radius: 4px;
	box-shadow: 0 0 1px 1px rgba(0, 0, 0, 0.25), inset 0 1px rgba(255, 255, 255, 0.1);
	background-color: v-bind("color ?? 1");
	width: v-bind("\`\${Math.max(0, Math.min(100, barPercent))}%\`");
}

.token-bar-compact {
	box-shadow: initial;
}

.bar-overflow {
	font-size: 14px;
	color: var(--background-light);
	font-weight: bold;
	position: absolute;
	top: 0px;
	text-shadow: -1px -1px 2px black, 1px -1px 2px black, -1px 1px 2px black, 1px 1px 2px black;
	line-height: 1em;
	font-family: Arial, sans-serif;
}

.compact {
	font-size: 12px;
	top: -6px;
}

.bar-minus {
	left: 4px;
}

.bar-plus {
	right: 4px;
}
