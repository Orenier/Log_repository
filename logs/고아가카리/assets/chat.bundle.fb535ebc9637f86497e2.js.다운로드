	justify-content: left;
	flex-grow: 3;
}

.fx-submenu-body {
	width: 100%;
	padding: 0px 8px;
	margin: 0px;
}

.fx-tool-panel {
	display: flex;
	gap: 8px;
	flex-direction: column;
	padding-bottom: 4px;
	width: 100%;
}

.fx-tool-panel > * {
	padding: 0px 8px;
	margin: 0px;
}

p {
	margin: 0px;
}

.fx-tool-footer {
	display: flex;
	flex-direction: row;
	gap: 8px;
	font-family: var(--font-family-proxima-nova);
	align-items: center;
    font-style: normal;
    font-weight: 600;
	color: var(--vtt-footer-text-color);
	padding-top: 4px;
	margin-bottom: 4px;
}

.fx-footer-premium {
	color: var(--vtt-premium-gold);
}

.fx-tool-section-header {
	font-family: var(--font-family-proxima-nova);
	font-size: 13px;
	font-style: normal;
	font-weight: 600;
	line-height: 18px;
}

.effect-dropdown-section {
	display: flex;
	flex-direction: column;
	gap: 4px;
}

.effect-dropdown-section :deep(.dropdown-submenu-header) {
	margin-bottom: 0px;
}

.custom-effect-button {
	height: 36px;
	width: 126px;
	padding: 0px;
	gap: 4px;
	font-family: var(--font-family-proxima-nova);
	font-size: 13px;
	font-style: normal;
	font-weight: 600;
	line-height: normal;
}

.custom-effect-settings-button {
	display: flex;
	flex-direction: row;
	align-items: center;
}

.fx-tool-sub-header {
	font-family: var(--font-family-proxima-nova);
	font-size: 13px;
	font-style: normal;
	font-weight: 600;
	line-height: 18px;
}

:deep(.grimoire__button.medium) {
	padding: 8px;
}

.accordion {
	width: 100%;
	display: flex;
	flex-direction: column;
	gap: 2px;
	padding: 4px;
}

:deep(.grimoire__button.medium):disabled {
	background-color: transparent;
	border-color: transparent;
}

:deep(.grimoire__button.grimoire__button--tertiary) {
