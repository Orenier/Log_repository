  margin-right: 30px;
  height: getCssVarWithDefault(
    'checkbox-height',
    map.get($checkbox-height, 'default')
  );

  @include when(disabled) {
    cursor: not-allowed;
  }

  @include when(bordered) {
    padding: 0 map.get($checkbox-bordered-padding-right, 'default')-$border-width
