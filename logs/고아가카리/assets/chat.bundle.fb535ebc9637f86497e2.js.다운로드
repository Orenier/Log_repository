	border-radius: 8px;
	width: 190px;
	padding-left: 8px;
	padding-top: 8px;
	padding-bottom: 8px;
}

.portal-type-col {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding-right: 8px;
}

$portal-font: "Proxima Nova", "ProximaNova-Regular",
	-apple-system, BlinkMacSystemFont, sans-serif;

.portal-type-select {
	width: 120px;

	:deep(.el-select__wrapper) {
		background: transparent;
		border: none;
		box-shadow: none !important;
		border-radius: 6px;
		padding: 4px 8px;
		min-height: unset;

		&:hover {
			background: var(--vtt-submenu-input-hover-color);
		}
	}

	:deep(.el-select__selected-item),
	:deep(.el-select__placeholder) {
		color: var(--vtt-submenu-item-color);
		font-family: $portal-font;
		font-size: 15px;
		font-weight: 600;
	}

	:deep(.el-select__prefix),
	:deep(.el-select__caret) {
		color: var(--vtt-submenu-item-color);
	}
}

:deep(.portal-type-dropdown) {
	background: var(--vtt-dropdown-body-bg);
	border: none;
	border-radius: 8px;
	box-shadow: var(--vtt-dropdown-body-box-shadow);
	padding: 4px;

	.el-select-dropdown__item {
		color: var(--vtt-submenu-item-color);
		border-radius: 6px;
		height: auto;
		padding: 6px 8px;
		font-family: $portal-font;
		font-size: 15px;
		font-weight: 600;

		&::after {
			display: none;
		}

		&.hover,
		&:hover {
			background: var(--vtt-submenu-input-hover-color);
			color: var(--vtt-submenu-item-color);
		}

		&.selected {
			background: transparent;
			color: var(--vtt-submenu-item-color);
			font-weight: 600;
		}

		&.selected.hover,
		&.selected:hover {
			background: var(--vtt-submenu-input-hover-color);
		}
	}
}

.portal-type-option {
	display: flex;
	align-items: center;
	gap: 8px;
	width: 100%;
}

.portal-type-option__label {
	flex: 1;
}

.portal-type-option__check {
	margin-left: auto;
	color: var(--vtt-submenu-item-color);
}

.win-span {
	line-height: 22px;
	font-size: 16px;
	display: inline-block;
	padding-left: 14px;
	font-family: "Proxima Nova", "ProximaNova-Regular",
		-apple-system, BlinkMacSystemFont, sans-serif;
}
